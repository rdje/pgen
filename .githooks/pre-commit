#!/usr/bin/env bash
# .githooks/pre-commit — repo-hygiene gates; block the commit on any breach.
#   - MEMORY-ARCH E3 (PGEN-MEMORY-ARCH-0005): durable-memory-architecture invariants.
#   - DIAG-SEVERITY.4 + DOCPATH (PGEN-DIAG-SEVERITY-0005): severity-never-masked +
#     live-docs repo-root-relative paths.
#   - EBNF-SOURCE-OF-TRUTH.5 (PGEN-EBNF-SOT-0004): the EBNF is the single source of truth for the
#     accepted language — flag any NEW out-of-band acceptance validator wired into the parse registry.
#   - KNOWLEDGE-MAP (PGEN-KNOWLEDGE-MAP-0001): regen+stage the derived Knowledge Map, then
#     validate facts + sync (regenerate-and-stage makes map drift structurally impossible).
#   - DIAG-TOOLBOX-ENFORCE (PGEN-DIAG-TOOLBOX-0002): the GENERAL DOCTRINE ENFORCER —
#     scripts/check_doctrines.sh runs every mechanizable doctrine check as one registry, incl.
#     the diagnosis-evidence gate that blocks a code change whose task leaf lacks tool-backed
#     WHY+WHERE diagnosis + measured verification. See docs/decisions/DOCTRINE_ENFORCEMENT.md.
set -e
ROOT="$(git rev-parse --show-toplevel)"
# KNOWLEDGE-MAP is DERIVED — regenerate + stage so map drift is structurally impossible, BEFORE
# the driver's check_knowledge_map verifies it.
"$ROOT/knowledge-map/scripts/gen_knowledge_map.sh" >/dev/null
git add "$("$ROOT/knowledge-map/scripts/gen_knowledge_map.sh" --print-map-path)" 2>/dev/null || true
# The single general doctrine enforcer (registry + driver) — runs ALL check_*.sh and reports.
"$ROOT/scripts/check_doctrines.sh"
