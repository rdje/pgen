# JSON grammar (RFC 8259 / ECMA-404 aligned).
#
# EXTERNAL-CORPUS.2a (PGEN-EXTERNAL-CORPUS-0003): upgraded from the original
# simplified subset to track the JSON standard, using the JSONTestSuite corpus
# (json_corpus_bundle/) as the acceptance metric. Lexical terminals are exact:
#   - number  carries the optional exponent and forbids leading zeros (0|[1-9][0-9]*)
#   - string  models the JSON escape set (\" \\ \/ \b \f \n \r \t \uXXXX) and
#             forbids raw control characters (\x00-\x1f) and lone backslashes
#   - whitespace is the exact JSON set [ \t\n\r] (no form-feed / vertical-tab)
# Return-annotation shapes are unchanged from the simplified grammar (string and
# number still return their matched text via -> $1).

json := value
-> {type: "json", value: $1}

value := object
-> $1
value := array
-> $1
value := string
-> {type: "string", value: $1}
value := number
-> {type: "number", value: $1}
value := /[ \t\n\r]*true[ \t\n\r]*/
-> {type: "boolean", value: true}
value := /[ \t\n\r]*false[ \t\n\r]*/
-> {type: "boolean", value: false}
value := /[ \t\n\r]*null[ \t\n\r]*/
-> {type: "null"}

object := /[ \t\n\r]*\{[ \t\n\r]*\}[ \t\n\r]*/
-> {type: "object", members: []}
object := /[ \t\n\r]*\{[ \t\n\r]*/ members /[ \t\n\r]*\}[ \t\n\r]*/
-> {type: "object", members: $2}

members := pair /[ \t\n\r]*,[ \t\n\r]*/ members
-> [$1, $3*]
members := pair
-> [$1]

pair := string /[ \t\n\r]*:[ \t\n\r]*/ value
-> {type: "pair", key: $1, value: $3}

array := /[ \t\n\r]*\[[ \t\n\r]*\][ \t\n\r]*/
-> {type: "array", elements: []}
array := /[ \t\n\r]*\[[ \t\n\r]*/ elements /[ \t\n\r]*\][ \t\n\r]*/
-> {type: "array", elements: $2}

elements := value /[ \t\n\r]*,[ \t\n\r]*/ elements
-> [$1, $3*]
elements := value
-> [$1]

string := /[ \t\n\r]*"(\\(["\\\/bfnrt]|u[0-9a-fA-F]{4})|[^"\\\x00-\x1f])*"[ \t\n\r]*/
-> $1
number := /[ \t\n\r]*-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?[ \t\n\r]*/
-> $1
