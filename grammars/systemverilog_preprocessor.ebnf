# systemverilog_preprocessor.ebnf
#
# Initial SystemVerilog preprocessor grammar seed.
# Scope for this first increment:
# - Core directive parsing (`define`, `undef`, `include`, `ifdef` family)
# - Timescale/default-nettype/celldefine directives
# - Nested conditional-compilation blocks
# - Macro formal/default argument syntax
# - Macro body primitives for token-paste and stringize
#
# Notes:
# - This grammar is intentionally line-oriented and deterministic.
# - Non-directive source lines are captured as passthrough text.

systemverilog_preprocessor_file := pp_item*
-> {type: "systemverilog_preprocessor_file", items: $1}

pp_item := pp_define              -> {kind: "define",              body: $1}
         | pp_undef               -> {kind: "undef",               body: $1}
         | pp_include             -> {kind: "include",             body: $1}
         | pp_timescale           -> {kind: "timescale",           body: $1}
         | pp_default_nettype     -> {kind: "default_nettype",     body: $1}
         | pp_celldefine          -> {kind: "celldefine"}
         | pp_endcelldefine       -> {kind: "endcelldefine"}
         | pp_conditional         -> {kind: "conditional",         body: $1}
         | pp_non_directive_line  -> {kind: "non_directive_line",  body: $1}
         | pp_blank_line          -> {kind: "blank_line"}

# ---------------------------------------------------------------------------
# Core directives
# ---------------------------------------------------------------------------

pp_define := kw_define macro_name macro_formals? macro_body? newline?
          -> {name: $2, formals: $3, body: $4}
pp_undef := kw_undef macro_name directive_comment_tail newline?
         -> {name: $2, comment: $3}
pp_include := kw_include include_path directive_comment_tail newline?
           -> {path: $2, comment: $3}
pp_timescale := kw_timescale time_literal slash time_literal directive_comment_tail newline?
             -> {unit: $2, precision: $4, comment: $5}
pp_default_nettype := kw_default_nettype nettype_value directive_comment_tail newline?
                   -> {nettype: $2, comment: $3}
pp_celldefine := kw_celldefine directive_comment_tail newline?
              -> {comment: $2}
pp_endcelldefine := kw_endcelldefine directive_comment_tail newline?
                 -> {comment: $2}

include_path := quoted_string -> {kind: "quoted", text: $1}
              | angle_path    -> {kind: "angle",  text: $1}

nettype_value := identifier -> {kind: "identifier", body: $1}
               | kw_none    -> {kind: "none"}

time_literal := unsigned_number time_unit
             -> {value: $1, unit: $2}

# ---------------------------------------------------------------------------
# Conditional-compilation blocks
# ---------------------------------------------------------------------------

pp_conditional := pp_if_branch pp_elsif_branch* pp_else_branch? pp_endif
               -> {if_branch: $1, elsif_branches: $2, else_branch: $3}

# pp_if_keyword: the `ifdef`/`ifndef` polarity, lifted into a NAMED rule
# (the systemverilog.ebnf `binary_operator` idiom). An inline alternation
# `(kw_ifdef | kw_ifndef)` as the lead element of pp_if_branch corrupted
# the positional model, so `keyword:$1` emitted `<invalid_sequence_access>`
# (SVPP-0001 / inline-alternation-$N defect class). The named rule fixes
# it and gives consumers a clean `{kind:"ifdef"|"ifndef"}` polarity
# discriminator.
pp_if_keyword := kw_ifdef  -> {kind: "ifdef"}
               | kw_ifndef -> {kind: "ifndef"}

pp_if_branch := pp_if_keyword macro_name directive_tail? newline pp_item*
             -> {keyword: $1, macro: $2, tail: $3, items: $5}
pp_elsif_branch := kw_elsif condition_expr newline pp_item*
                -> {condition: $2, items: $4}
pp_else_branch := kw_else directive_tail? newline pp_item*
               -> {tail: $2, items: $4}
pp_endif := kw_endif directive_tail? newline?
         -> {tail: $2}

condition_expr := condition_atom+
               -> {atoms: $1}
condition_atom := macro_token_paste -> {kind: "token_paste"}
                | macro_stringize   -> {kind: "stringize"}
                | macro_reference   -> {kind: "macro_reference", body: $1}
                | condition_text    -> {kind: "text",     body: $1}
                | lparen            -> {kind: "lparen"}
                | rparen            -> {kind: "rparen"}
                | comma             -> {kind: "comma"}
                | question          -> {kind: "question"}
                | colon             -> {kind: "colon"}
                | logical_or        -> {kind: "logical_or"}
                | logical_and       -> {kind: "logical_and"}
                | bang              -> {kind: "bang"}

# Comment-aware (GRAMMAR-WELLFORMED.H.5.5): a run of allowed chars, but a
# `/* ... */` block comment is matched ATOMICALLY (the alternative is tried
# FIRST, so a `/*` opener triggers whole-comment consumption) — thus an operator
# char (`(`,`)`,`?`,`:`,`!`,`|`,`&`) or backtick *inside* a comment no longer
# splits the run. Without this the bare `[^`(),?:!|&\r\n]` char-class ate the
# comment's `/*` then halted at the comment's internal special char, wrongly
# rejecting valid SV like ``\`elsif x /* a || b */`` (the parse-side gap this
# leaf fixes; the SAME fix already lives in `macro_body_text` /
# `macro_default_text`, SV-EXH-PROOF.2.3.1 — `condition_text` was simply missed).
#
# NOTE the deliberate ABSENCE of a leading `inline_trivia` (which the siblings
# above DO carry): once the content regex is comment-aware, a leading
# `inline_trivia` is both redundant (the char-class already admits ` `/`\t`, and
# the comment-alt admits comments) AND a round-trip HAZARD — it would re-consume,
# as trivia, a comment that the generator emitted as condition_text content,
# stranding a comment-only condition (`\`elsif /* c */`) the parser then cannot
# re-derive (condition_expr needs >=1 atom). Dropping it makes generation
# self-consistent. The `$text` matched-SPAN is unchanged for every
# currently-parseable input: a leading ` `/comment is captured identically
# whether `inline_trivia` or the regex consumes it (same start..end span).
condition_text := /(?:\/\*([^*]|\*+[^*\/])*\*+\/|[^`(),?:!|&\r\n])+/ -> $text

# ---------------------------------------------------------------------------
# Macro declaration support
# ---------------------------------------------------------------------------

# Cat-A fix (POST-SV-AUDIT.2.1): a pure comma-separated list. The old
# `{first:$2, rest:$3}` exposed the raw `[[comma,formal],…]` iteration
# envelope (consumers had to walk past every comma). The canonical
# extraction-spread `[$2, $3::2*]` (the `object_properties` reference
# idiom in return_annotation.ebnf) drops the separator and yields a
# clean flat `macro_formal` list.
macro_formals := lparen macro_formal (comma macro_formal)* rparen
              -> [$2, $3::2*]
macro_formal := macro_name (assign macro_default_value)?
             -> {name: $1, default: $2}

macro_default_value := macro_default_atom+
                    -> {atoms: $1}
macro_default_atom := macro_token_paste -> {kind: "token_paste"}
                    | macro_stringize   -> {kind: "stringize"}
                    | macro_reference   -> {kind: "macro_reference", body: $1}
                    | macro_default_text -> {kind: "text",  body: $1}
                    | lparen            -> {kind: "lparen"}
                    | rparen            -> {kind: "rparen"}
                    | question          -> {kind: "question"}
                    | colon             -> {kind: "colon"}

# Comment-aware (SV-EXH-PROOF.2.3.1, PGEN-SV-EXH-PROOF-0008): a run of
# allowed chars, but a `/* ... */` block comment is matched ATOMICALLY
# (alternative tried first) so a backtick *inside* a comment no longer
# splits the run. Without this the bare `[^`...]` char-class swallowed
# a comment's `/*` then halted at the comment's internal backtick,
# wrongly rejecting valid SV like ``\`define X(a=/*\`*/) y``. Mirrors
# the proven systemverilog.ebnf `timeunit_separator_trivia` /
# `block_comment` idiom; accepts strictly more, narrows nothing; the
# `{kind:"text", body:$1}` AST shape is unchanged.
macro_default_text := inline_trivia /(?:\/\*([^*]|\*+[^*\/])*\*+\/|[^`(),?:\r\n])+/

macro_body := macro_body_fragment+
           -> {fragments: $1}
macro_body_fragment := macro_token_paste -> {kind: "token_paste"}
                     | macro_stringize   -> {kind: "stringize"}
                     | macro_reference   -> {kind: "macro_reference", body: $1}
                     | macro_body_text   -> {kind: "text",   body: $1}
                     | lparen            -> {kind: "lparen"}
                     | rparen            -> {kind: "rparen"}
                     | comma             -> {kind: "comma"}
                     | question          -> {kind: "question"}
                     | colon             -> {kind: "colon"}

# Comment-aware — same fix + rationale as macro_default_text above
# (SV-EXH-PROOF.2.3.1, PGEN-SV-EXH-PROOF-0008).
macro_body_text := inline_trivia /(?:\/\*([^*]|\*+[^*\/])*\*+\/|[^`(),?:\r\n])+/
macro_reference := bt_identifier
macro_token_paste := inline_trivia /``/
macro_stringize := inline_trivia /`"/

# ---------------------------------------------------------------------------
# Passthrough lines
# ---------------------------------------------------------------------------

pp_non_directive_line := non_directive_text newline?
                      -> {text: $1}
pp_blank_line := newline
              -> {kind: "blank"}
non_directive_text := inline_trivia /[^`\r\n][^\r\n]*/
# GRAMMAR-WELLFORMED.H.5.3 — WITNESSING sample steering. `directive_tail`'s content
# `/[^\r\n]+/` is line-greedy, so an un-steered generation can emit a free run that
# over-produces a sample the parser rejects (a round-trip-faithfulness hazard). The older
# `@sample: " "` kept it benign but a bare space is consumed by the leading `inline_trivia`,
# so the mandatory `/[^\r\n]+/` body matches nothing on re-parse → `directive_tail?` takes the
# EMPTY arm → the rule was never WITNESSED (cert-coverage `UNKNOWN`). `@sample: " x"` keeps the
# tail benign (deterministic, faithful) AND survives `inline_trivia` so the real parser
# exercises `directive_tail` on re-parse → a genuine reachability witness.
@sample: " x"
directive_tail := inline_trivia /[^\r\n]+/
# GRAMMAR-WELLFORMED.H.5.3 — WITNESSING sample steering. The older `@sample: " "` short-circuited
# the whole rule to a space, so the inner `line_comment?` was never expanded and `line_comment`
# was never WITNESSED. `@sample: " //"` emits a minimal valid line comment (`line_comment :=
# /\/\/[^\r\n]*/` accepts `//` with an empty body), so on re-parse `inline_trivia line_comment?`
# matches `//` → `line_comment` is genuinely exercised → a real reachability witness, while
# staying benign (no free-content over-generation).
@sample: " //"
directive_comment_tail := inline_trivia line_comment?

# ---------------------------------------------------------------------------
# Identifiers and literals
# ---------------------------------------------------------------------------

macro_name := identifier
identifier := inline_trivia /[a-zA-Z_][a-zA-Z0-9_$]*/
bt_identifier := inline_trivia /`[a-zA-Z_][a-zA-Z0-9_$]*/

unsigned_number := inline_trivia /[0-9][0-9_]*/
quoted_string := inline_trivia /"([^"\\]|\\.)*"/
angle_path := inline_trivia /<[^>\r\n]+>/
time_unit := inline_trivia /(s|ms|us|ns|ps|fs)\b/

# ---------------------------------------------------------------------------
# Trivia and punctuation
# ---------------------------------------------------------------------------

inline_trivia := (space_or_tab | block_comment)*
space_or_tab := /[ \t]+/
line_comment := /\/\/[^\r\n]*/
block_comment := /\/\*([^*]|\*+[^*\/])*\*+\//

newline := inline_trivia /\r?\n/

slash := inline_trivia "/"
assign := inline_trivia "="
comma := inline_trivia ","
colon := inline_trivia ":"
question := inline_trivia "?"
bang := inline_trivia "!"
logical_or := inline_trivia "||"
logical_and := inline_trivia "&&"
lparen := inline_trivia "("
rparen := inline_trivia ")"

# ---------------------------------------------------------------------------
# Directive keywords
# ---------------------------------------------------------------------------

# GRAMMAR-WELLFORMED.H.5.1.2 — each directive keyword regex ends in `\b`, asserting a word
# boundary must follow (so `` `define `` is one token, never `` `define `` fused with a following
# `macro_name`). The `[>! /\w/]` lexical-annotation (LEXICAL-ANNOTATIONS Obligation C — the
# follow-restriction construct built for the stimuli generator) declares this for GENERATION:
# the generator self-terminates the keyword's surface with a space so it can never fuse with the
# next word char (`` `define_CV ``/`` `ifndefR7Sh `` would re-parse-fail the `\b`). `[>! …]` is a
# documented parse-direction no-op, so the generated parser is unchanged.
[>! /\w/]
kw_define := inline_trivia /`define\b/
[>! /\w/]
kw_undef := inline_trivia /`undef\b/
[>! /\w/]
kw_include := inline_trivia /`include\b/
[>! /\w/]
kw_ifdef := inline_trivia /`ifdef\b/
[>! /\w/]
kw_ifndef := inline_trivia /`ifndef\b/
[>! /\w/]
kw_elsif := inline_trivia /`elsif\b/
[>! /\w/]
kw_else := inline_trivia /`else\b/
[>! /\w/]
kw_endif := inline_trivia /`endif\b/
[>! /\w/]
kw_timescale := inline_trivia /`timescale\b/
[>! /\w/]
kw_default_nettype := inline_trivia /`default_nettype\b/
[>! /\w/]
kw_celldefine := inline_trivia /`celldefine\b/
[>! /\w/]
kw_endcelldefine := inline_trivia /`endcelldefine\b/
kw_none := inline_trivia /none\b/
