# systemverilog_preprocessor.ebnf
#
# The SystemVerilog preprocessor's directive-STRUCTURE grammar (IEEE 1800-2017 / 1800-2023 clause 22).
# Scope:
# - Every clause-22 directive (§22.1's list): `define` / `undef` / `undefineall`, `include` (a quoted,
#   angle-bracketed or macro-valued path), the `ifdef` family, `timescale`, `default_nettype`,
#   `celldefine` / `endcelldefine`, `resetall`, `unconnected_drive` / `nounconnected_drive`, `pragma`,
#   `line`, `begin_keywords` / `end_keywords` (SV-CORPUS-GRAD.13c.2v.1, release 1.0.8)
# - Nested conditional-compilation blocks
# - Macro formal/default argument syntax
# - Macro body primitives: token-paste, stringize, the `\`" escaped quote, backslash-newline
#   continuation, string literals and comments as opaque text
# - A text macro usage anywhere a source line may hold one, the start of a line included
#   (`__FILE__` / `__LINE__` among them, §22.13)
#
# Notes:
# - This grammar is intentionally line-oriented and deterministic.
# - Non-directive source lines are captured as passthrough text.
#
# WS-DIRECTIVE.2 — grammar-level layout policy: the preprocessor is
# line-oriented, so its REGEX TOKENS are whitespace-sensitive (a token like
# `[^\r\n]*` must start matching at the cursor, not after an auto-skip that
# could swallow a significant newline). String terminals and trailing layout
# keep the default skip. (This directive replaced the retired engine-side
# grammar-NAME gate; the policy now lives here, in the grammar, per the
# EBNF-single-source-of-truth doctrine.)

@whitespace_sensitive: { regex_tokens: true }
@entry: true
systemverilog_preprocessor_file := pp_item*
-> {type: "systemverilog_preprocessor_file", items: $1}

# STIMULI-SIGNOFF.12 — generation-side lexical cohesion: pp_item is a LINE
# construct whose trailing newline is optional (`pp_define := ... newline?`),
# so two STACKED quantified renderings can fuse into one line (a define body
# eats to end-of-line and would swallow the next directive). The stimuli
# generator therefore inserts "\n" between adjacent pp_item renderings unless
# the junction already carries a line break — and "\r\n" also counts as one,
# because THIS grammar's own newline token is `/\r?\n/`. (This directive
# replaced the retired engine-side grammar-NAME + container-rule-name gate;
# the policy now lives here, in the grammar, per the EBNF-single-source-of-
# truth doctrine. Parsing is unaffected: the directive steers stimuli only.)
@quantified_separator: { insert: "\n", satisfied_by: ["\n", "\r\n"] }
pp_item := pp_define              -> {kind: "define",              body: $1}
         | pp_undef               -> {kind: "undef",               body: $1}
         | pp_include             -> {kind: "include",             body: $1}
         | pp_timescale           -> {kind: "timescale",           body: $1}
         | pp_default_nettype     -> {kind: "default_nettype",     body: $1}
         | pp_celldefine          -> {kind: "celldefine"}
         | pp_endcelldefine       -> {kind: "endcelldefine"}
         | pp_resetall            -> {kind: "resetall",            body: $1}
         | pp_undefineall         -> {kind: "undefineall",         body: $1}
         | pp_unconnected_drive   -> {kind: "unconnected_drive",   body: $1}
         | pp_nounconnected_drive -> {kind: "nounconnected_drive", body: $1}
         | pp_pragma              -> {kind: "pragma",              body: $1}
         | pp_line                -> {kind: "line",                body: $1}
         | pp_begin_keywords      -> {kind: "begin_keywords",      body: $1}
         | pp_end_keywords        -> {kind: "end_keywords",        body: $1}
         | pp_conditional         -> {kind: "conditional",         body: $1}
         | pp_non_directive_line  -> {kind: "non_directive_line",  body: $1}
         | pp_blank_line          -> {kind: "blank_line"}

# ---------------------------------------------------------------------------
# Core directives
# ---------------------------------------------------------------------------

pp_define := kw_define macro_name macro_formals? macro_body? newline?
          -> {name: $2, formals: $3, body: $4}
pp_undef := kw_undef macro_name directive_comment_tail newline?
         -> {name: $2, comment: $3}
# SV-CORPUS-GRAD.13c.2v.4 (SVPP-0007) — §22.4 (both editions): "Only white space or a comment may appear on
# the same line as the `include compiler directive". The former `newline?` let the line's remainder re-read
# as a second, passthrough item (`include "a.sv" x was accepted); the line must end here.
pp_include := kw_include include_path directive_comment_tail line_end
           -> {path: $2, comment: $3}
pp_timescale := kw_timescale time_literal slash time_literal directive_comment_tail newline?
             -> {unit: $2, precision: $4, comment: $5}
pp_default_nettype := kw_default_nettype nettype_value directive_comment_tail newline?
                   -> {nettype: $2, comment: $3}
pp_celldefine := kw_celldefine directive_comment_tail newline?
              -> {comment: $2}
pp_endcelldefine := kw_endcelldefine directive_comment_tail newline?
                 -> {comment: $2}

# SV-CORPUS-GRAD.13c.2v.1 (release 1.0.8) — the seven clause-22 directives the grammar did not derive.
# Each carries its body at the `pp_item` dispatch (the `pp_undef` precedent), so no comment is dropped.
#   `resetall            §22.3     `undefineall          §22.5.3 (no arguments)
#   `unconnected_drive   §22.9     pull0 | pull1, and `nounconnected_drive
#   `pragma              §22.11, Syntax 22-8: pragma_name [ pragma_expression { , pragma_expression } ]
#   `line                §22.12, Syntax 22-9: number "filename" level
#   `begin_keywords      §22.14, Syntax 22-10: "version_specifier", and `end_keywords
# A directive with a DEFINED end keeps `newline?`: 1800-2023 §22.2 lets "each directive whose syntax shows a
# defined end to the directive ... be followed by another valid language element on the same line".
# `pragma` has no defined end (§22.2 names it among the directives "that include an indeterminate amount of
# text"), so its line must END there: `line_end` is required, and `pragma p a,` is refused.
pp_resetall := kw_resetall directive_comment_tail newline?
            -> {comment: $2}
pp_undefineall := kw_undefineall directive_comment_tail newline?
               -> {comment: $2}
pp_unconnected_drive := kw_unconnected_drive pull_drive directive_comment_tail newline?
                     -> {drive: $2, comment: $3}
pp_nounconnected_drive := kw_nounconnected_drive directive_comment_tail newline?
                       -> {comment: $2}
pp_pragma := kw_pragma pragma_name pragma_expression_list? directive_comment_tail line_end
          -> {name: $2, expressions: $3, comment: $4}
# §22.12: "only white space may appear on the same line as the `line directive. Comments are not allowed on
# the same line as a `line directive. All parameters in the `line directive are required." — every separator is
# `line_space` (spaces and tabs only, never `inline_trivia`, which admits a block comment), and the line ends
# after the level.
pp_line := kw_line line_number line_filename line_level line_terminator
        -> {number: $2, filename: $3, level: $4}
pp_begin_keywords := kw_begin_keywords version_specifier directive_comment_tail newline?
                  -> {version: $2, comment: $3}
pp_end_keywords := kw_end_keywords directive_comment_tail newline?
                -> {comment: $2}

pull_drive := kw_pull0 -> {kind: "pull0"}
            | kw_pull1 -> {kind: "pull1"}

# Syntax 22-8. `pragma_keyword = pragma_value` is tried before the bare keyword, and a bare identifier reads
# as a keyword; an identifier VALUE is reachable after `=`. clause 34's own examples separate the
# expressions with commas, as the syntax box does.
pragma_name := identifier
pragma_keyword := identifier
pragma_expression_list := pragma_expression (comma pragma_expression)*
                       -> [$1, $2::2*]
pragma_expression := pragma_keyword assign pragma_value -> {kind: "keyword_value", keyword: $1, value: $3}
                   | pragma_keyword                     -> {kind: "keyword", keyword: $1}
                   | pragma_value                       -> {kind: "value", value: $1}
pragma_value := pragma_value_list -> {kind: "list", expressions: $1}
              | pragma_number     -> {kind: "number", text: $1}
              | quoted_string     -> {kind: "string", text: $1}
              | identifier        -> {kind: "identifier", name: $1}
pragma_value_list := lparen pragma_expression_list rparen
                  -> $2
# A.8.7 `number`: a real (fixed point or exponent form), a sized or unsized based integral number
# (`4'b10_1x`, `8 'sd 255`, `'hFF`), or an unsigned decimal — the real forms first, so `3.5e-2` is one token.
pragma_number := inline_trivia /[0-9][0-9_]*\.[0-9][0-9_]*(?:[eE][+-]?[0-9][0-9_]*)?|[0-9][0-9_]*[eE][+-]?[0-9][0-9_]*|(?:[1-9][0-9_]*[ \t]*)?'[sS]?(?:[dD][ \t]*(?:[0-9][0-9_]*|[xXzZ?]_*)|[bB][ \t]*[01xXzZ?][01xXzZ?_]*|[oO][ \t]*[0-7xXzZ?][0-7xXzZ?_]*|[hH][ \t]*[0-9a-fA-FxXzZ?][0-9a-fA-FxXzZ?_]*)|[0-9][0-9_]*/

# §22.12: the number "shall be a positive integer", the filename "shall be a string literal", the level
# "shall be 0, 1, or 2".
line_space := space_or_tab*
line_number := line_space /0*[1-9][0-9]*/
line_filename := line_space /"([^"\\\r\n]|\\.)*"/
line_level := line_space /[012]\b/
line_terminator := line_space line_end
line_end := /\r?\n|\z/

# Syntax 22-10. One grammar serves both editions: the list is 1800-2023's (1800-2017's plus "1800-2023"),
# which §22.14 permits — "Implementations and other standards are permitted to extend the `begin_keywords
# directive with custom version specifiers" — and the expansion stage holds the per-edition admission
# (`keyword_versions.rs`, W_SVPP_KEYWORDS_VERSION_NOT_IN_EDITION). Any other text is refused.
version_specifier := inline_trivia /"(?:1800-2023|1800-2017|1800-2012|1800-2009|1800-2005|1364-2005|1364-2001-noconfig|1364-2001|1364-1995)"/

include_path := quoted_string       -> {kind: "quoted", text: $1}
              | angle_path          -> {kind: "angle",  text: $1}
              | include_macro_usage -> {kind: "macro",  body: $1}

# SV-CORPUS-GRAD.13c.2v.7 — §22.5.1 (both editions): "The `include directive can be followed by a macro,
# instead of a string literal" (`include `home(myfile)). The actuals are one balanced-parenthesis span
# (`$text`); `include `else stays refused — a directive keyword is not a macro.
include_macro_usage := !directive_keyword macro_reference macro_usage_arguments?
                    -> {name: $2, arguments: $3}
macro_usage_arguments := lparen macro_argument_atom* rparen
                      -> $text
macro_argument_atom := macro_argument_text
                     | macro_argument_group
macro_argument_group := lparen macro_argument_atom* rparen
macro_argument_text := inline_trivia /[^()\r\n]+/

nettype_value := identifier -> {kind: "identifier", body: $1}
               | kw_none    -> {kind: "none"}

time_literal := unsigned_number time_unit
             -> {value: $1, unit: $2}

# ---------------------------------------------------------------------------
# Conditional-compilation blocks
# ---------------------------------------------------------------------------

pp_conditional := pp_if_branch pp_elsif_branch* pp_else_branch? pp_endif
               -> {if_branch: $1, elsif_branches: $2, else_branch: $3}

# pp_if_keyword: the `ifdef`/`ifndef` polarity, lifted into a NAMED rule
# (the systemverilog.ebnf `binary_operator` idiom). An inline alternation
# `(kw_ifdef | kw_ifndef)` as the lead element of pp_if_branch corrupted
# the positional model, so `keyword:$1` emitted `<invalid_sequence_access>`
# (SVPP-0001 / inline-alternation-$N defect class). The named rule fixes
# it and gives consumers a clean `{kind:"ifdef"|"ifndef"}` polarity
# discriminator.
pp_if_keyword := kw_ifdef  -> {kind: "ifdef"}
               | kw_ifndef -> {kind: "ifndef"}

pp_if_branch := pp_if_keyword macro_name directive_tail? newline pp_item*
             -> {keyword: $1, macro: $2, tail: $3, items: $5}
pp_elsif_branch := kw_elsif condition_expr newline pp_item*
                -> {condition: $2, items: $4}
pp_else_branch := kw_else directive_tail? newline pp_item*
               -> {tail: $2, items: $4}
pp_endif := kw_endif directive_tail? newline?
         -> {tail: $2}

condition_expr := condition_atom+
               -> {atoms: $1}
condition_atom := macro_token_paste -> {kind: "token_paste"}
                | macro_stringize   -> {kind: "stringize"}
                | macro_reference   -> {kind: "macro_reference", body: $1}
                | condition_text    -> {kind: "text",     body: $1}
                | lparen            -> {kind: "lparen"}
                | rparen            -> {kind: "rparen"}
                | comma             -> {kind: "comma"}
                | question          -> {kind: "question"}
                | colon             -> {kind: "colon"}
                | logical_or        -> {kind: "logical_or"}
                | logical_and       -> {kind: "logical_and"}
                | bang              -> {kind: "bang"}

# Comment-aware (GRAMMAR-WELLFORMED.H.5.5): a run of allowed chars, but a
# `/* ... */` block comment is matched ATOMICALLY (the alternative is tried
# FIRST, so a `/*` opener triggers whole-comment consumption) — thus an operator
# char (`(`,`)`,`?`,`:`,`!`,`|`,`&`) or backtick *inside* a comment no longer
# splits the run. Without this the bare `[^`(),?:!|&\r\n]` char-class ate the
# comment's `/*` then halted at the comment's internal special char, wrongly
# rejecting valid SV like ``\`elsif x /* a || b */`` (the parse-side gap this
# leaf fixes; the SAME fix already lives in `macro_body_text` /
# `macro_default_text`, SV-EXH-PROOF.2.3.1 — `condition_text` was simply missed).
#
# NOTE the deliberate ABSENCE of a leading `inline_trivia` (which the siblings
# above DO carry): once the content regex is comment-aware, a leading
# `inline_trivia` is both redundant (the char-class already admits ` `/`\t`, and
# the comment-alt admits comments) AND a round-trip HAZARD — it would re-consume,
# as trivia, a comment that the generator emitted as condition_text content,
# stranding a comment-only condition (`\`elsif /* c */`) the parser then cannot
# re-derive (condition_expr needs >=1 atom). Dropping it makes generation
# self-consistent. The `$text` matched-SPAN is unchanged for every
# currently-parseable input: a leading ` `/comment is captured identically
# whether `inline_trivia` or the regex consumes it (same start..end span).
condition_text := /(?:\/\*([^*]|\*+[^*\/])*\*+\/|[^`(),?:!|&\r\n])+/ -> $text

# ---------------------------------------------------------------------------
# Macro declaration support
# ---------------------------------------------------------------------------

# Cat-A fix (POST-SV-AUDIT.2.1): a pure comma-separated list. The old
# `{first:$2, rest:$3}` exposed the raw `[[comma,formal],…]` iteration
# envelope (consumers had to walk past every comma). The canonical
# extraction-spread `[$2, $3::2*]` (the `object_properties` reference
# idiom in return_annotation.ebnf) drops the separator and yields a
# clean flat `macro_formal` list.
#
# SV-CORPUS-GRAD.13c.2v.5 (SVPP-0008) — §22.5.1 (2017): "The left parenthesis shall follow the text macro name
# immediately, with no space in between" (2023: "no white space shall separate the opening parenthesis from the
# macro name"). `formals_open` is a regex token, so nothing is skipped before it: `define M (x) y is an
# OBJECT-like macro whose text is "(x) y" — the reading the expansion stage has always had — where the former
# `lparen` (inline trivia first) made it function-like.
macro_formals := formals_open macro_formal (comma macro_formal)* rparen
              -> [$2, $3::2*]
macro_formal := macro_name (assign macro_default_value)?
             -> {name: $1, default: $2}

macro_default_value := macro_default_atom+
                    -> {atoms: $1}
macro_default_atom := macro_token_paste -> {kind: "token_paste"}
                    | macro_stringize   -> {kind: "stringize"}
                    | macro_reference   -> {kind: "macro_reference", body: $1}
                    | macro_default_text -> {kind: "text",  body: $1}
                    | macro_default_paren_group
                    | question          -> {kind: "question"}
                    | colon             -> {kind: "colon"}

# GRAMMAR-WELLFORMED.H.9 (SVPP-0004): IEEE 1800 §22.5.1 — a macro default may contain a
# comma or right parenthesis only INSIDE "a balanced pair of parentheses". The former
# bare `lparen`/`rparen` alternatives above let the possessive `macro_default_atom+`
# swallow the FORMALS' closing `)` (so a default on the LAST formal — legal, used by
# the LRM's own examples — re-routed the whole `(...)` into the macro body with
# `formals: []`). A balanced group consumes only its own parentheses, so an unbalanced
# `)` correctly terminates the default; commas are legal inside the group (and only
# there), per the same LRM sentence. Found by the H.7.2 plannable-rule reach pass
# (the parsed-but-routed-elsewhere verdict on `macro_default_text`).
macro_default_paren_group := lparen macro_default_group_atom* rparen
                          -> {kind: "paren_group", atoms: $2}
macro_default_group_atom := macro_default_atom -> $1
                         | comma -> {kind: "comma"}

# Comment-aware (SV-EXH-PROOF.2.3.1, PGEN-SV-EXH-PROOF-0008): a run of
# allowed chars, but a `/* ... */` block comment is matched ATOMICALLY
# (alternative tried first) so a backtick *inside* a comment no longer
# splits the run. Without this the bare `[^`...]` char-class swallowed
# a comment's `/*` then halted at the comment's internal backtick,
# wrongly rejecting valid SV like ``\`define X(a=/*\`*/) y``. Mirrors
# the proven systemverilog.ebnf `timeunit_separator_trivia` /
# `block_comment` idiom; accepts strictly more, narrows nothing; the
# `{kind:"text", body:$1}` AST shape is unchanged.
#
# SV-CORPUS-GRAD.13c.2v.6 (SVPP-0009) — a string literal is one atom of default text: §22.5.1 "Actual arguments
# and defaults shall not contain comma or right parenthesis characters outside matched pairs of ... double
# quotes", so `define M(a="x,y") closes its formals.
macro_default_text := inline_trivia /(?:\/\*([^*]|\*+[^*\/])*\*+\/|"(?:[^"\\\r\n]|\\.)*"|[^`(),?:\r\n])+/

macro_body := macro_body_fragment+
           -> {fragments: $1}
# SV-CORPUS-GRAD.13c.2v.3 (SVPP-0006) — backslash-newline CONTINUATION: §22.5.1 (2017) "If more than one line
# is necessary to specify the text, the newline shall be preceded by a backslash"; (2023) "immediately
# preceded". The body formerly ended at the first newline, its tree holding `"a + \\"` and the continuation
# reading as a separate passthrough line. A backslash followed by white space is NOT a continuation
# (SVPP-EXPANSION.5(r): no edition licenses it).
# SV-CORPUS-GRAD.13c.2v.6 — `\`" (§22.5.1: "The `define macro text can also include `", `\`", and ``").
macro_body_fragment := macro_line_continuation -> {kind: "line_continuation"}
                     | macro_token_paste -> {kind: "token_paste"}
                     | macro_stringize   -> {kind: "stringize"}
                     | macro_escaped_quote -> {kind: "escaped_quote"}
                     | macro_reference   -> {kind: "macro_reference", body: $1}
                     | macro_body_text   -> {kind: "text",   body: $1}
                     | lparen            -> {kind: "lparen"}
                     | rparen            -> {kind: "rparen"}
                     | comma             -> {kind: "comma"}
                     | question          -> {kind: "question"}
                     | colon             -> {kind: "colon"}

# Comment-aware — same fix + rationale as macro_default_text above
# (SV-EXH-PROOF.2.3.1, PGEN-SV-EXH-PROOF-0008).
# SV-CORPUS-GRAD.13c.2v.6 (SVPP-0009) — three more atoms, each per §22.5.1: a `//` comment ("the comment shall
# not become part of the substituted text"), which runs up to — not including — a continuation backslash
# (2023: "the comment ends before the backslash and the macro text continues on the next line"); a plain string
# literal ("Macro substitution and argument substitution shall not occur within string literals"), so a
# backtick, a parenthesis or a comma inside it no longer splits or ends the run; and a backslash, consumed only
# with the character after it, so the backslash that ends a line is the continuation's.
macro_body_text := inline_trivia /(?:\/\*([^*]|\*+[^*\/])*\*+\/|\/\/(?:[^\r\n\\]|\\(?:[^\r\n]|\z))*|"(?:[^"\\\r\n]|\\(?:[^\r\n]|\z))*"|\\(?:[^\r\n]|\z)|[^`(),?:\r\n\\])+/
macro_line_continuation := inline_trivia /\\\r?\n/
macro_reference := bt_identifier
macro_token_paste := inline_trivia /``/
macro_stringize := inline_trivia /`"/
macro_escaped_quote := inline_trivia /`\\`"/

# ---------------------------------------------------------------------------
# Passthrough lines
# ---------------------------------------------------------------------------

# SV-CORPUS-GRAD.13c.2v.2 (SVPP-0005) — a line may OPEN with a text macro usage (§22.5.1 `text_macro_usage
# ::= `text_macro_identifier [ ( list_of_actual_arguments ) ]` may stand wherever source text may):
# `uvm_object_utils(c), `ASSERT(...), `__FILE__ (§22.13). The former first character `[^`\r\n]` refused every
# such line — 4,182 of the 4,477 corpus files release 1.0.7 rejected. `!directive_keyword` keeps a MALFORMED
# directive refused (`timescale 1ns, a stray `else), which would otherwise re-read as a macro-usage line;
# `{text: $2}` because the lookahead occupies the first slot.
pp_non_directive_line := !directive_keyword non_directive_text newline?
                      -> {text: $2}
pp_blank_line := newline
              -> {kind: "blank"}
non_directive_text := inline_trivia /[^`\r\n][^\r\n]*|`[a-zA-Z_][a-zA-Z0-9_$]*[^\r\n]*/
# GRAMMAR-WELLFORMED.H.5.3 — WITNESSING sample steering. `directive_tail`'s content
# `/[^\r\n]+/` is line-greedy, so an un-steered generation can emit a free run that
# over-produces a sample the parser rejects (a round-trip-faithfulness hazard). The older
# `@sample: " "` kept it benign but a bare space is consumed by the leading `inline_trivia`,
# so the mandatory `/[^\r\n]+/` body matches nothing on re-parse → `directive_tail?` takes the
# EMPTY arm → the rule was never WITNESSED (cert-coverage `UNKNOWN`). `@sample: " x"` keeps the
# tail benign (deterministic, faithful) AND survives `inline_trivia` so the real parser
# exercises `directive_tail` on re-parse → a genuine reachability witness.
@sample: " x"
directive_tail := inline_trivia /[^\r\n]+/
# GRAMMAR-WELLFORMED.H.5.3 — WITNESSING sample steering. The older `@sample: " "` short-circuited
# the whole rule to a space, so the inner `line_comment?` was never expanded and `line_comment`
# was never WITNESSED. `@sample: " //"` emits a minimal valid line comment (`line_comment :=
# /\/\/[^\r\n]*/` accepts `//` with an empty body), so on re-parse `inline_trivia line_comment?`
# matches `//` → `line_comment` is genuinely exercised → a real reachability witness, while
# staying benign (no free-content over-generation).
@sample: " //"
directive_comment_tail := inline_trivia line_comment?

# ---------------------------------------------------------------------------
# Identifiers and literals
# ---------------------------------------------------------------------------

macro_name := identifier
identifier := inline_trivia /[a-zA-Z_][a-zA-Z0-9_$]*/
bt_identifier := inline_trivia /`[a-zA-Z_][a-zA-Z0-9_$]*/

unsigned_number := inline_trivia /[0-9][0-9_]*/
quoted_string := inline_trivia /"([^"\\]|\\.)*"/
angle_path := inline_trivia /<[^>\r\n]+>/
time_unit := inline_trivia /(s|ms|us|ns|ps|fs)\b/

# ---------------------------------------------------------------------------
# Trivia and punctuation
# ---------------------------------------------------------------------------

inline_trivia := (space_or_tab | block_comment)*
space_or_tab := /[ \t]+/
line_comment := /\/\/[^\r\n]*/
block_comment := /\/\*([^*]|\*+[^*\/])*\*+\//

newline := inline_trivia /\r?\n/

slash := inline_trivia "/"
assign := inline_trivia "="
comma := inline_trivia ","
colon := inline_trivia ":"
question := inline_trivia "?"
bang := inline_trivia "!"
logical_or := inline_trivia "||"
logical_and := inline_trivia "&&"
lparen := inline_trivia "("
formals_open := /\(/   # no leading trivia: §22.5.1, see macro_formals
rparen := inline_trivia ")"

# ---------------------------------------------------------------------------
# Directive keywords
# ---------------------------------------------------------------------------

# GRAMMAR-WELLFORMED.H.5.1.2 — each directive keyword regex ends in `\b`, asserting a word
# boundary must follow (so `` `define `` is one token, never `` `define `` fused with a following
# `macro_name`). The `[>! /\w/]` lexical-annotation (LEXICAL-ANNOTATIONS Obligation C — the
# follow-restriction construct built for the stimuli generator) declares this for GENERATION:
# the generator self-terminates the keyword's surface with a space so it can never fuse with the
# next word char (`` `define_CV ``/`` `ifndefR7Sh `` would re-parse-fail the `\b`). `[>! …]` is a
# documented parse-direction no-op, so the generated parser is unchanged.
[>! /\w/]
kw_define := inline_trivia /`define\b/
[>! /\w/]
kw_undef := inline_trivia /`undef\b/
[>! /\w/]
kw_include := inline_trivia /`include\b/
[>! /\w/]
kw_ifdef := inline_trivia /`ifdef\b/
[>! /\w/]
kw_ifndef := inline_trivia /`ifndef\b/
[>! /\w/]
kw_elsif := inline_trivia /`elsif\b/
[>! /\w/]
kw_else := inline_trivia /`else\b/
[>! /\w/]
kw_endif := inline_trivia /`endif\b/
[>! /\w/]
kw_timescale := inline_trivia /`timescale\b/
[>! /\w/]
kw_default_nettype := inline_trivia /`default_nettype\b/
[>! /\w/]
kw_celldefine := inline_trivia /`celldefine\b/
[>! /\w/]
kw_endcelldefine := inline_trivia /`endcelldefine\b/
[>! /\w/]
kw_resetall := inline_trivia /`resetall\b/
[>! /\w/]
kw_undefineall := inline_trivia /`undefineall\b/
[>! /\w/]
kw_unconnected_drive := inline_trivia /`unconnected_drive\b/
[>! /\w/]
kw_nounconnected_drive := inline_trivia /`nounconnected_drive\b/
[>! /\w/]
kw_pragma := inline_trivia /`pragma\b/
[>! /\w/]
# `line takes white space only before it (§22.12); `kw_line_word` is the trivia-tolerant spelling the
# `directive_keyword` lookahead needs, so `/* c */ `line 1 "f" 0` stays refused rather than re-reading as text.
kw_line := line_space /`line\b/
[>! /\w/]
kw_line_word := inline_trivia /`line\b/
[>! /\w/]
kw_begin_keywords := inline_trivia /`begin_keywords\b/
[>! /\w/]
kw_end_keywords := inline_trivia /`end_keywords\b/
[>! /\w/]
kw_pull0 := inline_trivia /pull0\b/
[>! /\w/]
kw_pull1 := inline_trivia /pull1\b/
kw_none := inline_trivia /none\b/

# The twenty §22.1 directive keywords (`__FILE__` / `__LINE__` are predefined MACROS, §22.13) — read only by
# the negative lookaheads of `pp_non_directive_line` and `include_macro_usage`. A new directive keyword joins
# this list in the same edit, or a malformed use of it would be accepted as a macro-usage line.
directive_keyword := kw_define | kw_undef | kw_undefineall | kw_include
                   | kw_ifdef | kw_ifndef | kw_elsif | kw_else | kw_endif
                   | kw_timescale | kw_default_nettype | kw_celldefine | kw_endcelldefine
                   | kw_resetall | kw_unconnected_drive | kw_nounconnected_drive
                   | kw_pragma | kw_line_word | kw_begin_keywords | kw_end_keywords
