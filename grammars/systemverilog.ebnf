logical_and := trivia "&&"                    -> {kind: "logical_and"}
logical_and3 := trivia "&&&"                   -> {kind: "logical_and3"}
logical_or := trivia "||"                     -> {kind: "logical_or"}
lparen := trivia "("                         -> {kind: "lparen"}
minus := trivia "-"                          -> {kind: "minus"}
minus_assign := trivia "-="                   -> {kind: "minus_assign"}
minus_minus := trivia "--"                    -> {kind: "minus_minus"}
# SVA sequence-implication operators (IEEE 1800-2017 A.2.10) — SystemVerilog-only,
# absent from IEEE 1364-2005, so profile-gated like nonblocking_implies (`->>`, SV-0023).
@profiles: ["sv_2017", "sv_2023"]
non_overlapped_implication := trivia "|=>"    -> {kind: "non_overlapped_implication"}
not_equal := trivia "!="                      -> {kind: "not_equal"}
or_assign := trivia "|="                      -> {kind: "or_assign"}
@profiles: ["sv_2017", "sv_2023"]
overlapped_implication := trivia "|->"        -> {kind: "overlapped_implication"}
percent := trivia "%"                        -> {kind: "percent"}
percent_assign := trivia "%="                 -> {kind: "percent_assign"}
plus := trivia "+"                           -> {kind: "plus"}
plus_assign := trivia "+="                    -> {kind: "plus_assign"}
plus_plus := trivia "++"                      -> {kind: "plus_plus"}
power := trivia "**"                          -> {kind: "power"}
question := trivia "?"                       -> {kind: "question"}
rbrace := trivia "}"                         -> {kind: "rbrace"}
rbrack := trivia "]"                         -> {kind: "rbrack"}
reduction_nand := trivia "~&"                 -> {kind: "reduction_nand"}
reduction_nor := trivia "~|"                  -> {kind: "reduction_nor"}
reduction_xnor := trivia "~^"                 -> {kind: "reduction_xnor"}
reduction_xnor_alt := trivia "^~"             -> {kind: "reduction_xnor_alt"}
rparen := trivia ")"                         -> {kind: "rparen"}
# SV-0031 (VERILOG-2005-PROFILE.6.11): the `::` scope-resolution operator is IEEE 1800
# (SystemVerilog) only — IEEE 1364-2005 has no `::` token anywhere in Annex A. This is the
# SINGLE producer of `::`; all 37 consumers (package_scope, class_scope, package import/export,
# class_scoped_call_prefix, local::, and the !scope_resolution negative-lookaheads in the core
# identifier rules) are therefore SV-only. Gating the token root prunes the ENTIRE `::` class
# under verilog_2005 at once: every positive `::`-route dies and the negative-lookaheads always
# pass (correct — no `::` in v2005). Under sv_2017/sv_2023 the guard passes → AST byte-identical.
# Whole-rule @profiles gate idiom, cf. unsized_dimension (.6.9) / uniqueness_constraint.
@profiles: ["sv_2017", "sv_2023"]
scope_resolution := trivia "::"               -> {kind: "scope_resolution"}
semi := trivia ";"                           -> {kind: "semi"}
sequence_implies := trivia "=>"               -> {kind: "sequence_implies"}
shift_left := trivia "<<"                     -> {kind: "shift_left"}
shift_left_assign := trivia "<<="              -> {kind: "shift_left_assign"}
shift_right := trivia ">>"                    -> {kind: "shift_right"}
shift_right_assign := trivia ">>="             -> {kind: "shift_right_assign"}
slash := trivia "/"                          -> {kind: "slash"}
slash_assign := trivia "/="                   -> {kind: "slash_assign"}
star := trivia "*"                           -> {kind: "star"}
star_assign := trivia "*="                    -> {kind: "star_assign"}
tick := trivia "'"                           -> {kind: "tick"}
tilde := trivia "~"                          -> {kind: "tilde"}
wildcard_equal := trivia "==?"                 -> {kind: "wildcard_equal"}
wildcard_not_equal := trivia "!=?"             -> {kind: "wildcard_not_equal"}
xor_assign := trivia "^="                     -> {kind: "xor_assign"}
@predicate: { name: fact_attribute_equals, args: [type_name, $body, declaration_family, class], phase: post }
known_unscoped_class_scoped_call_class_identifier := class_identifier

@predicate: { name: fact_attribute_equals, args: [type_name, $body, declaration_family, interface_class], phase: post }
known_unscoped_class_scoped_call_interface_class_identifier := class_identifier

@predicate: { name: fact_attribute_equals, args: [type_name, $body, declaration_family, type_parameter], phase: post }
known_unscoped_class_scoped_call_type_parameter_identifier := type_identifier

# SV-EXH-PROOF.3.3.4.b.6.2.10 — local tighten (not on `non_typedef_package_scope`
# which is shared with rules where a class CAN legitimately serve as a scope).
# Here the rule's name and intent are unambiguous: it's a `<pkg>::<class>`
# prefix for a class-scoped call (the OUTER class_scoped_call_prefix then
# expects another `scope_resolution` to reach the tf_identifier). The pkg
# slot MUST be a package, not a class — otherwise PEG longest_match in the
# inner alternation of class_scoped_call_prefix wrongly picks this branch
# for `C::set();` (consuming `C::set` as `<pkg>::<class>`) over the SHORTER
# but CORRECT `known_unscoped_class_scoped_call_class_identifier=C` branch,
# and the subsequent mandatory `scope_resolution` fails because `C::set()`
# has only ONE `::`. Net: bare `class_scoped_tf_call` statements like
# `uvm_coreservice_t::set(dcs);` (the uvm_pkg blocker at line 6605, the
# .b.6.2.9 trigger) were unparseable. Adding `lacks_class` here keeps the
# rule's semantics correct (a real package scope, not a class shadowing)
# WITHOUT side-effecting `non_typedef_package_scope`'s legitimate use as a
# class-can-scope prefix in `scoped_class_scope_identifier`,
# `scoped_class_type_identifier`, etc. Parser-AGNOSTIC at level 1/2 of the
# no-workarounds hierarchy (existing primitives only).
# GRAMMAR-WELLFORMED.H.12.8.3.1 — branch-1 longest-match shadowing fix. The
# `<pkg>::<class>` branch must fire ONLY for a genuine PACKAGE scope. The
# original `lacks_class` gate excludes a CLASS head (so `C::m()` correctly
# routes to `known_unscoped_class_scoped_call_class_identifier`, which IS
# witnessed), but NOT an interface_class or type_parameter head. For those,
# branch 1 longest-matched `IF::m` / `T::m` (consuming `head::m` as
# `<pkg>::<class>`), shadowing the dedicated cousin branches
# `known_unscoped_class_scoped_call_interface_class_identifier` (:6237) and
# `…type_parameter_identifier` (:6240); the call then fell through to the
# ungated `package_scope` tf_call, so the cousins were never witnessed
# (canonical cert reach-gaps, `parsed=true witnessed_target=false`). These two
# AND-stacked predicates (template: `known_unscoped_block_class_type` :1642-1644)
# extend the same exclusion to the other two non-package type families, so an
# interface_class/type_parameter head now falls through to its dedicated cousin.
# Surgical: this rule is used ONLY in `class_scoped_call_prefix`. Parser-AGNOSTIC.
@predicate: { name: lacks_fact_attribute_equals, args: [type_name, $scope.body.name.body, declaration_family, class], phase: post, view: shaped }
@predicate: { name: lacks_fact_attribute_equals, args: [type_name, $scope.body.name.body, declaration_family, interface_class], phase: post, view: shaped }
@predicate: { name: lacks_fact_attribute_equals, args: [type_name, $scope.body.name.body, declaration_family, type_parameter], phase: post, view: shaped }
@profiles: ["sv_2017", "sv_2023"]
scoped_class_scoped_call_prefix_identifier := non_typedef_package_scope class_identifier -> {scope: $1, name: $2}

# SV-AST-SHAPE-FIDELITY.2.7 (candidate #21, = the SV-0013 rule) — named-lift the
# inline 4-way head alternation so the outer rule's bare `$1` binds the clean
# named rule (the `.2.3` `class_scope_type_head` / `.2.2` `base_class_type_head`
# idiom). Previously the self-annotated `scoped_class_scoped_call_prefix_identifier`
# branch (`-> {scope, name}`) mis-recursed the outer `{head:$1, params:$2,
# scope_chain:$4}` annotation onto its result, corrupting `params`/`scope_chain`
# into `<invalid_sequence_access>` for a reachable `pkg::C::foo()` static method
# call (ast_return_transform.rs:193/438). SV-0013 gated the branches inside the
# alt but did not lift it; this completes that rule. Positions $1..$4 unchanged.
class_scoped_call_prefix_head := scoped_class_scoped_call_prefix_identifier | known_unscoped_class_scoped_call_class_identifier | known_unscoped_class_scoped_call_interface_class_identifier | known_unscoped_class_scoped_call_type_parameter_identifier

@profiles: ["sv_2017", "sv_2023"]
class_scoped_call_prefix := class_scoped_call_prefix_head ( parameter_value_assignment )? scope_resolution ( class_identifier ( parameter_value_assignment )? scope_resolution )*
                        -> {head: $1, params: $2, scope_chain: $4}
@profiles: ["sv_2017", "sv_2023"]
class_scoped_tf_call_with_args := class_scoped_call_prefix tf_identifier attribute_instance* lparen list_of_arguments rparen
                               -> {prefix: $1, name: $2, attributes: $3, args: $5}

@branch_policy: priority_first
@profiles: ["sv_2017", "sv_2023"]
class_scoped_tf_call := class_scoped_tf_call_with_args
                              -> {kind: "with_args", body: $1}
                     | class_scoped_call_prefix tf_identifier attribute_instance*
                              -> {kind: "bare",      prefix: $1, name: $2, attributes: $3}
