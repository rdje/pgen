pull_gate_instance := ( name_of_instance )? lparen output_terminal rparen
                   -> {name: $1, output: $3}

# IEEE 1800-2017 A.8.6: `pulldown_strength ::= ( strength0 , strength1 ) | ( strength1 , strength0 ) | ( strength0 )`
pulldown_strength := lparen strength0 comma strength1 rparen -> {kind: "pair", first: $2, second: $4}
                  | lparen strength1 comma strength0 rparen -> {kind: "pair", first: $2, second: $4}
                  | lparen strength0 rparen                 -> {kind: "single", value: $2}

# IEEE 1800-2017 A.8.6: `pullup_strength ::= ( strength0 , strength1 ) | ( strength1 , strength0 ) | ( strength1 )`
pullup_strength := lparen strength0 comma strength1 rparen -> {kind: "pair", first: $2, second: $4}
                | lparen strength1 comma strength0 rparen -> {kind: "pair", first: $2, second: $4}
                | lparen strength1 rparen                 -> {kind: "single", value: $2}

pulse_control_specparam := kw_PATHPULSE_dollar_e0f78dc5 assign lparen reject_limit_value ( comma error_limit_value )? rparen
