# SV-0035 (SV-KEYWORD-PRIMARY-FIDELITY.2): route through the keyword-excluding
# `non_keyword_identifier` so a reserved type keyword (`integer`/`real`/…) can no
# longer match as a bare `constant_primary` expression name (`localparam p =
# integer;`). Shape-preserving: `identifier` and `non_keyword_identifier` both emit
# `{body:X}`, so `{kind:"specparam", name:{body:X}}` is byte-identical for legal names.
specparam_identifier := non_keyword_identifier

start_edge_offset := mintypmax_expression
                  -> {body: $1}

state_dependent_path_declaration := kw_if_958f57f5 lparen module_path_expression rparen simple_path_declaration
                                          -> {kind: "if_simple",         condition: $3, body: $5}
                                  | kw_if_958f57f5 lparen module_path_expression rparen edge_sensitive_path_declaration
                                          -> {kind: "if_edge_sensitive", condition: $3, body: $5}
                                  | kw_ifnone_32ae8180 simple_path_declaration
                                          -> {kind: "ifnone",                            body: $2}

statement := ( block_identifier colon !colon )? attribute_instance* statement_item
          -> {label: $1, attributes: $2, body: $3}

@profiles: ["sv_2017", "verilog_2005"]
statement_item_sv_2017 := blocking_assignment semi                  -> {kind: "blocking_assignment",              body: $1}
                        | nonblocking_assignment semi               -> {kind: "nonblocking_assignment",           body: $1}
                        | procedural_continuous_assignment semi     -> {kind: "procedural_continuous_assignment", body: $1}
                        | case_statement                            -> {kind: "case",                             body: $1}
                        | conditional_statement                     -> {kind: "conditional",                      body: $1}
                        | inc_or_dec_expression semi                -> {kind: "inc_or_dec_expression",            body: $1}
                        | subroutine_call_statement                 -> {kind: "subroutine_call",                  body: $1}
                        | disable_statement                         -> {kind: "disable",                          body: $1}
                        | event_trigger                             -> {kind: "event_trigger",                    body: $1}
                        | loop_statement                            -> {kind: "loop",                             body: $1}
                        | jump_statement                            -> {kind: "jump",                             body: $1}
                        | par_block                                 -> {kind: "par_block",                        body: $1}
                        | procedural_timing_control_statement       -> {kind: "procedural_timing_control",        body: $1}
                        | seq_block                                 -> {kind: "seq_block",                        body: $1}
                        | wait_statement                            -> {kind: "wait",                             body: $1}
                        | procedural_assertion_statement            -> {kind: "procedural_assertion",             body: $1}
                        | clocking_drive semi                       -> {kind: "clocking_drive",                   body: $1}
                        | randsequence_statement                    -> {kind: "randsequence",                     body: $1}
                        | randcase_statement                        -> {kind: "randcase",                         body: $1}
                        | expect_property_statement                 -> {kind: "expect_property",                  body: $1}

@profiles: ["sv_2023"]
statement_item_sv_2023 := blocking_assignment semi                  -> {kind: "blocking_assignment",              body: $1}
                        | nonblocking_assignment semi               -> {kind: "nonblocking_assignment",           body: $1}
                        | procedural_continuous_assignment semi     -> {kind: "procedural_continuous_assignment", body: $1}
                        | case_statement                            -> {kind: "case",                             body: $1}
                        | conditional_statement                     -> {kind: "conditional",                      body: $1}
                        | subroutine_call_statement                 -> {kind: "subroutine_call",                  body: $1}
                        | disable_statement                         -> {kind: "disable",                          body: $1}
                        | event_trigger                             -> {kind: "event_trigger",                    body: $1}
                        | loop_statement                            -> {kind: "loop",                             body: $1}
                        | jump_statement                            -> {kind: "jump",                             body: $1}
                        | par_block                                 -> {kind: "par_block",                        body: $1}
                        | procedural_timing_control_statement       -> {kind: "procedural_timing_control",        body: $1}
                        | seq_block                                 -> {kind: "seq_block",                        body: $1}
                        | wait_statement                            -> {kind: "wait",                             body: $1}
                        | procedural_assertion_statement            -> {kind: "procedural_assertion",             body: $1}
                        | clocking_drive semi                       -> {kind: "clocking_drive",                   body: $1}
                        | randsequence_statement                    -> {kind: "randsequence",                     body: $1}
                        | randcase_statement                        -> {kind: "randcase",                         body: $1}
                        | expect_property_statement                 -> {kind: "expect_property",                  body: $1}

statement_item := statement_item_sv_2017 -> {kind: "sv_2017", body: $1}
                | statement_item_sv_2023 -> {kind: "sv_2023", body: $1}

statement_or_null := statement                                -> {kind: "statement", body: $1}
                   | @probe_sample: ";" attribute_instance* semi -> {kind: "null",      attributes: $1}

stream_concatenation := lbrace stream_expression ( comma stream_expression )* rbrace
                     -> {body: [$2, $3::2*]}

stream_expression := expression ( kw_with_8fcd25a3 lbrack array_range_expression rbrack )?
                  -> {expr: $1, with_clause: $2}

stream_operator := shift_right -> {kind: "shift_right"}
                 | shift_left  -> {kind: "shift_left"}

streaming_concatenation := lbrace stream_operator ( slice_size &lbrace )? stream_concatenation rbrace
                        -> {op: $2, slice_size: $3, body: $4}

# IEEE 1800-2017 A.8.6 `strength0 ::= supply0 | strong0 | pull0 | weak0` /
# `strength1 ::= supply1 | strong1 | pull1 | weak1`. Every strength keyword is
# digit-suffixed; the earlier bare tokens (`/supply\b/`, `/strong\b/`, `/pull\b/`,
# `/weak\b/`) could NOT match them (no `\b` between a letter and a trailing digit),
# so `drive_strength`/`net_strength`/`pull*_strength` were entirely DEAD
# (SV-CORPUS-GRAD.3.7 — same word-boundary class as `unique0`/`|->`). The bare
# `kw_strong`/`kw_weak` are RETAINED for the SVA `strong(seq)`/`weak(seq)` operators.
# `strength0`/`strength1` are kept as SEPARATE rules (not one permissive `strength`)
# so the LRM's opposite-digit pairing constraint is enforced at parse time — e.g.
# `(strong1, strong1)` correctly rejects.
strength0 := kw_supply0 -> {kind: "supply0"}
           | kw_strong0 -> {kind: "strong0"}
           | kw_pull0   -> {kind: "pull0"}
           | kw_weak0   -> {kind: "weak0"}

strength1 := kw_supply1 -> {kind: "supply1"}
           | kw_strong1 -> {kind: "strong1"}
           | kw_pull1   -> {kind: "pull1"}
           | kw_weak1   -> {kind: "weak1"}

// @profiles: ["sv_2023"]
// string_escape_seq_sv_2023 := kw_any_ASCII_character_c02c60ae | kw_one_to_three_digit_octal_number_29d40f0b | kw_x_fc9847dc kw_one_to_two_digit_hex_number_d97efd5a

// string_escape_seq := string_escape_seq_sv_2023

@profiles: ["sv_2017"]
struct_union_sv_2017 := kw_struct_d118e5a3                        -> {kind: "struct"}
                      | kw_union_67ad5a07 ( kw_tagged_8e1ec218 )? -> {kind: "union", tagged: $2}

@profiles: ["sv_2023"]
struct_union_sv_2023 := kw_struct_d118e5a3                       -> {kind: "struct"}
                      | kw_union_67ad5a07 ( union_modifier )?    -> {kind: "union", modifier: $2}

union_modifier := kw_soft_eb74f2cb   -> {kind: "soft"}
                | kw_tagged_8e1ec218 -> {kind: "tagged"}

@profiles: ["sv_2017", "sv_2023"]
struct_union := struct_union_sv_2017 -> {kind: "sv_2017", body: $1}
              | struct_union_sv_2023 -> {kind: "sv_2023", body: $1}

struct_union_member := attribute_instance* ( random_qualifier )? data_type_or_void list_of_variable_decl_assignments semi
                    -> {attributes: $1, random_qualifier: $2, data_type: $3, decls: $4}

structure_pattern_key := member_identifier      -> {kind: "member",  body: $1}
                       | assignment_pattern_key -> {kind: "pattern", body: $1}

# SV-0029 wave-3 (SV-DOLLAR-LRM-FIDELITY.4): the dedicated `$root.`-anchored TF-call
# carrier. HISTORY: it was born as a workaround — under the engine's (since-fixed)
# branch-predicate FLATTENING bug, `scoped_or_hierarchical_tf_identifier`'s branch-2
# typedef-exclusion predicate was broadcast to every branch and its `$scope.name.body`
# ref hard-rejected the hierarchical branch (trace-proven: `🚫 Branch 3/3 … rejected
# by branch predicate` on `$root.top.f`). BRANCH-PREDICATE-LOCALITY.2 (2026-07-06)
# fixed the engine to the published branch-LOCAL contract and RETIRED that rule's
# hierarchical branch outright (see the comment there), so this lane is now the
# deliberate, sole `$root.` TF-call carrier — no longer a workaround. The
# `!( identifier )` guard remains the no-re-route firewall: only `$root`-headed
# targets can enter, so every identifier-headed TF call keeps its existing route
# byte-identically ($N slots: the guard occupies $1 — codegen-proven — so payload
# fields start at $2).
@profiles: ["sv_2017", "sv_2023"]
rooted_tf_call_sv_only := !( identifier ) hierarchical_tf_identifier attribute_instance* ( lparen list_of_arguments rparen )?
                       -> {kind: "rooted_tf", target: $2, attributes: $3, args: $4}

@branch_policy: priority_first
subroutine_call := class_scoped_tf_call                            -> {kind: "class_scoped_tf", body: $1}
                 | rooted_tf_call_sv_only
                 | tf_call                                          -> {kind: "tf",             body: $1}
                 | system_tf_call                                   -> {kind: "system_tf",      body: $1}
                 | method_call                                      -> {kind: "method",         body: $1}
                 | ( kw_std_55ec981f scope_resolution )? randomize_call
                                                                    -> {kind: "randomize",      std_scope: $1, body: $2}

# VERILOG-2005-PROFILE.6.8 (SV-0032): the `void'(…)` cast is IEEE 1800 only — lifted into a
# profile-gated named rule so it rejects under `verilog_2005` while the sv_2017/sv_2023 AST
# stays byte-identical (bare pass-through reference).
@profiles: ["sv_2017", "sv_2023"]
void_cast_statement_sv_only := kw_void_e9cede9b tick lparen function_subroutine_call rparen semi
                                  -> {kind: "void_cast", body: $4}

subroutine_call_statement := subroutine_call semi
                                  -> {kind: "call",      body: $1}
                           | void_cast_statement_sv_only

sv_dollar_fullskew_timing_check := kw_sv_dollar_fullskew_1e1514b3 lparen reference_event comma data_event comma timing_check_limit comma timing_check_limit ( comma ( notifier )? ( comma ( event_based_flag )? ( comma ( remain_active_flag )? )? )? )? rparen semi
                                -> {reference_event: $3, data_event: $5, limit_setup: $7, limit_hold: $9, tail: $10}

sv_dollar_hold_timing_check := kw_sv_dollar_hold_0cf8df90 lparen reference_event comma data_event comma timing_check_limit ( comma ( notifier )? )? rparen semi
                            -> {reference_event: $3, data_event: $5, limit: $7, tail: $8}

sv_dollar_nochange_timing_check := kw_sv_dollar_nochange_872771bf lparen reference_event comma data_event comma start_edge_offset comma end_edge_offset ( comma ( notifier )? )? rparen semi
                                -> {reference_event: $3, data_event: $5, start_edge_offset: $7, end_edge_offset: $9, tail: $10}

sv_dollar_period_timing_check := kw_sv_dollar_period_87a9c33e lparen controlled_reference_event comma timing_check_limit ( comma ( notifier )? )? rparen semi
                              -> {controlled_reference_event: $3, limit: $5, tail: $6}

sv_dollar_recovery_timing_check := kw_sv_dollar_recovery_585fc30a lparen reference_event comma data_event comma timing_check_limit ( comma ( notifier )? )? rparen semi
                                -> {reference_event: $3, data_event: $5, limit: $7, tail: $8}

sv_dollar_recrem_timing_check := kw_sv_dollar_recrem_fc40cd26 lparen reference_event comma data_event comma timing_check_limit comma timing_check_limit ( comma ( notifier )? ( comma ( timestamp_condition )? ( comma ( timecheck_condition )? ( comma ( delayed_reference )? ( comma ( delayed_data )? )? )? )? )? )? rparen semi
                              -> {reference_event: $3, data_event: $5, limit_recov: $7, limit_rem: $9, tail: $10}

sv_dollar_removal_timing_check := kw_sv_dollar_removal_7a979d46 lparen reference_event comma data_event comma timing_check_limit ( comma ( notifier )? )? rparen semi
                               -> {reference_event: $3, data_event: $5, limit: $7, tail: $8}

sv_dollar_setup_timing_check := kw_sv_dollar_setup_b58bdaae lparen data_event comma reference_event comma timing_check_limit ( comma ( notifier )? )? rparen semi
                             -> {data_event: $3, reference_event: $5, limit: $7, tail: $8}

sv_dollar_setuphold_timing_check := kw_sv_dollar_setuphold_25a075ac lparen reference_event comma data_event comma timing_check_limit comma timing_check_limit ( comma ( notifier )? ( comma ( timestamp_condition )? ( comma ( timecheck_condition )? ( comma ( delayed_reference )? ( comma ( delayed_data )? )? )? )? )? )? rparen semi
                                 -> {reference_event: $3, data_event: $5, limit_setup: $7, limit_hold: $9, tail: $10}

sv_dollar_skew_timing_check := kw_sv_dollar_skew_1ae5c1e4 lparen reference_event comma data_event comma timing_check_limit ( comma ( notifier )? )? rparen semi
                            -> {reference_event: $3, data_event: $5, limit: $7, tail: $8}

sv_dollar_timeskew_timing_check := kw_sv_dollar_timeskew_6d763f0a lparen reference_event comma data_event comma timing_check_limit ( comma ( notifier )? ( comma ( event_based_flag )? ( comma ( remain_active_flag )? )? )? )? rparen semi
                                -> {reference_event: $3, data_event: $5, limit: $7, tail: $8}

sv_dollar_width_timing_check := kw_sv_dollar_width_72b04d27 lparen controlled_reference_event comma timing_check_limit comma threshold ( comma ( notifier )? )? rparen semi
                             -> {controlled_reference_event: $3, limit: $5, threshold: $7, tail: $8}

# SV-0029 wave-3 steal guard (SV-DOLLAR-LRM-FIDELITY.4): the generic
# `system_tf_identifier` regex also matches the LRM anchors `$root` / `$unit` as
# whole tokens, and this optional-parens alternative SUCCEEDS on the bare
# identifier — a PEG commit that permanently steals `$root.…` hierarchical names
# and `$unit::…` scopes from their anchored rules (an outer failure never
# re-enters the choice). The two inline negative lookaheads withdraw ONLY the
# anchor-followed-by-its-tail spellings (`$root.` / `$unit::`); `$root(…)`,
# `$unit`, and every ordinary `$name` stay on this generic route. The
# parens-mandatory alternatives below need no guard — they fail naturally on
# `.`/`::` tails without committing. NOTE the $N renumber: a lookahead OCCUPIES
# a positional slot (codegen-proven — it pushes an empty element), so the two
# guards are $1/$2 and the payload starts at $3.
# SV-CORPUS-GRAD.13c.2s (third alternative): the `!at_sign` guard is what lets the clocking-event
# group fire AT ALL. IEEE 1800-2017 A.8.2 writes `system_tf_identifier ( expression
# { , [ expression ] } [ , [ clocking_event ] ] )`. Spelled with a bare `( comma ( expression )? )*`
# the star is GREEDY and its body is NULLABLE after the comma: on `$rose(a, @(posedge clk))` it ate
# the comma, its inner `( expression )?` matched EMPTY (a clocking event is not an expression —
# measured, not assumed: `$rose(@x)` REJECTS, so `expression` cannot start with `@` at a position
# that demands one), and the trailing `( comma ( clocking_event )? )?` then needed a comma and saw
# `@`. `rparen` was required against `@` and the alternative failed.
# ⭐ Same starving-star mechanism as `n_output_gate_instance` (`.13c.2r`) with a DIFFERENT severity:
# there the starved element was MANDATORY so the rule matched nothing; here it is OPTIONAL so the
# rule matched everything EXCEPT the clocking-event form.
# ⭐ Three spellings were built and measured behaviourally IDENTICAL over all 155 pinned reproducer
# checks and 12 targeted probes (`docs/tasks/artifacts/sv_corpus_grad/systf_clocking_event/`):
# `!( clocking_event )` before the optional expression, this one-token `!at_sign`, and `!at_sign` at
# the END of the group body (the `.13c.2r` placement). This one is chosen because `at_sign` is the
# unique first token of BOTH `clocking_event` alternatives, so it is a sound necessary condition,
# and it refuses BEFORE attempting the expression rather than after.
# ⛔ THE COMMENT LIVES HERE, ABOVE THE RULE, DELIBERATELY. Placed between two alternatives at column
# 0 it ENDS the rule and silently discards every alternative after it — which is exactly what
# happened while writing this fix: `--lint-grammar` reported 1610 rules and every counter zero,
# unchanged, while `$rose(a, @(posedge clk))` went back to REJECT.
# [[a-column-0-comment-inside-a-rule-body-deletes-the-following-alternatives]]
system_tf_call := !( kw_sv_dollar_root_f65f0e67 dot ) !( kw_sv_dollar_unit_1d99223f scope_resolution ) system_tf_identifier ( lparen list_of_arguments rparen )?
                       -> {kind: "args",        name: $3, args: $4}
                | system_tf_identifier lparen data_type ( comma expression )? rparen
                       -> {kind: "data_type",   name: $1, data_type: $3, expr: $4}
                | system_tf_identifier lparen expression ( comma !at_sign ( expression )? )* ( comma ( clocking_event )? )? rparen
                       -> {kind: "expr_clocking", name: $1, first_expr: $3, rest_exprs: $4, clocking: $5}

system_timing_check := sv_dollar_setup_timing_check        -> {kind: "setup",      body: $1}
                     | sv_dollar_hold_timing_check         -> {kind: "hold",       body: $1}
                     | sv_dollar_setuphold_timing_check    -> {kind: "setuphold",  body: $1}
                     | sv_dollar_recovery_timing_check     -> {kind: "recovery",   body: $1}
                     | sv_dollar_removal_timing_check      -> {kind: "removal",    body: $1}
                     | sv_dollar_recrem_timing_check       -> {kind: "recrem",     body: $1}
                     | sv_dollar_skew_timing_check         -> {kind: "skew",       body: $1}
                     | sv_dollar_timeskew_timing_check     -> {kind: "timeskew",   body: $1}
                     | sv_dollar_fullskew_timing_check     -> {kind: "fullskew",   body: $1}
                     | sv_dollar_period_timing_check       -> {kind: "period",     body: $1}
                     | sv_dollar_width_timing_check        -> {kind: "width",      body: $1}
                     | sv_dollar_nochange_timing_check     -> {kind: "nochange",   body: $1}

t01_path_delay_expression := path_delay_expression
                          -> {body: $1}

t0x_path_delay_expression := path_delay_expression
                          -> {body: $1}

t0z_path_delay_expression := path_delay_expression
                          -> {body: $1}

t10_path_delay_expression := path_delay_expression
                          -> {body: $1}

t1x_path_delay_expression := path_delay_expression
                          -> {body: $1}

t1z_path_delay_expression := path_delay_expression
                          -> {body: $1}

t_path_delay_expression := path_delay_expression
                        -> {body: $1}

@profiles: ["sv_2017"]
tagged_union_expression_sv_2017 := kw_tagged_8e1ec218 member_identifier ( expression )?
                                -> {name: $2, value: $3}

@profiles: ["sv_2023"]
tagged_union_expression_sv_2023 := kw_tagged_8e1ec218 member_identifier ( primary )?
                                -> {name: $2, value: $3}

@profiles: ["sv_2017", "sv_2023"]
tagged_union_expression := tagged_union_expression_sv_2017 -> {kind: "sv_2017", body: $1}
                         | tagged_union_expression_sv_2023 -> {kind: "sv_2023", body: $1}

task_body_declaration := @sample: "t; endtask : t" task_identifier semi tf_item_declaration* statement_or_null* kw_endtask_eb64ab0d ( colon task_identifier )?
                      -> {name: $1, items: $3, statements: $4, end_label: $6}
                       | @sample: "t(); endtask : t" task_identifier lparen ( tf_port_list )? rparen semi block_item_declaration* statement_or_null* kw_endtask_eb64ab0d ( colon task_identifier )?
                       | ( interface_identifier dot | class_scope ) task_identifier semi tf_item_declaration* statement_or_null* kw_endtask_eb64ab0d ( colon task_identifier )?
                       | ( interface_identifier dot | class_scope ) task_identifier lparen ( tf_port_list )? rparen semi block_item_declaration* statement_or_null* kw_endtask_eb64ab0d ( colon task_identifier )?

@profiles: ["sv_2017", "verilog_2005"]
task_declaration_sv_2017 := kw_task_7fbb727d ( lifetime )? task_body_declaration
                         -> {lifetime: $2, body: $3}

@profiles: ["sv_2023"]
task_declaration_sv_2023 := kw_task_7fbb727d ( dynamic_override_specifiers )? ( lifetime )? task_body_declaration
                         -> {dynamic_override: $2, lifetime: $3, body: $4}

task_declaration := task_declaration_sv_2017 -> {kind: "sv_2017", body: $1}
                  | task_declaration_sv_2023 -> {kind: "sv_2023", body: $1}

task_identifier := declaration_identifier

@profiles: ["sv_2017"]
task_prototype_sv_2017 := kw_task_7fbb727d task_identifier ( lparen ( tf_port_list )? rparen )?
                       -> {name: $2, ports: $3}

@profiles: ["sv_2023"]
task_prototype_sv_2023 := kw_task_7fbb727d ( dynamic_override_specifiers )? task_identifier ( lparen ( tf_port_list )? rparen )?
                       -> {dynamic_override: $2, name: $3, ports: $4}

@profiles: ["sv_2017", "sv_2023"]
task_prototype := task_prototype_sv_2017 -> {kind: "sv_2017", body: $1}
                | task_prototype_sv_2023 -> {kind: "sv_2023", body: $1}

terminal_identifier := non_keyword_identifier

plain_tf_call_with_args := tf_identifier attribute_instance* lparen list_of_arguments rparen
                        -> {name: $1, attributes: $2, args: $4}

# BRANCH-PREDICATE-LOCALITY.2: @profiles = the linter's derived minimal fix — the
# sole production references scoped_or_hierarchical_tf_identifier, itself sv-only
# now (see the comment there), so this carrier is honestly v2005-unsatisfiable.
@profiles: ["sv_2017", "sv_2023"]
tf_call_with_args := scoped_or_hierarchical_tf_identifier attribute_instance* lparen list_of_arguments rparen
                  -> {name: $1, attributes: $2, args: $4}

@branch_policy: priority_first
tf_call := plain_tf_call_with_args
                  -> {kind: "plain_with_args",                       body: $1}
        | tf_call_with_args
                  -> {kind: "scoped_or_hierarchical_with_args",      body: $1}
        | scoped_or_hierarchical_tf_identifier attribute_instance*
                  -> {kind: "scoped_or_hierarchical_bare",           name: $1, attributes: $2}
        | tf_identifier attribute_instance*
                  -> {kind: "tf_identifier_bare",                    name: $1, attributes: $2}

tf_identifier := callable_identifier

tf_item_declaration := block_item_declaration -> {kind: "block_item", body: $1}
                     | tf_port_declaration    -> {kind: "tf_port",    body: $1}

tf_port_declaration := attribute_instance* tf_port_direction ( kw_var_e5b4e786 )? data_type_or_implicit list_of_tf_variable_identifiers semi
                    -> {attributes: $1, direction: $2, var_keyword: $3, data_type: $4, items: $5}

@profiles: ["sv_2017"]
tf_port_direction_const_ref_sv_only := kw_const_b42f3f6f kw_ref_69449f99 -> {kind: "const_ref"}

@profiles: ["sv_2017", "verilog_2005"]
tf_port_direction_sv_2017 := port_direction                       -> {kind: "port_direction", body: $1}
                           | tf_port_direction_const_ref_sv_only

@profiles: ["sv_2023"]
tf_port_direction_sv_2023 := port_direction
                                   -> {kind: "port_direction", body: $1}
                           | ( kw_const_b42f3f6f )? kw_ref_69449f99 ( kw_static_a381562a )?
                                   -> {kind: "ref",            const_keyword: $1, static_keyword: $3}

tf_port_direction := tf_port_direction_sv_2017 -> {kind: "sv_2017", body: $1}
                   | tf_port_direction_sv_2023 -> {kind: "sv_2023", body: $1}

tf_port_item := attribute_instance* ( tf_port_direction )? ( kw_var_e5b4e786 )? data_type_or_implicit ( port_identifier variable_dimension* ( assign expression )? )?
             -> {attributes: $1, direction: $2, var_keyword: $3, data_type: $4, port_spec: $5}

tf_port_list := tf_port_item ( comma tf_port_item )*
             -> [$1, $2::2*]

tfall_path_delay_expression := path_delay_expression
                            -> {body: $1}

threshold := constant_expression
          -> {body: $1}

time_unit := kw_s_a0f1490a   -> {kind: "s"}
           | kw_ms_26cc3217  -> {kind: "ms"}
           | kw_us_da2b1288  -> {kind: "us"}
           | kw_ns_7320d5b7  -> {kind: "ns"}
           | kw_ps_c67f1ee1  -> {kind: "ps"}
           | kw_fs_3f4bb586  -> {kind: "fs"}

timecheck_condition := mintypmax_expression
                    -> {body: $1}

timestamp_condition := mintypmax_expression
                    -> {body: $1}

@profiles: ["sv_2017", "sv_2023"]
timeunits_declaration := kw_timeunit_57f78b2f time_literal ( timeunit_separator_slash time_literal )? semi
                                -> {kind: "timeunit",                        unit: $2, precision: $3}
                       | kw_timeprecision_628f1cfc time_literal semi
                                -> {kind: "timeprecision",                   precision: $2}
                       | kw_timeunit_57f78b2f time_literal semi kw_timeprecision_628f1cfc time_literal semi
                                -> {kind: "timeunit_then_precision",         unit: $2, precision: $5}
                       | kw_timeprecision_628f1cfc time_literal semi kw_timeunit_57f78b2f time_literal semi
                                -> {kind: "timeprecision_then_unit",         precision: $2, unit: $5}

timeunit_separator_slash := timeunit_separator_trivia "/"
                         -> {kind: "slash"}

timeunit_separator_trivia := /(?:[ \t\r\n]+|\/\/[^\n]*(\n|$)|\/\*([^*]|\*+[^*\/])*\*+\/)*/

timing_check_condition := scalar_timing_check_condition           -> {kind: "scalar", body: $1}
                        | lparen scalar_timing_check_condition rparen -> {kind: "paren",  body: $2}

timing_check_event := ( timing_check_event_control )? specify_terminal_descriptor ( logical_and3 timing_check_condition )?
                   -> {control: $1, descriptor: $2, condition: $3}

timing_check_event_control := kw_posedge_7529558b   -> {kind: "posedge"}
                            | kw_negedge_c77fbc5c   -> {kind: "negedge"}
                            | kw_edge_a0f2c69a      -> {kind: "edge"}
                            | edge_control_specifier -> {kind: "edge_control", body: $1}

timing_check_limit := expression
                   -> {body: $1}

topmodule_identifier := declaration_identifier

@profiles: ["sv_2017", "sv_2023"]
trans_item := covergroup_range_list
           -> {body: $1}

@profiles: ["sv_2017", "sv_2023"]
trans_list := lparen trans_set rparen ( comma lparen trans_set rparen )*
           -> [$2, $4::3*]

// IEEE 1800-2017/2023 A.2.11: the trans-repeat forms are BRACKETED — `[* repeat_range]` (consecutive),
// `[-> repeat_range]` (goto), `[= repeat_range]` (nonconsecutive). SV-COVERGROUP-FIDELITY.1 restored the
// LRM brackets (was bare `( star repeat_range )?` etc., which a greedy `expression` in `trans_item`
// shadowed: it parsed `a*b` as one multiplication, REJECTING valid `(1[*2])` and never witnessing
// `repeat_range`). The brackets make the operator unambiguous, so `(1*2)` is a `simple` multiply item.
@profiles: ["sv_2017", "sv_2023"]
trans_range_list := trans_item                                       -> {kind: "simple",  body: $1}
                  | trans_item lbrack star repeat_range rbrack        -> {kind: "star",    body: $1, range: $4}
                  | trans_item lbrack implies repeat_range rbrack     -> {kind: "implies", body: $1, range: $4}
                  | trans_item lbrack assign repeat_range rbrack      -> {kind: "assign",  body: $1, range: $4}

@profiles: ["sv_2017", "sv_2023"]
trans_set := trans_range_list ( sequence_implies trans_range_list )*
          -> [$1, $2::2*]

// @profiles: ["sv_2023"]
// triple_quoted_string_sv_2023 := lit_token_dd29ecf5 lit_triple_quoted_string_item_string_escape_seq_4a340947 lit_token_dd29ecf5

// triple_quoted_string := triple_quoted_string_sv_2023

// @profiles: ["sv_2023"]
// triple_quoted_string_item_sv_2023 := kw_any_ASCII_character_7f8302bd kw_except_672fccd7 kw_token_08534f33

// triple_quoted_string_item := triple_quoted_string_item_sv_2023

trise_path_delay_expression := path_delay_expression
                            -> {body: $1}

tx0_path_delay_expression := path_delay_expression
                          -> {body: $1}

tx1_path_delay_expression := path_delay_expression
                          -> {body: $1}

txz_path_delay_expression := path_delay_expression
                          -> {body: $1}

@profiles: ["sv_2017"]
type_assignment_sv_2017 := !kw_type_d0a3e7f8 declared_type_parameter_identifier ( assign data_type )?
                        -> {name: $1, value: $2}

@profiles: ["sv_2023"]
type_assignment_sv_2023 := !kw_type_d0a3e7f8 declared_type_parameter_identifier ( assign data_type_or_incomplete_class_scoped_type )?
                        -> {name: $1, value: $2}

@profiles: ["sv_2017", "sv_2023"]
type_assignment := type_assignment_sv_2017 -> {kind: "sv_2017", body: $1}
                 | type_assignment_sv_2023 -> {kind: "sv_2023", body: $1}

@emit_fact: { kind: type_name, name: $body, declaration_family: type_parameter }
@predicate: { name: has_fact, args: [type_name, $body], phase: post }
declared_type_parameter_identifier := type_identifier -> { body: $1.body }

@emit_fact: { kind: type_name, name: $body, declaration_family: typedef }
@predicate: { name: has_fact, args: [type_name, $body], phase: post }
declared_type_identifier := type_identifier -> { body: $1.body }

@emit_fact: { kind: type_name, name: $body, declaration_family: typedef }
@emit_fact: { kind: type_name, name: $body, declaration_family: class }
@predicate: { name: has_fact, args: [type_name, $body], phase: post }
declared_class_alias_identifier := type_identifier -> { body: $1.body }

@emit_fact: { kind: type_name, name: $body, declaration_family: class }
@predicate: { name: has_fact, args: [type_name, $body], phase: post }
declared_forward_class_identifier := type_identifier -> { body: $1.body }

@emit_fact: { kind: type_name, name: $body, declaration_family: interface_class }
@predicate: { name: has_fact, args: [type_name, $body], phase: post }
declared_forward_interface_class_identifier := type_identifier -> { body: $1.body }

# SV-EXH-PROOF.3.3.4.b.6.2.14 — `@branch_policy: priority_first` on the
# 6-branch type_declaration_sv_2017 alternation. Pre-fix: default
# longest_match caused catastrophic backtracking on
# `typedef uvm_object_string_pool #(uvm_barrier) uvm_barrier_pool ;`
# (uvm_pkg line 11755) — the parse explored exponentially many class_type
# / data_type / interface_instance_identifier interpretations + their
# sub-rule alternatives, hung past 90s before reporting failure (the
# bisection's "first FAIL cut_idx=1736" reported TIMEOUT, not a fast
# rejection). Branches start with the same `kw_typedef` prefix and
# diverge into similar-shaped class_type/data_type/interface forms — a
# pathological longest_match scenario.
#
# priority_first picks the FIRST matching branch (in declaration order):
#   class_type form (1) → data_type form (2) → interface form (3) →
#   forward_class form (4) → forward_interface_class form (5) →
#   forward enum/struct/union form (6).
# This ordering is semantically correct (a class_type match is always
# more specific than a data_type match; declarative classes precede
# forward declarations). Parser-AGNOSTIC level 0.
@branch_policy: priority_first
@profiles: ["sv_2017"]
type_declaration_sv_2017 := kw_typedef_6dc2082b class_type declared_class_alias_identifier variable_dimension* semi
                                    -> {kind: "class_alias",    class_type: $2, name: $3, dims: $4}
                          | kw_typedef_6dc2082b data_type declared_type_identifier variable_dimension* semi
                                    -> {kind: "data_type",      data_type: $2, name: $3, dims: $4}
                          | kw_typedef_6dc2082b interface_instance_identifier constant_bit_select dot type_identifier declared_type_identifier semi
                                    -> {kind: "interface_type", instance: $2, select: $3, source_type: $5, name: $6}
                          | kw_typedef_6dc2082b kw_class_8d767bf5 declared_forward_class_identifier semi
                                    -> {kind: "forward_class",  name: $3}
                          | kw_typedef_6dc2082b kw_interface_5ea2d81a kw_class_8d767bf5 declared_forward_interface_class_identifier semi
                                    -> {kind: "forward_interface_class", name: $4}
                          | kw_typedef_6dc2082b forward_type_keyword? declared_type_identifier semi
                                    -> {kind: "forward",        keyword: $2, name: $3}

# SV-EXH-PROOF.3.3.4.b.6.2.14 — same as sv_2017 above (parallel structure).
@branch_policy: priority_first
@profiles: ["sv_2023"]
type_declaration_sv_2023 := kw_typedef_6dc2082b class_type declared_class_alias_identifier variable_dimension* semi
                                    -> {kind: "class_alias",    class_type: $2, name: $3, dims: $4}
                          | kw_typedef_6dc2082b data_type_or_incomplete_class_scoped_type declared_type_identifier variable_dimension* semi
                                    -> {kind: "data_type",      data_type: $2, name: $3, dims: $4}
                          | kw_typedef_6dc2082b interface_port_identifier constant_bit_select dot type_identifier declared_type_identifier semi
                                    -> {kind: "interface_type", port: $2, select: $3, source_type: $5, name: $6}
                          | kw_typedef_6dc2082b kw_class_8d767bf5 declared_forward_class_identifier semi
                                    -> {kind: "forward_class",  name: $3}
                          | kw_typedef_6dc2082b kw_interface_5ea2d81a kw_class_8d767bf5 declared_forward_interface_class_identifier semi
                                    -> {kind: "forward_interface_class", name: $4}
                          | kw_typedef_6dc2082b forward_type_keyword? declared_type_identifier semi
                                    -> {kind: "forward",        keyword: $2, name: $3}

# SV-AST-SHAPE-FIDELITY.2.1 — shared named-lift of the forward-typedef keyword
# group so the bare `keyword: $2` in both profile `type_declaration` br6 rules
# binds a clean named rule instead of an inline alternation (which corrupted the
# positional model → `<invalid_sequence_access>`). Un-annotated (each branch is a
# single keyword atom → implicit `-> $1`); all-profiles by default. The `.1`
# `ansi_port_header` named-lift precedent.
forward_type_keyword := kw_enum_e338e8e3 | kw_struct_d118e5a3 | kw_union_67ad5a07

# SV-EXH-PROOF.3.3.4.b.6.2.14 — priority_first on the sv_2017|sv_2023
# outer alternation (mirrors the inner-branch fix). Each profile-specific
# rule has 6 branches; default longest_match runs all 12 = pathological
# under uvm's heavily-nested-parameterized-class typedefs.
@branch_policy: priority_first
@profiles: ["sv_2017", "sv_2023"]
type_declaration := type_declaration_sv_2017 -> {kind: "sv_2017", body: $1}
                  | type_declaration_sv_2023 -> {kind: "sv_2023", body: $1}

type_identifier := declaration_identifier

# SV-EXH-PROOF.3.3.3 (grammar half of the composite fix): proven
# declared-id idiom (mirrors declared_class_identifier / .3.3.2
# declared_package_identifier). A use-site has_fact predicate must
# reference a resolvable bare field ($body) on a dedicated rule whose
# -> {body:$1.body} exposes the scalar; a sub-rule-name ref on a rule
# that has a -> does not resolve, and dotted predicate args are
# rejected by the @predicate compiler. The engine exception-safety
# fix makes the typedef-emitted fact survive so this resolves true.
@predicate: { name: has_fact, args: [type_name, $body], phase: post }
checked_type_identifier := type_identifier -> { body: $1.body }

@profiles: ["sv_2023"]
type_identifier_or_class_type_sv_2023 := type_identifier -> {kind: "type_identifier", body: $1}
                                       | class_type      -> {kind: "class_type",      body: $1}

@profiles: ["sv_2023"]
type_identifier_or_class_type := type_identifier_or_class_type_sv_2023
                              -> {body: $1}

@profiles: ["sv_2023"]
type_parameter_declaration_sv_2023 := kw_type_d0a3e7f8 ( forward_type )? list_of_type_assignments
                                   -> {forward_type: $2, items: $3}

@profiles: ["sv_2023"]
type_parameter_declaration := type_parameter_declaration_sv_2023
                           -> {body: $1}

@profiles: ["sv_2017"]
type_reference_sv_2017 := kw_type_d0a3e7f8 lparen expression rparen -> {kind: "expression", body: $3}
                        | kw_type_d0a3e7f8 lparen data_type rparen  -> {kind: "data_type",  body: $3}

@profiles: ["sv_2023"]
type_reference_sv_2023 := kw_type_d0a3e7f8 lparen expression rparen
                               -> {kind: "expression",                   body: $3}
                        | kw_type_d0a3e7f8 lparen data_type_or_incomplete_class_scoped_type rparen
                               -> {kind: "data_type_or_incomplete_class", body: $3}

@profiles: ["sv_2017", "sv_2023"]
type_reference := type_reference_sv_2017 -> {kind: "sv_2017", body: $1}
                | type_reference_sv_2023 -> {kind: "sv_2023", body: $1}

tz0_path_delay_expression := path_delay_expression
                          -> {body: $1}

tz1_path_delay_expression := path_delay_expression
                          -> {body: $1}

tz_path_delay_expression := path_delay_expression
                         -> {body: $1}

tzx_path_delay_expression := path_delay_expression
                          -> {body: $1}

udp_ansi_declaration := attribute_instance* kw_primitive_9756bf34 udp_identifier lparen udp_declaration_port_list rparen semi
                     -> {attributes: $1, name: $3, ports: $5}

udp_body := combinational_body -> {kind: "combinational", body: $1}
         | sequential_body    -> {kind: "sequential",    body: $1}

@profiles: ["sv_2017", "verilog_2005"]
udp_declaration_sv_2017 := udp_nonansi_declaration udp_port_declaration udp_port_declaration* udp_body kw_endprimitive_f53f53d4 ( colon udp_identifier )?
                            -> {kind: "nonansi", header: $1, port_decls: {first: $2, rest: $3}, body: $4, end_label: $6}
                         | udp_ansi_declaration udp_body kw_endprimitive_f53f53d4 ( colon udp_identifier )?
                            -> {kind: "ansi", header: $1, body: $2, end_label: $4}
                         | kw_extern_bf1ee311 udp_nonansi_declaration
                            -> {kind: "extern_nonansi", header: $2}
                         | kw_extern_bf1ee311 udp_ansi_declaration
                            -> {kind: "extern_ansi", header: $2}
                         | attribute_instance* kw_primitive_9756bf34 udp_identifier lparen dot_star rparen semi udp_port_declaration* udp_body kw_endprimitive_f53f53d4 ( colon udp_identifier )?
                            -> {kind: "wildcard", attributes: $1, name: $3, port_decls: $8, body: $9, end_label: $11}

@profiles: ["sv_2023"]
udp_declaration_sv_2023 := udp_nonansi_declaration udp_port_declaration udp_port_declaration* udp_body kw_endprimitive_f53f53d4 ( colon udp_identifier )?
                            -> {kind: "nonansi", header: $1, port_decls: {first: $2, rest: $3}, body: $4, end_label: $6}
                         | udp_ansi_declaration udp_body kw_endprimitive_f53f53d4 ( colon udp_identifier )?
                            -> {kind: "ansi", header: $1, body: $2, end_label: $4}
                         | kw_extern_bf1ee311 udp_nonansi_declaration
                            -> {kind: "extern_nonansi", header: $2}
                         | kw_extern_bf1ee311 udp_ansi_declaration
                            -> {kind: "extern_ansi", header: $2}
                         | attribute_instance* kw_primitive_9756bf34 udp_identifier lparen dot star rparen semi udp_port_declaration* udp_body kw_endprimitive_f53f53d4 ( colon udp_identifier )?
                            -> {kind: "wildcard", attributes: $1, name: $3, port_decls: $9, body: $10, end_label: $12}

udp_declaration := udp_declaration_sv_2017 -> {kind: "sv_2017", body: $1}
                 | udp_declaration_sv_2023 -> {kind: "sv_2023", body: $1}

@sample: "output o, input i"
udp_declaration_port_list := udp_output_declaration comma udp_input_declaration ( comma udp_input_declaration )*
                          -> {output: $1, inputs: [$3, $4::2*]}

udp_identifier := non_keyword_identifier

udp_initial_statement := kw_initial_8ad7d21c output_port_identifier assign init_val semi
                      -> {name: $2, init_val: $4}

udp_input_declaration := attribute_instance* kw_input_140f86aa list_of_udp_port_identifiers
                      -> {attributes: $1, identifiers: $3}

udp_instance := ( name_of_instance )? lparen output_terminal comma input_terminal ( comma input_terminal )* rparen
             -> {name: $1, output: $3, inputs: [$5, $6::2*]}

udp_instantiation := udp_identifier ( drive_strength )? ( delay )? udp_instance ( comma udp_instance )* semi
                  -> {name: $1, drive_strength: $2, delay: $3, instances: [$4, $5::2*]}

udp_nonansi_declaration := attribute_instance* kw_primitive_9756bf34 udp_identifier lparen udp_port_list rparen semi
                        -> {attributes: $1, name: $3, ports: $5}

udp_output_declaration := attribute_instance* kw_output_1029d676 port_identifier
                            -> {kind: "wire", attributes: $1, name: $3}
                       | attribute_instance* kw_output_1029d676 kw_reg_e06b9586 port_identifier ( assign constant_expression )?
                            -> {kind: "reg", attributes: $1, name: $4, default: $5}

udp_port_declaration := udp_output_declaration semi -> {kind: "output", body: $1}
                      | udp_input_declaration semi  -> {kind: "input",  body: $1}
                      | udp_reg_declaration semi    -> {kind: "reg",    body: $1}

udp_port_list := output_port_identifier comma input_port_identifier ( comma input_port_identifier )*
              -> [$1, $3, $4::2*]

udp_reg_declaration := attribute_instance* kw_reg_e06b9586 variable_identifier
                    -> {attributes: $1, name: $3}

unary_module_path_operator := bang                -> {kind: "bang"}
                            | tilde               -> {kind: "tilde"}
                            | bitwise_and         -> {kind: "bitwise_and"}
                            | reduction_nand      -> {kind: "reduction_nand"}
                            | bitwise_or          -> {kind: "bitwise_or"}
                            | reduction_nor       -> {kind: "reduction_nor"}
                            | bitwise_xor         -> {kind: "bitwise_xor"}
                            | reduction_xnor      -> {kind: "reduction_xnor"}
                            | reduction_xnor_alt  -> {kind: "reduction_xnor_alt"}

unary_operator := plus                  -> {kind: "plus"}
                | minus                 -> {kind: "minus"}
                | bang                  -> {kind: "bang"}
                | tilde                 -> {kind: "tilde"}
                | bitwise_and           -> {kind: "bitwise_and"}
                | reduction_nand        -> {kind: "reduction_nand"}
                | bitwise_or            -> {kind: "bitwise_or"}
                | reduction_nor         -> {kind: "reduction_nor"}
                | bitwise_xor           -> {kind: "bitwise_xor"}
                | reduction_xnor        -> {kind: "reduction_xnor"}
                | reduction_xnor_alt    -> {kind: "reduction_xnor_alt"}

@profiles: ["sv_2017", "sv_2023"]
unique_priority := kw_unique_58037c00   -> {kind: "unique"}
                | kw_priority_3345867e -> {kind: "priority"}
                | kw_unique0           -> {kind: "unique0"}

@profiles: ["sv_2017"]
uniqueness_constraint_sv_2017 := kw_unique_58037c00 open_range_list*
                              -> {ranges: $2}

@profiles: ["sv_2023"]
uniqueness_constraint_sv_2023 := kw_unique_58037c00 range_list*
                              -> {ranges: $2}

@profiles: ["sv_2017", "sv_2023"]
uniqueness_constraint := uniqueness_constraint_sv_2017 -> {kind: "sv_2017", body: $1}
                       | uniqueness_constraint_sv_2023 -> {kind: "sv_2023", body: $1}

unpacked_dimension := lbrack constant_range rbrack         -> {kind: "range",      body: $2}
                    | lbrack constant_expression rbrack    -> {kind: "expression", body: $2}

# VERILOG-2005-PROFILE.6.9 (SV-0033) — the bare `[]` (unsized) dimension is SystemVerilog-only
# (IEEE 1800 §7.5 dynamic arrays); IEEE 1364-2005 has no unsized dimension anywhere in Annex A
# (every dimension is a ranged `[msb:lsb]` / indexed form). Gating the whole rule prunes the `[]`
# surface out of `verilog_2005` at all three carriers (packed_dimension alt, variable_dimension
# alt, the variable_decl_assignment dynamic-array branch) while the sv_2017/sv_2023 tree — and
# thus their AST — is unchanged. Whole-rule @profiles gate idiom, cf. `uniqueness_constraint`.
@profiles: ["sv_2017", "sv_2023"]
unsized_dimension := lbrack rbrack
                  -> {kind: "unsized"}

# SV-CORPUS-GRAD.3.20 — PARAMETER OVERRIDE IN A CONFIG `use` CLAUSE IS SYSTEMVERILOG-ONLY.
# IEEE 1364-2005 declares exactly ONE use_clause production —
# `use [library_identifier.]cell_identifier[:config]` (Annex A A.1.5 :119, repeated at 13.3 :271) —
# and the string `use #(` does not occur anywhere in the 2005 text. All four override alternatives
# below are IEEE 1800 additions, so they are gated out of `verilog_2005` on the sibling rule
# ([[feedback_sv_strict_lrm_compliance_default]]: over-acceptance is a defect, not a tolerance).
# `@profiles` is a RULE-level directive, hence the sibling split rather than a per-alternative gate;
# house pattern: `always_keyword` / `always_keyword_sv_only` (:646).
#
# GRAMMAR-WELLFORMED.G.4.8 — the named_parameter-bearing alternatives MUST precede the simple
# `use [lib.]cell [: config]` form, else PEG ordered choice commits the simple alt to `use lib.cell`
# and strands a trailing `.param()` (the cert-coverage witness-parseability residual). ⛔ That
# ordering is preserved by REFERENCING THE SIBLING FIRST in `use_clause` below — moving the
# alternatives into their own rule does not relax the constraint, it relocates it. The first
# alternative is the explicit no-lib `use cell .param()` form so it is matched before the simple alt
# can greedily read `cell .param` as `lib.cell`. The `-> {library,name,config}` return annotation stays
# on the simple alt, whose `$N` indices are per-alternative and therefore unchanged by the split.
# LRM §A.1.5: `[lib.]` is optional — this is a PEG specific-before-general reorder, not a semantic change.
@profiles: ["sv_2017", "sv_2023"]
use_clause_param_override_sv_only := @probe_sample: "use top .P(1)" kw_use_04489a12 cell_identifier named_parameter_assignment ( comma named_parameter_assignment )* ( colon kw_config_dfba7aad )?
            | @probe_sample: "use l.top .P(1)" kw_use_04489a12 ( library_identifier dot )? cell_identifier named_parameter_assignment ( comma named_parameter_assignment )* ( colon kw_config_dfba7aad )?
            | @probe_sample: "use .P(1)" kw_use_04489a12 named_parameter_assignment ( comma named_parameter_assignment )* ( colon kw_config_dfba7aad )?
            # SV-CORPUS-GRAD.3.19 — the `#( … )` override spelling. IEEE 1800 CONTRADICTS ITSELF here,
            # identically in 2017 and 2023: Annex A / Syntax 33-4 writes `use named_parameter_assignment
            # { , … }` with no `#`, while clause 33.4.3's own normative examples write
            # `instance top use #(.WIDTH(32));` — 7 times per revision (2017 :365/:366/:382/:383/:412/
            # :423/:462; 2023 :366/:367/:383/:384/:413/:424/:463). Annex A's preamble subordinates itself
            # ("the normative text description contained within the clauses … provide additional details
            # on the syntax"), and the BNF-only reading makes 33.4.3 :333 — "Configurations may not use
            # positional parameter notation" — VACUOUS, since positional notation is not expressible
            # under the brace-less alternatives at all. So the parser accepts the union of both
            # normative surfaces.
            # ⛔ The list is named_parameter_assignment, NOT list_of_parameter_assignments: reusing
            # parameter_value_assignment would admit ordered_parameter_assignment and accept `use #(32)`,
            # which is exactly what :333 forbids. The empty `#()` is first-class (2023 :424).
            # ⛔⛔ THIS COMMENT BLOCK MUST STAY INDENTED. A column-0 `#` line inside a rule body ENDS the
            # rule and silently discards every following alternative — measured here, no error, no lint,
            # no census move (SV-CORPUS-GRAD.3.19 → routed to EBNF-FRONTEND-SILENT-TRUNCATION).
            | @probe_sample: "use #(.P(1))" kw_use_04489a12 hash lparen ( named_parameter_assignment ( comma named_parameter_assignment )* )? rparen ( colon kw_config_dfba7aad )?

use_clause := use_clause_param_override_sv_only
            | @probe_sample: "use top" kw_use_04489a12 ( library_identifier dot )? cell_identifier ( colon kw_config_dfba7aad )?
           -> {library: $2, name: $3, config: $4}

@profiles: ["sv_2017"]
# SV-EXH-PROOF.3.3.4.b.6.2.37.6 — per IEEE 1800 §A.8.3:
#   value_range ::= expression | [ expression : expression ]
# The LRM literally has `[` and `]` around the range form. The prior pgen
# rule was `( expression colon expression )?` — missing the brackets AND
# wrapped in `?` (which made the rule match empty as a fallback, so it
# silently "succeeded" without consuming anything for `[1:5]` and the outer
# rule then choked on the unexpected `[`). Fix: require `lbrack ... rbrack`
# literally; emit `{kind: "range", lo: $2, hi: $4}` (the same `lo`/`hi`
# convention used by `constant_range_expression` line 538).
# Surfaced by `.37.5`'s 1,121,290 furthest reaching uvm_phase::jump's
# `phases.find(item) with (item.get_state() inside {[UVM_PHASE_STARTED:UVM_PHASE_CLEANUP]})`.
value_range_sv_2017 := expression                                       -> {kind: "expression", body: $1}
                     | lbrack expression colon expression rbrack         -> {kind: "range",      lo: $2, hi: $4}

@profiles: ["sv_2023"]
# Same fix for sv_2023 across all 4 bracketed range variants. Per LRM
# 1800-2023 §A.8.3:
#   value_range ::= expression
#                 | [ expression : expression ]
#                 | [ $ : expression ]
#                 | [ expression : $ ]
#                 | [ expression +/- expression ]
value_range_sv_2023 := expression                                                       -> {kind: "expression", body: $1}
                     | lbrack expression colon expression rbrack                         -> {kind: "range",      lo: $2, hi: $4}
                     | lbrack kw_dollar colon expression rbrack                          -> {kind: "dollar_lo",  hi: $4}
                     | lbrack expression colon kw_dollar rbrack                          -> {kind: "dollar_hi",  lo: $2}
                     | lbrack expression plus slash minus expression rbrack              -> {kind: "tolerance",  center: $2, tol: $6}

@profiles: ["sv_2017", "sv_2023"]
value_range := value_range_sv_2017 -> {kind: "sv_2017", body: $1}
             | value_range_sv_2023 -> {kind: "sv_2023", body: $1}

var_data_type := data_type                            -> {kind: "data_type",     body: $1}
              | kw_var_e5b4e786 data_type_or_implicit  -> {kind: "var",          body: $2}

variable_assignment := variable_lvalue assign expression
                    -> {lvalue: $1, value: $3}

# SV-EXH-PROOF.3.3.4.b.6.1.2 — minimal producer: emit a `variable_binding`
# fact recording that this name is a declared variable/data object. This
# decl-site element rule executes once per variable, so `int a, b, c;`
# naturally emits three facts — no fan-out machinery needed. Name-presence
# (`has_fact(variable_binding, …)`) is the context the `.b.6.2` consumer
# uses to disambiguate method-call chains; `type_kind`/`type_ref` are added
# later only if name-presence proves insufficient.
@emit_fact: { kind: variable_binding, name: $name.body }
variable_decl_assignment := variable_identifier !lparen variable_dimension* ( assign expression )?
                                  -> {kind: "variable",      name: $1, dims: $3, init: $4}
                          | dynamic_array_variable_identifier unsized_dimension variable_dimension* ( assign dynamic_array_new )?
                                  -> {kind: "dynamic_array", name: $1, unsized_dim: $2, dims: $3, init: $4}
                          | class_variable_identifier ( assign class_new )?
                                  -> {kind: "class",         name: $1, init: $2}

variable_dimension := unsized_dimension     -> {kind: "unsized",     body: $1}
                    | unpacked_dimension    -> {kind: "unpacked",    body: $1}
                    | associative_dimension -> {kind: "associative", body: $1}
                    | queue_dimension       -> {kind: "queue",       body: $1}

variable_identifier := declaration_identifier

variable_identifier_list := variable_identifier ( comma variable_identifier )*
                         -> [$1, $2::2*]

variable_lvalue := ( variable_lvalue_scope )? hierarchical_variable_identifier select
                        -> {kind: "name",                  scope: $1, name: $2, select: $3}
                 | lbrace variable_lvalue ( comma variable_lvalue )* rbrace
                        -> {kind: "concatenation",         items: [$2, $3::2*]}
                 | ( assignment_pattern_expression_type )? assignment_pattern_variable_lvalue
                        -> {kind: "pattern",               type: $1, body: $2}
                 | streaming_concatenation
                        -> {kind: "streaming_concatenation", body: $1}

variable_lvalue_scope := implicit_class_handle dot   -> {kind: "instance",      handle: $1}
                       | non_typedef_package_scope   -> {kind: "package_scope", body: $1}
                       # SV-EXH-PROOF.3.3.4.b.6.2.37.3 — parallel to the
                       # `primary_hier_scope_prefix` `class_scope` addition;
                       # enables `Class::staticVar = expr;` assignments
                       # (e.g. `super_t::m_typename = tname;` in uvm_callbacks).
                       # Gated by `class_scope`'s `known_unscoped_class_scope_class_identifier`
                       # `fact_attribute_equals(type_name, $body, declaration_family, class)`
                       # predicate — fires only for known class names.
                       | class_scope                 -> {kind: "class_scope",   body: $1}

variable_port_header := ( port_direction )? variable_port_type
                     -> {direction: $1, port_type: $2}

variable_port_type := var_data_type
                   -> {body: $1}

@profiles: ["sv_2017", "sv_2023"]
wait_statement_sv_only := kw_wait_daaad336 kw_fork_3f673f2a semi
                               -> {kind: "wait_fork"}
                        | kw_wait_order_e1b7850a lparen hierarchical_identifier ( comma hierarchical_identifier )* rparen action_block
                               -> {kind: "wait_order", events: [$3, $4::2*], action: $6}

wait_statement := kw_wait_daaad336 lparen expression rparen statement_or_null
                       -> {kind: "wait",       condition: $3, body: $5}
                | wait_statement_sv_only

@profiles: ["sv_2017"]
weight_specification_sv_2017 := integral_number          -> {kind: "number",     body: $1}
                              | ps_identifier            -> {kind: "identifier", body: $1}
                              | lparen expression rparen -> {kind: "expression", body: $2}

@profiles: ["sv_2017"]
weight_specification := weight_specification_sv_2017
                     -> {body: $1}

with_covergroup_expression := covergroup_expression
                           -> {body: $1}

z_or_x := kw_x_11f6ad8e -> {kind: "x"}
       | kw_X_c032adc1  -> {kind: "X"}
       | kw_z_395df8f7  -> {kind: "z"}
       | kw_Z_909f99a7  -> {kind: "Z"}

zero_or_one := kw_n_0_b6589fc6 -> {kind: "0"}
            | kw_n_1_356a192b -> {kind: "1"}

