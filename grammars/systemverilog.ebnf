            | cross_body_sv_2023 -> {kind: "sv_2023", body: $1}

// ⛔ A.2.11 SPELLS THE `;` TWICE AND THE STANDARD'S OWN EXAMPLES SPELL IT ONCE
// (SV-CORPUS-GRAD.13c.2a). IEEE 1800-2017 A.2.11 reads
//     cross_body      ::= { { cross_body_item ; } } | ;
//     cross_body_item ::= function_declaraton | bins_selection_or_option ;
// so a literal transcription demands `ignore_bins x = …;;` — and it DID: `option.weight = 2;;`
// parsed while the single-semicolon form did not. §19.6.2 and §19.6.3 of the same standard write
//     cross a, b { ignore_bins ignore = binsof(a) intersect { 5, [1:3] }; }
// with ONE, as does every row in the vendored corpus. Annex A is the transcription defect and the
// clause examples are the stronger witness ([[annex-a-footnotes-license-derivations-the-productions-cannot-derive]],
// the `.3.25` precedent). ⭐ The `;` is removed HERE rather than from `cross_body_sv_2017` so the
// repair matches the sv_2023 pair below, which already carries it on the item — and so the double
// form STOPS parsing: `cross_body_item` is non-nullable, so `( cross_body_item semi )*` can no
// longer absorb a stray `;`. One edit, a rejects-valid AND an accepts-invalid fix.
// ⛔⛔ AND A.2.11 ALSO MISSPELLS THE NONTERMINAL (`SV-CORPUS-GRAD.13c.2d`/`.13c.2f`). IEEE 1800-2017
// A.2.11 writes `function_declaraton` — corrected to `function_declaration` in 1800-2023 — and the
// LRM→EBNF extraction transcribed the TYPO as a token: this rule used to read
//     cross_body_item_sv_2017 := kw_function_declaraton_06b7ed29 -> {kind: "function_decl"}
// where that terminal is `trivia /function_declaraton\b/`. An alternative that can only fire on
// source literally containing those characters is UNREACHABLE, and §19.6.1's own example — a `cross`
// body declaring a function and using it in a `bins` — was REJECTED under `sv_2017` while `sv_2023`
// accepted it (measured: `furthest_position=65` vs `parse_full passed`).
// ⭐ THE `;` HAD TO MOVE WITH IT, which is why this is not a one-word edit. `cross_body_sv_2017` used
// to read `lbrace ( cross_body_item semi )* rbrace`, demanding a `;` after EVERY item — so merely
// re-pointing the reference would then require `endfunction ;`, which §19.6.1 does not write. The
// repair mirrors the sv_2023 pair below, which already carries the `;` on the
// `bins_selection_or_option` alternative rather than on the loop. Both arms now have the same shape,
// which is the correct outcome: the two editions differ only by the typo, and the typo is the defect.
// ⚠️ The accepts-invalid half of `.13c.2a` is PRESERVED by this shape, not re-opened: `cross_body_item`
// is non-nullable and a bare `;` matches neither alternative, so `option.weight = 2;;` still fails.
@profiles: ["sv_2017"]
cross_body_item_sv_2017 := function_declaration              -> {kind: "function_decl",        body: $1}
                         | bins_selection_or_option semi     -> {kind: "selection_or_option",  body: $1}

@profiles: ["sv_2023"]
cross_body_item_sv_2023 := function_declaration              -> {kind: "function_decl",        body: $1}
                         | bins_selection_or_option semi     -> {kind: "selection_or_option",  body: $1}

@profiles: ["sv_2017", "sv_2023"]
cross_body_item := cross_body_item_sv_2017 -> {kind: "sv_2017", body: $1}
                 | cross_body_item_sv_2023 -> {kind: "sv_2023", body: $1}

cross_identifier := non_keyword_identifier

cross_item := cover_point_identifier -> {kind: "cover_point", name: $1}
            | variable_identifier    -> {kind: "variable",    name: $1}

cross_set_expression := covergroup_expression
                     -> {body: $1}

current_state := level_symbol
              -> {body: $1}

cycle_delay := kw_token_93ac8946 integral_number          -> {kind: "number",     body: $2}
             | kw_token_93ac8946 non_keyword_identifier               -> {kind: "identifier", body: $2}
             | kw_token_93ac8946 lparen expression rparen -> {kind: "expression", body: $3}

cycle_delay_const_range_expression := constant_expression colon constant_expression -> {kind: "range",     lo: $1, hi: $3}
                                    | constant_expression colon kw_dollar             -> {kind: "dollar_hi", lo: $1}

cycle_delay_range := kw_token_93ac8946 constant_primary
                            -> {kind: "primary",      body: $2}
                  | kw_token_93ac8946 lbrack cycle_delay_const_range_expression rbrack
                            -> {kind: "range",        body: $3}
                  | kw_token_93ac8946 lbrack star rbrack
                            -> {kind: "star"}
                  | kw_token_93ac8946 lbrack plus rbrack
                            -> {kind: "plus"}

@profiles: ["sv_2017", "verilog_2005"]
data_declaration_sv_2017 := ( kw_const_b42f3f6f )? ( kw_var_e5b4e786 )? ( lifetime )? data_type_or_implicit list_of_variable_decl_assignments semi
                                -> {kind: "variable_decl",        const_keyword: $1, var_keyword: $2, lifetime: $3, data_type: $4, assignments: $5}
                         | type_declaration
                                -> {kind: "type",                  body: $1}
