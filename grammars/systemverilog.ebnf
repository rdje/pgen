                            | ( sequence_actual_arg )? ( comma !dot ( sequence_actual_arg )? )* ( comma sequence_named_arg )*
                                    -> {kind: "mixed",      head: $1, ordered_tail: [$2::2*], named_tail: [$3::2*]}

