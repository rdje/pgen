# SV-EXH-PROOF.3.3.4.b.6.2.2 — fix the pre-existing $-ref defect that made
# `non_typedef_package_scope` ALWAYS hard-fail. The rule has a `->` shape
# `{body: $1}` where `$1 = package_scope = {kind, name: <package_identifier>}`,
# so the Json-mode resolver looks up `$package_identifier` as a top-level
# field — which does not exist — and the predicate-arg resolution raises
# `ContextualError("could not resolve attribute reference 'package_identifier'")`,
# back-out. uvm just didn't hit `::`-in-expression for the first ~1500 lines
# of `uvm_pkg`; `.b.6.2` got the parser past `uvm_create_random_seed` and
# exposed this. Drill through the shape: $body.name.body
# (body → package_scope's name field → package_identifier's body scalar).
#
@predicate: { name: lacks_fact_attribute_equals, args: [type_name, $body.name.body, declaration_family, typedef], phase: post }
@profiles: ["sv_2017", "sv_2023"]
non_typedef_package_scope := @probe_sample: "pkg::" package_scope
                          -> {body: $1}

let_expression := scoped_let_identifier ( lparen ( let_list_of_arguments )? rparen )?
                          -> {kind: "scoped",     name: $1, args: $2}
                | known_unscoped_let_identifier ( lparen ( let_list_of_arguments )? rparen )?
                          -> {kind: "unscoped",   name: $1, args: $2}

let_formal_type := kw_untyped_d53be1e8    -> {kind: "untyped"}
                 | data_type_or_implicit  -> {kind: "data_type", body: $1}

let_identifier := non_keyword_identifier

@emit_fact: { kind: let_name, name: $body, declaration_family: let }
@predicate: { name: has_fact, args: [let_name, $body], phase: post }
declared_let_identifier := let_identifier -> { body: $1.body }

@predicate: { name: has_fact, args: [let_name, $body], phase: post }
known_unscoped_let_identifier := let_identifier

@profiles: ["sv_2017", "sv_2023"]
scoped_let_identifier := non_typedef_package_scope let_identifier -> {scope: $1, name: $2}

# POST-SV-AUDIT.2.4b Cat-A: factor the named-argument unit into a
# record rule; ordered/named tails become clean extraction-spread lists.
let_named_arg := dot non_keyword_identifier lparen ( let_actual_arg )? rparen -> {name: $2, value: $4}
# SV-CORPUS-GRAD.13c.2s: the `!dot` guard is the SAME starving-star repair as `system_tf_call`,
# in the let family. IEEE 1800-2017 A.2.10 writes `let_list_of_arguments ::=
# [ let_actual_arg ] { , [ let_actual_arg ] } { , . identifier ( [ let_actual_arg ] ) }` —
# ordered arguments, THEN named ones. Spelled with a bare `( comma ( let_actual_arg )? )*` the
# greedy star ate the comma introducing the first NAMED argument, its inner optional matched EMPTY
# (a named argument starts with `.`, and no `let_actual_arg` can — measured: `.b(2)` and `.b` both
# REJECT as `let_actual_arg`, with `a+1` accepting as the control), and the named-argument star
# then needed a comma and saw `.`.
# ⚠️ HONEST BOUND, measured rather than assumed: `let_actual_arg := expression`, so at a real call
# site the GENERAL `list_of_arguments` route always rescues a let argument list and this site has NO
# demonstrated source-level flip. It is repaired anyway because the defect is identical and leaving
# one member of a swept class unfixed is what `.13c.2e` was opened to stop; measured, it moves no
# verdict and no tree on any pinned reproducer.
# ⛔ ABOVE the rule, never between its alternatives — see the note on `system_tf_call`.
let_list_of_arguments := let_named_arg ( comma let_named_arg )*
                                -> {kind: "named_only", items: [$1, $2::2*]}
                       | ( let_actual_arg )? ( comma !dot ( let_actual_arg )? )* ( comma let_named_arg )*
                                -> {kind: "mixed",      head: $1, ordered_tail: [$2::2*], named_tail: [$3::2*]}

let_port_item := attribute_instance* let_formal_type formal_port_identifier variable_dimension* ( assign expression )?
              -> {attributes: $1, type: $2, name: $3, dims: $4, init: $5}

let_port_list := let_port_item ( comma let_port_item )*
              -> [$1, $2::2*]

level_input_list := level_symbol level_symbol*
                 -> [$1, $2*]

level_symbol := kw_n_0_b6589fc6 -> {kind: "0"}
              | kw_n_1_356a192b -> {kind: "1"}
              | kw_x_11f6ad8e   -> {kind: "x"}
              | kw_X_c032adc1   -> {kind: "X"}
              | question        -> {kind: "?"}
              | kw_b_e9d71f5e   -> {kind: "b"}
              | kw_B_ae4f281d   -> {kind: "B"}

liblist_clause := kw_liblist_4851fe70 library_identifier*
