@branch_policy: priority_first
list_of_arguments := list_of_arguments_mixed   -> {kind: "mixed",   body: $1}
                   | list_of_arguments_named   -> {kind: "named",   body: $1}
                   | list_of_arguments_ordered -> {kind: "ordered", body: $1}

list_of_arguments_mixed := list_of_arguments_mixed_head comma named_argument ( comma named_argument )*
                        -> {head: $1, named: [$3, $4::2*]}

list_of_arguments_mixed_head := expression
                                     -> {kind: "single", body: $1}
                              | ( expression )? comma list_of_arguments_mixed_head
                                     -> {kind: "chain",  expr: $1, rest: $3}

list_of_arguments_ordered := ( expression )? ( comma ( expression )? )*
                          -> [$1, $2::2*]

list_of_arguments_named := named_argument ( comma named_argument )*
                        -> [$1, $2::2*]

list_of_checker_port_connections := named_checker_port_connection ( comma named_checker_port_connection )*
                                          -> {kind: "named",   items: [$1, $2::2*]}
                                  | ordered_checker_port_connection ( comma ordered_checker_port_connection )*
                                          -> {kind: "ordered", items: [$1, $2::2*]}

list_of_clocking_decl_assign := clocking_decl_assign ( comma clocking_decl_assign )*
                             -> [$1, $2::2*]

list_of_cross_items := cross_item comma cross_item ( comma cross_item )*
                    -> [$1, $3, $4::2*]

list_of_defparam_assignments := defparam_assignment ( comma defparam_assignment )*
                             -> [$1, $2::2*]

list_of_genvar_identifiers := genvar_identifier ( comma genvar_identifier )*
                           -> [$1, $2::2*]

# POST-SV-AUDIT.2.4b Cat-A: factor the repeated multi-field unit into a
# named record rule; the list becomes a clean flat record array (field
# names {name,dims[,init]} preserved from the prior `first` record).
interface_identifier_decl := interface_identifier unpacked_dimension* -> {name: $1, dims: $2}
list_of_interface_identifiers := interface_identifier_decl ( comma interface_identifier_decl )*
                              -> [$1, $2::2*]

list_of_net_assignments := net_assignment ( comma net_assignment )*
                        -> [$1, $2::2*]

list_of_net_decl_assignments := net_decl_assignment ( comma net_decl_assignment )*
                             -> [$1, $2::2*]

list_of_param_assignments := param_assignment ( comma param_assignment )*
                          -> [$1, $2::2*]

@profiles: ["sv_2017", "verilog_2005"]
list_of_parameter_assignments_sv_2017 := ordered_parameter_assignment ( comma ordered_parameter_assignment )*
                                              -> {kind: "ordered", items: [$1, $2::2*]}
                                       | named_parameter_assignment ( comma named_parameter_assignment )*
                                              -> {kind: "named",   items: [$1, $2::2*]}

@profiles: ["sv_2017", "verilog_2005"]
list_of_parameter_assignments := list_of_parameter_assignments_sv_2017
                              -> {body: $1}

@profiles: ["sv_2023"]
list_of_parameter_value_assignments_sv_2023 := ordered_parameter_assignment ( comma ordered_parameter_assignment )*
                                                     -> {kind: "ordered", items: [$1, $2::2*]}
                                              | named_parameter_assignment ( comma named_parameter_assignment )*
                                                     -> {kind: "named",   items: [$1, $2::2*]}

@profiles: ["sv_2023"]
list_of_parameter_value_assignments := list_of_parameter_value_assignments_sv_2023
                                    -> {body: $1}

list_of_path_delay_expressions := @probe_sample: "1" t_path_delay_expression
                               -> {body: $1}
                                | trise_path_delay_expression comma tfall_path_delay_expression
                                | trise_path_delay_expression comma tfall_path_delay_expression comma tz_path_delay_expression
                                | t01_path_delay_expression comma t10_path_delay_expression comma t0z_path_delay_expression comma tz1_path_delay_expression comma t1z_path_delay_expression comma tz0_path_delay_expression
                                | t01_path_delay_expression comma t10_path_delay_expression comma t0z_path_delay_expression comma tz1_path_delay_expression comma t1z_path_delay_expression comma tz0_path_delay_expression comma t0x_path_delay_expression comma tx1_path_delay_expression comma t1x_path_delay_expression comma tx0_path_delay_expression comma txz_path_delay_expression comma tzx_path_delay_expression
                                | t_path_delay_expression comma t_path_delay_expression comma tz_path_delay_expression comma tz_path_delay_expression comma tz_path_delay_expression comma tz_path_delay_expression
                                | t_path_delay_expression comma t_path_delay_expression comma tz_path_delay_expression comma tz_path_delay_expression comma tz_path_delay_expression comma tz_path_delay_expression comma kw_tx_path_delay_expression_7b2dee37 comma kw_tx_path_delay_expression_7b2dee37 comma kw_tx_path_delay_expression_7b2dee37 comma kw_tx_path_delay_expression_7b2dee37 comma txz_path_delay_expression comma tzx_path_delay_expression

list_of_path_inputs := specify_input_terminal_descriptor ( comma specify_input_terminal_descriptor )*
                    -> [$1, $2::2*]

list_of_path_outputs := specify_output_terminal_descriptor ( comma specify_output_terminal_descriptor )*
                     -> [$1, $2::2*]

list_of_port_connections := named_port_connection ( comma named_port_connection )*
                                  -> {kind: "named",   items: [$1, $2::2*]}
                          | ordered_port_connection ( comma ordered_port_connection )*
                                  -> {kind: "ordered", items: [$1, $2::2*]}

list_of_port_declarations := lparen ( attribute_instance* ansi_port_declaration ( comma attribute_instance* ansi_port_declaration )* )? rparen
                          -> $2

port_identifier_decl := port_identifier unpacked_dimension* -> {name: $1, dims: $2}
list_of_port_identifiers := port_identifier_decl ( comma port_identifier_decl )*
                         -> [$1, $2::2*]

list_of_ports := lparen port ( comma port )* rparen
              -> [$2, $3::2*]

list_of_specparam_assignments := specparam_assignment ( comma specparam_assignment )*
                              -> [$1, $2::2*]

tf_variable_identifier_decl := port_identifier variable_dimension* ( assign expression )? -> {name: $1, dims: $2, init: $3}
list_of_tf_variable_identifiers := tf_variable_identifier_decl ( comma tf_variable_identifier_decl )*
                                -> [$1, $2::2*]

@profiles: ["sv_2017", "sv_2023"]
list_of_type_assignments := type_assignment ( !( comma kw_type_d0a3e7f8 ) comma type_assignment )*
                         -> [$1, $2::2*]

list_of_udp_port_identifiers := port_identifier ( comma port_identifier )*
                             -> [$1, $2::2*]

list_of_variable_assignments := variable_assignment ( comma variable_assignment )*
                             -> [$1, $2::2*]

list_of_variable_decl_assignments := variable_decl_assignment ( comma variable_decl_assignment )*
                                  -> [$1, $2::2*]

variable_identifier_decl := variable_identifier variable_dimension* -> {name: $1, dims: $2}
list_of_variable_identifiers := variable_identifier_decl ( comma variable_identifier_decl )*
                             -> [$1, $2::2*]

variable_port_identifier_decl := port_identifier variable_dimension* ( assign constant_expression )? -> {name: $1, dims: $2, init: $3}
list_of_variable_port_identifiers := variable_port_identifier_decl ( comma variable_port_identifier_decl )*
                                  -> [$1, $2::2*]

@branch_policy: priority_first
@profiles: ["sv_2017", "verilog_2005"]
local_parameter_declaration_sv_2017 := kw_localparam_7829ee69 list_of_param_assignments
                                              -> {kind: "implicit",  items: $2}
                                     | kw_localparam_7829ee69 data_type_or_implicit list_of_param_assignments
                                              -> {kind: "typed",     data_type: $2, items: $3}
                                     | kw_localparam_7829ee69 kw_type_d0a3e7f8 list_of_type_assignments
                                              -> {kind: "type",      items: $3}

@branch_policy: priority_first
@profiles: ["sv_2023"]
local_parameter_declaration_sv_2023 := kw_localparam_7829ee69 list_of_param_assignments
                                              -> {kind: "implicit",       items: $2}
                                     | kw_localparam_7829ee69 data_type_or_implicit list_of_param_assignments
                                              -> {kind: "typed",          data_type: $2, items: $3}
                                     | kw_localparam_7829ee69 type_parameter_declaration
                                              -> {kind: "type_parameter", body: $2}

local_parameter_declaration := local_parameter_declaration_sv_2017 -> {kind: "sv_2017", body: $1}
                             | local_parameter_declaration_sv_2023 -> {kind: "sv_2023", body: $1}

loop_generate_construct := kw_for_43eef9a6 lparen genvar_initialization semi genvar_expression semi genvar_iteration rparen generate_block
                        -> {init: $3, condition: $5, step: $7, block: $9}

@profiles: ["sv_2017", "sv_2023"]
loop_statement_sv_only := kw_do_eadcd9bd statement_or_null kw_while_6517f89c lparen expression rparen semi
                               -> {kind: "do_while", body: $2, condition: $5}
                        | kw_foreach_4d3e8614 lparen ps_or_hierarchical_array_identifier lbrack loop_variables rbrack rparen statement
                               -> {kind: "foreach",  array: $3, loop_vars: $5, body: $8}

loop_statement := kw_forever_e07f8c4a statement_or_null
                       -> {kind: "forever",  body: $2}
                | kw_repeat_c0ac4842 lparen expression rparen statement_or_null
                       -> {kind: "repeat",   count: $3, body: $5}
                | kw_while_6517f89c lparen expression rparen statement_or_null
                       -> {kind: "while",    condition: $3, body: $5}
                | kw_for_43eef9a6 lparen ( for_initialization )? semi ( expression )? semi ( for_step )? rparen statement_or_null
                       -> {kind: "for",      init: $3, condition: $5, step: $7, body: $9}
                | loop_statement_sv_only

loop_variables := ( index_variable_identifier )? ( comma ( index_variable_identifier )? )*
               -> [$1, $2::2*]

member_identifier := non_keyword_identifier

method_call := method_call_initial ( dot method_call_body )*
            -> {initial: $1, chain: $2}

method_call_initial := implicit_class_rooted_method_chain -> {kind: "implicit_class_rooted_method_chain", body: $1}
                     | split_direct_callable_method_call  -> {kind: "split_direct_callable", body: $1}
                     | direct_method_call                 -> {kind: "direct",                body: $1}
                     | class_scoped_tf_call               -> {kind: "class_scoped_tf",       body: $1}
                     | tf_call                            -> {kind: "tf",                    body: $1}
                     | system_tf_call                     -> {kind: "system_tf",             body: $1}

direct_method_call := method_call_root dot method_call_body
                   -> {receiver: $1, body: $3}

@branch_policy: priority_first
method_call_body := built_in_method_call
                          -> {kind: "built_in",       body: $1}
                  | method_identifier attribute_instance* lparen list_of_arguments rparen
                          -> {kind: "call_with_args", name: $1, attributes: $2, args: $4}
                  | method_identifier attribute_instance*
                          -> {kind: "method_bare",    name: $1, attributes: $2}

@branch_policy: priority_first
callable_method_call_body := built_in_method_call
                                    -> {kind: "built_in",        body: $1}
                           | method_identifier attribute_instance* lparen list_of_arguments rparen
                                    -> {kind: "call_with_args",  name: $1, attributes: $2, args: $4}

# SV-EXH-PROOF.3.3.4.b.6.2.11b — allow indexed-element-method-call form
# `arr[i].method()`. Pre-fix: the trailing `identifier` had no
# `constant_bit_select` so `arr[i]` as a method-call receiver matched only
# `arr` (without `[i]`); the subsequent `.method()` then needed a `.`
# right after `arr` but found `[`, so the whole `split_direct_callable_method_call`
# failed. The `( ... constant_bit_select dot !callable_method_call_body )*`
# loop also rejected `arr[i].method` because its negative lookahead fires
# (method() IS a callable_method_call_body), so neither path consumed
# `arr[i].method()`. Adding `constant_bit_select` after the trailing
# identifier (constant_bit_select is `*` so matches empty for bare-id
# receivers) lets the rule consume `arr[i]` as the FINAL receiver, after
# which the OUTER `split_direct_callable_method_call`'s `dot callable_method_call_body`
# matches `.method()`. Shape unchanged (the `{scope:$1, path:$2, name:$3}`
# transform ignores $4 — the trailing bit_select is not surfaced in the AST
# but neither does any consumer need it for fact lookup). Strictly
# additive — bare-id receivers (`obj.method()`, `a.b.c.method()`) continue
# to match via constant_bit_select matching empty.
#
# SV-CORPUS-GRAD.13c.2c — the loop guard above was DEAD, and that is what made
# `ral.arr[0].g()` unparseable whenever the head is not a known variable binding.
# `!callable_method_call_body` can never pass on an identifier: A.8.2's
# `array_manipulation_call ::= array_method_name { attribute_instance }
# [ ( list_of_arguments ) ] [ with ( expression ) ]` makes the parens OPTIONAL, so a
# bare `arr` already IS a `callable_method_call_body` and the negative lookahead
# fires on every member name. Measured on the shipped parser: the loop ran ZERO
# iterations and the receiver collapsed to its first component (`ral`), leaving
# `[0].g()` for a `dot` that found `[`. Multi-component receivers survived only
# through `method_call`'s `( dot method_call_body )*` chain, which carries no
# bit-select — hence `a.b.g()` parsed and `a.b[0].g()` did not.
#
# The replacement guard states the real condition: take this `.` only if the NEXT
# component is itself followed by a `.`, i.e. only if it is a member rather than the
# method. It is the same idiom `context_member_method_call` uses (`&dot`) and that
# `select` uses (`!lparen`) — a possessive `*` needs an explicit lookahead to leave a
# tail, because PGEN quantifiers never give back iterations (LANG-CAPABILITY-AUDIT.10.18).
# Three profiles, one root cause: this also restores IEEE 1364-2005 §12.4's indexed
# hierarchical name in a call position (`top.u1[0].t;`), which A.9.3
# (`hierarchical_identifier ::= { identifier [ [ constant_expression ] ] . } identifier`)
# admits and which rejected on sv_2017, sv_2023 AND verilog_2005 alike.
#
# SV-CORPUS-GRAD.13c.2j — the scope prefix above gained `class_scope`, and THIS is the site
# that carries it. IEEE 1800-2017 A.8.4 writes
# `primary ::= [ class_qualifier | package_scope ] hierarchical_identifier select` with
# `class_qualifier ::= [ local :: ] [ implicit_class_handle . | class_scope ]`, so a
# CLASS-SCOPED name (`p::base::m`) is a legal method-call receiver (A.8.2:
# `method_call_root ::= primary`). The canonical rendering `primary_hier_scope_prefix`
# received the `class_scope` branch from SV-EXH-PROOF.3.3.4.b.6.2.37.3 for a measured defect;
# the three hand-spelled inline copies — this rule and both `method_call_receiver_sv_*` —
# never did, so `y = p::base::m.g()` REJECTED at the `::` after `base` while
# `y = p::base::m;` (the same name as a VALUE) and `h = p::base::m; y = h.g();` (the same
# call through a handle) parsed: both halves legal alone, only the composition rejecting.
# ⭐ Per-site attribution says this ONE site is load-bearing — with `class_scope` here and
# nowhere else both reproducers ACCEPT on sv_2017 and sv_2023, and with it at either
# `method_call_receiver_sv_*` and nowhere else both still REJECT, because
# `branch_policy=longest_match` routes a class-scoped receiver through this rule. The other
# two copies therefore stay shorter (see the note on each) rather than pay the +0.47 %
# `entries` the 3-site variant cost. All of it is re-derived by
# `docs/tasks/artifacts/sv_corpus_grad/scope_prefix_rendering_drift/sweep_scope_prefix_renderings.py`.
# One corpus row moved, and it carries the construct verbatim:
# verible `nested_member_access.sv`'s `nested_class0::handle1::handle2.nested_function()`.
split_hierarchical_callable_receiver := ( kw_class_qualifier_fa08937d | non_typedef_package_scope | class_scope )? ( non_keyword_identifier constant_bit_select dot &( non_keyword_identifier constant_bit_select dot ) )* non_keyword_identifier constant_bit_select
                                     -> {scope: $1, path: $2, name: $3}

split_direct_callable_method_call := split_hierarchical_callable_receiver dot callable_method_call_body
                                            -> {kind: "split_hierarchical", receiver: $1, body: $3}
                                  | implicit_class_handle dot callable_method_call_body
                                            -> {kind: "implicit_class",     receiver: $1, body: $3}

direct_callable_method_call := method_call_root dot callable_method_call_body
                            -> {receiver: $1, body: $3}

# SV-CORPUS-GRAD.13c.2j — branch 2's scope prefix is a hand-spelled copy of A.8.4's
# `[ class_qualifier | package_scope ]` that `primary_hier_scope_prefix` renders canonically,
# and it deliberately stays SHORTER than the canonical rendering. ⛔ Two measurements decide
# that, both re-runnable:
#   (a) adding `class_scope` HERE moves ZERO rows — `p::base::m.g()` and
#       `p::base::h.arr[0].g()` still REJECT with this site alone widened, on sv_2017 AND
#       sv_2023, because `branch_policy=longest_match` hands a class-scoped receiver to
#       `split_hierarchical_callable_receiver` (line ~3345) every time;
#   (b) the 3-site variant that widened this copy too was REFUSED by PARSE-COST-RATCHET:
#       entries +0.47 %, memo_hits +1.05 %. Costs are REJECTED, not traded, and a widening
#       with no demonstrated gain is the shape .13c.2f ruled against.
# So this is a PINNED divergence, never silence: `sweep_scope_prefix_renderings.py`
# re-derives (a) on every run and goes `ATTRIBUTION BROKEN` the day this site becomes
# reachable for such a receiver. ⭐ `select` — A.8.4's other divergence from this copy — is
# omitted on the same footing: `.13c.2c` measured it over an 18-row method-call suite on both
# profiles and it moved ZERO rows either way, because `hierarchical_identifier`'s own
# possessive `( identifier constant_bit_select dot )*` has already consumed the selects
# (LANG-CAPABILITY-AUDIT.10.18).
@profiles: ["sv_2017"]
method_call_receiver_sv_2017 := @probe_sample: "1" primary_literal
                             -> {kind: "primary_literal", body: $1}
                              | @probe_sample: "a" ( kw_class_qualifier_fa08937d | non_typedef_package_scope )? hierarchical_identifier
                                                                                                                        -> {kind: "hierarchical", qualifier: $1, name: $2}
                              | empty_unpacked_array_concatenation                                                      -> {kind: "empty_concat", body: $1}
                              | multiple_concatenation ( lbrack range_expression rbrack )?                              -> {kind: "multi_concat", body: $1, select: $2}
                              | concatenation ( lbrack range_expression rbrack )?                                       -> {kind: "concat", body: $1, select: $2}
                              | let_expression                                                                          -> {kind: "let_expr", body: $1}
                              | lparen mintypmax_expression rparen                                                      -> {kind: "parens", expr: $2}
                              | cast                                                                                    -> {kind: "cast", body: $1}
                              | assignment_pattern_expression                                                           -> {kind: "assignment_pattern", body: $1}
                              | streaming_concatenation                                                                 -> {kind: "streaming_concat", body: $1}
                              | sequence_method_call                                                                    -> {kind: "sequence_method", body: $1}
                              | @probe_sample: "this" kw_this_c2543fff                                                  -> {kind: "this"}
                              | kw_sv_dollar_04da59ec                                                                   -> {kind: "dollar"}
                              | kw_null_2be88ca4 kw_class_qualifier_fa08937d colon assign ( kw_local_939bb46a scope_resolution kw_n_43_0286dd55 )? ( implicit_class_handle dot | class_scope )?
                                                                                                                        -> {kind: "null_class", local_n43: $5, prefix: $6}

# SV-CORPUS-GRAD.13c.2j — the sv_2023 twin of the copy above: same shorter prefix, same two
# measurements, same pin in `sweep_scope_prefix_renderings.py`.
@profiles: ["sv_2023"]
method_call_receiver_sv_2023 := primary_literal                                                                         -> {kind: "primary_literal", body: $1}
                              | ( kw_class_qualifier_fa08937d | non_typedef_package_scope )? hierarchical_identifier    -> {kind: "hierarchical", qualifier: $1, name: $2}
                              | empty_unpacked_array_concatenation                                                      -> {kind: "empty_concat", body: $1}
                              | multiple_concatenation ( lbrack range_expression rbrack )?                              -> {kind: "multi_concat", body: $1, select: $2}
                              | concatenation ( lbrack range_expression rbrack )?                                       -> {kind: "concat", body: $1, select: $2}
                              | let_expression                                                                          -> {kind: "let_expr", body: $1}
                              | lparen mintypmax_expression rparen                                                      -> {kind: "parens", expr: $2}
                              | cast                                                                                    -> {kind: "cast", body: $1}
                              | assignment_pattern_expression                                                           -> {kind: "assignment_pattern", body: $1}
                              | streaming_concatenation                                                                 -> {kind: "streaming_concat", body: $1}
                              | sequence_method_call                                                                    -> {kind: "sequence_method", body: $1}
                              | kw_this_c2543fff                                                                        -> {kind: "this"}
                              | kw_sv_dollar_04da59ec                                                                   -> {kind: "dollar"}
                              | kw_null_2be88ca4 kw_class_qualifier_fa08937d colon assign ( kw_local_939bb46a scope_resolution kw_n_48_64e095fe )? ( implicit_class_handle dot | class_scope )?
                                                                                                                        -> {kind: "null_class", local_n48: $5, prefix: $6}

@profiles: ["sv_2017", "sv_2023"]
method_call_receiver := method_call_receiver_sv_2017 -> {kind: "sv_2017", body: $1}
                      | method_call_receiver_sv_2023 -> {kind: "sv_2023", body: $1}

method_call_root := method_call_receiver  -> {kind: "receiver",       body: $1}
                  | implicit_class_handle -> {kind: "implicit_class", body: $1}

# SV-EXH-PROOF.3.3.4.b.6.2 — context-gated member/method chain (the consumer).
# Root cause (.b.4): the plain `call_primary` path matches only `a.b` of
# `a.b.c(x)` and leaves `.c(x)` unconsumed — `split_hierarchical_callable_receiver`'s
# loop guard `!callable_method_call_body` trips on a bare identifier because
# `array_manipulation_call` has optional parens. This branch parses the full
# 3+level chain when the chain HEAD is a known declared variable
# (`has_fact(variable_binding, …)` — the `.b.6.1.2` producer).
#  - The `&dot` positive lookahead makes the member `+`-loop stop before the
#    final `.method(args)` (a member identifier is followed by `.`, the method
#    is not), so `a.b.c(x)` splits as head `a` / member `b` / method `c(x)`.
#  - The `@predicate … phase: post` gate makes this branch SURGICAL: it fires
#    only for known-variable heads, so hierarchical names, scoped task calls
#    and package paths fall straight through to the unchanged branches below —
#    a regression firewall.
#  - Strictly additive: the `+` requires 3+ identifiers, and 2-level `a.b(x)`
#    already parses, so no currently-passing construct changes shape.
@predicate: { name: has_fact, args: [variable_binding, $head], phase: post }
# SV-EXH-PROOF.3.3.4.b.6.2.37.5 — added `constant_bit_select` (which matches
# zero-or-more `[ const_expr ]`) after each member identifier in the chain
# loop, so `obj.member[i].method(args)` parses cleanly. Surfaced by
# `.37.3`'s deepening into uvm_pkg's `uvm_report_message_element_container::do_copy`:
# `elements.push_back(urme_container.elements[i].clone());` — the call argument
# `c.elements[i].clone()` is `instance . indexed_member . method_call`,
# a 3-level chain where the middle `elements[i]` has a bit-select. Pre-fix the
# `( dot identifier &dot )+` loop accepted only bare identifiers between
# dots, so `dot elements [i]` failed the `&dot` lookahead (`[` ≠ `.`) and
# the rule rejected the chain. Adding `constant_bit_select` (which is `*`
# of `[ const_expr ]`, so matches empty when no index is present) preserves
# backwards-compat: `a.b.c.method()` (no indices) is byte-identical to pre-fix
# behavior since `constant_bit_select` matches empty.
context_member_method_call := non_keyword_identifier ( dot non_keyword_identifier constant_bit_select &dot )+ dot callable_method_call_body ( dot method_call_body )*
                           -> {head: $1.body, members: $2, method: $4, chain: $5}

# SV-EXH-PROOF.3.3.4.b.6.2.37.10 — structural complement of
# `context_member_method_call` for chains rooted at `this` / `super` /
# `this.super` (`implicit_class_handle`) — e.g.
# `this.m_update_thread[element].kill();` (uvm_pkg line 66850).
# Per LRM §A.6.6 + §A.8.4: `class_qualifier` includes `implicit_class_handle .`
# as a primary-prefix, so a member-method chain rooted at `this` is
# LRM-valid. The existing `context_member_method_call` is identifier-rooted
# AND gated by `has_fact(variable_binding, $head)`; `this` is a keyword
# (not an identifier) so we need a parallel rule. Member loop uses the
# same `constant_bit_select &dot` shape from `.37.5` so indexed members
# parse. Head identifier gets its own `constant_bit_select` so the FIRST
# member can also be indexed (`this.arr[0].method()`).
# No predicate gate needed — `kw_this`/`kw_super` are keywords; matching
# is unambiguous.
implicit_class_rooted_method_chain := implicit_class_handle dot non_keyword_identifier constant_bit_select ( dot non_keyword_identifier constant_bit_select &dot )* dot callable_method_call_body ( dot method_call_body )*
                                   -> {receiver: $1, head: $3, head_select: $4, members: $5, method: $7, chain: $8}

# SV-EXH-PROOF.3.3.4.b.6.2.5 — postfix-method-chain on a call-rooted
# receiver expression. `.b.6.2` added `context_member_method_call` for
# identifier-rooted chains like `a.b.c(x)`; this is the structural
# complement for chains rooted in a function or method call —
# `a().b()`, `pkg::tf().m()`, `arr.find(x).size`, `obj.f().chain()`.
# Pure grammar restructure (no semantic mechanism needed); strictly
# additive — the `+` requires >=1 trailing `.method_call_body` after the
# initial call, so single-call expressions continue to match the existing
# per-shape branches unchanged. The `+` guard IS the regression firewall.
chainable_call_initial := class_scoped_tf_call_with_args -> {kind: "class_scoped_tf",  body: $1}
                        | plain_tf_call_with_args         -> {kind: "plain_tf",         body: $1}
                        | tf_call_with_args               -> {kind: "tf",               body: $1}
                        | direct_callable_method_call    -> {kind: "direct_callable",  body: $1}
                        | system_tf_call                   -> {kind: "system_tf",        body: $1}

call_with_postfix_chain := chainable_call_initial ( dot method_call_body )+
                        -> {initial: $1, chain: [$2**]}

# SV-EXH-PROOF.3.3.4.b.6.2.11 — identifier-rooted method-chain (the
# symmetric complement of `.b.6.2.5`'s call_with_postfix_chain). The .b.6.2.5
# slice added postfix-chain on a CALL-rooted receiver (`a().b()`,
# `pkg::tf().m()`); this rule covers chains rooted in an IDENTIFIER-rooted
# single-call form like `obj.dup().dup()` (the identifier-rooted analogue
# — split_direct_callable_method_call covers `obj.dup()` alone but has no
# chain wrapper, so `obj.dup().dup()` in EXPRESSION position rejected pre-
# fix). Strictly additive — the `+` requires >=1 trailing `.method_call_body`
# after the initial obj.method() call, so single-call expressions
# (`obj.dup()`) continue to match the existing per-shape branches
# unchanged. The `+` guard IS the regression firewall.
identifier_rooted_method_chain := split_direct_callable_method_call ( dot method_call_body )+
                               -> {initial: $1, chain: [$2**]}

@branch_policy: priority_first
call_primary := context_member_method_call          -> {kind: "context_member_method",       body: $1}
              | implicit_class_rooted_method_chain  -> {kind: "implicit_class_rooted_method_chain", body: $1}
              | call_with_postfix_chain             -> {kind: "call_postfix_chain",          body: $1}
              | identifier_rooted_method_chain      -> {kind: "ident_postfix_chain",         body: $1}
              | split_direct_callable_method_call -> {kind: "split_direct_callable_method", body: $1}
              | class_scoped_tf_call_with_args     -> {kind: "class_scoped_tf",              body: $1}
              | plain_tf_call_with_args            -> {kind: "plain_tf",                     body: $1}
              | rooted_tf_call_sv_only
              | tf_call_with_args                  -> {kind: "tf",                           body: $1}
              | direct_callable_method_call        -> {kind: "direct_callable_method",       body: $1}
              | system_tf_call                     -> {kind: "system_tf",                    body: $1}

method_identifier := declaration_identifier

@profiles: ["sv_2017", "sv_2023"]
method_prototype := task_prototype     -> {kind: "task",     body: $1}
                  | function_prototype -> {kind: "function", body: $1}

method_qualifier := ( kw_pure_afe003f1 )? kw_virtual_af84d91f -> {kind: "virtual",              pure: $1}
                  | class_item_qualifier                       -> {kind: "class_item_qualifier", body: $1}

mintypmax_expression := expression
                              -> {kind: "simple", body: $1}
                      | expression colon expression colon expression
                              -> {kind: "triple", min: $1, typ: $3, max: $5}

modport_clocking_declaration := kw_clocking_4d22041d clocking_identifier
                             -> {name: $2}

@profiles: ["sv_2017", "sv_2023"]
modport_declaration := kw_modport_1cf85849 modport_item ( comma modport_item )* semi
                    -> {items: [$2, $3::2*]}

modport_identifier := declaration_identifier

modport_item := modport_identifier lparen modport_ports_declaration ( comma modport_ports_declaration )* rparen
             -> {name: $1, ports: [$3, $4::2*]}

modport_ports_declaration := attribute_instance* modport_simple_ports_declaration   -> {kind: "simple",   attributes: $1, body: $2}
                           | attribute_instance* modport_tf_ports_declaration       -> {kind: "tf",       attributes: $1, body: $2}
                           | attribute_instance* modport_clocking_declaration       -> {kind: "clocking", attributes: $1, body: $2}

modport_simple_port := port_identifier                                        -> {kind: "identifier", name: $1}
                     | dot port_identifier lparen ( expression )? rparen      -> {kind: "explicit",   name: $2, expression: $4}

modport_tf_port := method_prototype  -> {kind: "method_prototype", body: $1}
                 | tf_identifier     -> {kind: "tf_identifier",    name: $1}

modport_tf_ports_declaration := import_export modport_tf_port ( comma modport_tf_port )*
                             -> {import_export: $1, ports: [$2, $3::2*]}

@sample: "module m(input logic a);"
module_ansi_header := attribute_instance* module_keyword ( lifetime )? module_identifier package_import_declaration* ( parameter_port_list )? ( list_of_port_declarations )? semi
                   -> {attributes: $1, keyword: $2, lifetime: $3, name: $4, imports: $5, parameters: $6, ports: $7}

@profiles: ["sv_2017", "verilog_2005"]
module_common_item_sv_2017 := module_or_generate_item_declaration -> {kind: "module_or_generate_item_declaration", body: $1}
                            | interface_instantiation             -> {kind: "interface_instantiation",             body: $1}
                            | program_instantiation               -> {kind: "program_instantiation",               body: $1}
                            | assertion_item                      -> {kind: "assertion_item",                      body: $1}
                            | bind_directive                      -> {kind: "bind_directive",                      body: $1}
                            | continuous_assign                   -> {kind: "continuous_assign",                   body: $1}
                            | net_alias                           -> {kind: "net_alias",                           body: $1}
                            | initial_construct                   -> {kind: "initial_construct",                   body: $1}
                            | final_construct                     -> {kind: "final_construct",                     body: $1}
                            | always_construct                    -> {kind: "always_construct",                    body: $1}
                            | loop_generate_construct             -> {kind: "loop_generate_construct",             body: $1}
                            | conditional_generate_construct      -> {kind: "conditional_generate_construct",      body: $1}
                            | elaboration_system_task             -> {kind: "elaboration_system_task",             body: $1}

@profiles: ["sv_2023"]
module_common_item_sv_2023 := module_or_generate_item_declaration  -> {kind: "module_or_generate_item_declaration", body: $1}
                            | interface_instantiation              -> {kind: "interface_instantiation",             body: $1}
                            | program_instantiation                -> {kind: "program_instantiation",               body: $1}
                            | assertion_item                       -> {kind: "assertion_item",                      body: $1}
                            | bind_directive                       -> {kind: "bind_directive",                      body: $1}
                            | continuous_assign                    -> {kind: "continuous_assign",                   body: $1}
                            | net_alias                            -> {kind: "net_alias",                           body: $1}
                            | initial_construct                    -> {kind: "initial_construct",                   body: $1}
                            | final_construct                      -> {kind: "final_construct",                     body: $1}
                            | always_construct                     -> {kind: "always_construct",                    body: $1}
                            | loop_generate_construct              -> {kind: "loop_generate_construct",             body: $1}
                            | conditional_generate_construct       -> {kind: "conditional_generate_construct",      body: $1}
                            | elaboration_severity_system_task     -> {kind: "elaboration_severity_system_task",    body: $1}

module_common_item := module_common_item_sv_2017 -> {kind: "sv_2017", body: $1}
                    | module_common_item_sv_2023 -> {kind: "sv_2023", body: $1}

@profiles: ["sv_2017", "verilog_2005"]
module_declaration_sv_2017 := @sample: "module m; endmodule" module_ansi_header ( timeunits_declaration )? non_port_module_item* kw_endmodule_2eb38ec9 ( colon module_identifier )?
                                -> {kind: "ansi", header: $1, timeunits: $2, items: $3, end_label: $5}
                            | @sample: "module m(a); endmodule" module_nonansi_header ( timeunits_declaration )? module_item* kw_endmodule_2eb38ec9 ( colon module_identifier )?
                                -> {kind: "nonansi", header: $1, timeunits: $2, items: $3, end_label: $5}
                            | @sample: "module m(.*); endmodule" attribute_instance* module_keyword ( lifetime )? module_identifier lparen dot_star rparen semi ( timeunits_declaration )? module_item* kw_endmodule_2eb38ec9 ( colon module_identifier )?
                                -> {kind: "wildcard", attributes: $1, keyword: $2, lifetime: $3, name: $4, timeunits: $9, items: $10, end_label: $12}
                            | @sample: "extern module m(a);" kw_extern_bf1ee311 module_nonansi_header
                                -> {kind: "extern_nonansi", header: $2}
                            | @sample: "extern module m;" kw_extern_bf1ee311 module_ansi_header
                                -> {kind: "extern_ansi", header: $2}

@profiles: ["sv_2023"]
module_declaration_sv_2023 := @sample: "module m; endmodule" module_ansi_header ( timeunits_declaration )? non_port_module_item* kw_endmodule_2eb38ec9 ( colon module_identifier )?
                                -> {kind: "ansi", header: $1, timeunits: $2, items: $3, end_label: $5}
                            | @sample: "module m(a); endmodule" module_nonansi_header ( timeunits_declaration )? module_item* kw_endmodule_2eb38ec9 ( colon module_identifier )?
                                -> {kind: "nonansi", header: $1, timeunits: $2, items: $3, end_label: $5}
                            | @sample: "module m(.*); endmodule" attribute_instance* module_keyword ( lifetime )? module_identifier lparen dot star rparen semi ( timeunits_declaration )? module_item* kw_endmodule_2eb38ec9 ( colon module_identifier )?
                                -> {kind: "wildcard", attributes: $1, keyword: $2, lifetime: $3, name: $4, timeunits: $10, items: $11, end_label: $13}
                            | @sample: "extern module m(a);" kw_extern_bf1ee311 module_nonansi_header
                                -> {kind: "extern_nonansi", header: $2}
                            | @sample: "extern module m;" kw_extern_bf1ee311 module_ansi_header
                                -> {kind: "extern_ansi", header: $2}

module_declaration := @sample: "module m; endmodule" module_declaration_sv_2017
                              -> {kind: "sv_2017", body: $1}
                    | @sample: "module m; endmodule" module_declaration_sv_2023
                              -> {kind: "sv_2023", body: $1}

module_identifier := declaration_identifier

module_instantiation := module_identifier ( parameter_value_assignment )? hierarchical_instance ( comma hierarchical_instance )* semi
                     -> {name: $1, params: $2, instances: [$3, $4::2*]}

module_item := port_declaration semi  -> {kind: "port_declaration", body: $1}
            | non_port_module_item   -> {kind: "non_port_item",    body: $1}

module_keyword := kw_module_fbd34a2b      -> {kind: "module"}
                | kw_macromodule_df04b866 -> {kind: "macromodule"}

@sample: "module m(a,b);"
module_nonansi_header := attribute_instance* module_keyword ( lifetime )? module_identifier package_import_declaration* ( parameter_port_list )? list_of_ports semi
                      -> {attributes: $1, keyword: $2, lifetime: $3, name: $4, imports: $5, parameters: $6, ports: $7}

module_or_generate_item := attribute_instance* parameter_override
                              -> {kind: "parameter_override",  attributes: $1, body: $2}
                        | attribute_instance* gate_instantiation
                              -> {kind: "gate_instantiation",  attributes: $1, body: $2}
                        | attribute_instance* udp_instantiation
                              -> {kind: "udp_instantiation",   attributes: $1, body: $2}
                        | attribute_instance* module_instantiation
                              -> {kind: "module_instantiation", attributes: $1, body: $2}
                        | attribute_instance* module_common_item
                              -> {kind: "module_common_item",  attributes: $1, body: $2}

module_or_generate_item_declaration := package_or_generate_item_declaration
                                          -> {kind: "package_or_generate", body: $1}
                                    | genvar_declaration
                                          -> {kind: "genvar",              body: $1}
                                    | clocking_declaration
                                          -> {kind: "clocking",            body: $1}
                                    | kw_default_7505d64a kw_clocking_4d22041d clocking_identifier semi
                                          -> {kind: "default_clocking",    name: $3}
                                    | kw_default_7505d64a kw_disable_ccf09e2d kw_iff_ee1c009e expression_or_dist semi
                                          -> {kind: "default_disable_iff", expr: $4}

module_path_concatenation := lbrace ( module_path_expression ( comma module_path_expression )* ) rbrace
                           -> {body: $2}

module_path_conditional_expression := module_path_expression_operand ( binary_module_path_operator attribute_instance* module_path_expression_operand )* question attribute_instance* module_path_expression colon module_path_expression
                                   -> {condition: {kind: "chain", first: $1, rest: $2}, attributes: $4, then_expr: $5, else_expr: $7}

module_path_expression_operand := unary_module_path_operator attribute_instance* module_path_primary
                                          -> {kind: "unary",   op: $1, attributes: $2, primary: $3}
                                | module_path_primary
                                          -> {kind: "primary", body: $1}

module_path_expression := module_path_conditional_expression
                                -> {kind: "conditional", body: $1}
                       | module_path_expression_operand ( binary_module_path_operator attribute_instance* module_path_expression_operand )*
                                -> {kind: "chain",       first: $1, rest: $2}

module_path_mintypmax_expression := module_path_expression
                                          -> {kind: "simple", body: $1}
                                  | module_path_expression colon module_path_expression colon module_path_expression
                                          -> {kind: "triple", min: $1, typ: $3, max: $5}

module_path_multiple_concatenation := lbrace ( constant_expression module_path_concatenation ) rbrace
                                    -> {body: $2}

module_path_primary := number                                          -> {kind: "number",            body: $1}
                     | non_keyword_identifier                                      -> {kind: "identifier",        body: $1}
                     | module_path_concatenation                       -> {kind: "concatenation",    body: $1}
                     | module_path_multiple_concatenation              -> {kind: "multiple_concat",  body: $1}
                     | function_subroutine_call                        -> {kind: "function_call",    body: $1}
                     | lparen module_path_mintypmax_expression rparen  -> {kind: "paren",            body: $2}

mos_switch_instance := ( name_of_instance )? lparen output_terminal comma input_terminal comma enable_terminal rparen
                    -> {name: $1, output: $3, input: $5, enable: $7}

mos_switchtype := kw_nmos_0c967e00  -> {kind: "nmos"}
                | kw_pmos_f3d8bd5d  -> {kind: "pmos"}
                | kw_rnmos_de1c9510 -> {kind: "rnmos"}
                | kw_rpmos_7cd80934 -> {kind: "rpmos"}

multiple_concatenation := lbrace expression concatenation rbrace
                       -> {count: $2, body: $3}

n_input_gate_instance := ( name_of_instance )? lparen output_terminal comma input_terminal ( comma input_terminal )* rparen
                      -> {name: $1, output: $3, inputs: [$5, $6::2*]}

n_input_gatetype := kw_and_cffa50a3  -> {kind: "and"}
                  | kw_nand_c8a98832 -> {kind: "nand"}
                  | kw_or_1758356d   -> {kind: "or"}
                  | kw_nor_19d0495c  -> {kind: "nor"}
                  | kw_xor_f1922a23  -> {kind: "xor"}
                  | kw_xnor_ab48bc67 -> {kind: "xnor"}

# SV-CORPUS-GRAD.13c.2r: the `&comma` lookahead is what makes this rule matchable AT ALL.
# IEEE 1364-2005 A.3.1 writes `[ name_of_instance ] ( output_terminal { , output_terminal } ,
# input_terminal )` — one or more outputs, then exactly one input. Spelled with a bare
# `( comma output_terminal )*` the star is GREEDY and `output_terminal := net_lvalue` matches the
# same text as `input_terminal := expression`, so the star ate the MANDATORY trailing
# `comma input_terminal` and the sequence then failed with nothing left to satisfy it.
# ⛔ CORRECTED (`.13c.2r` re-derivation, `-0234`): NOT "for every input". The star eats the tail
# exactly when `net_lvalue` can match a PREFIX of the final terminal — a plain net (`buf g(o,i)`), a
# concatenation, a bit-select, or any expression starting with a net reference. Measured on the
# pre-fix grammar, a final terminal that cannot START a net_lvalue leaves the star nothing to take
# and the rule DID match: `buf g(o,o2,1'b0)`, `buf g(o,(a))` and `buf g(o,$signed(a))` all reached
# `gate_instantiation`. The corpus rule-coverage artifact said so all along — `n_output_gate_instance
# covered 4`. So the defect is the COMMON form, not every form, and `buf`/`not` reached
# `udp_instantiation` (via the reserved-word hole `.13c.2k` closes) only in that common form.
# The lookahead lets the star take a terminal only when ANOTHER comma follows, i.e. only when it is
# not the last one; same device as `split_hierarchical_callable_receiver`. The mechanism was
# isolated on an 8-line scratch grammar — `docs/tasks/artifacts/sv_corpus_grad/gate_route_unmasking/`
# — ⚠️ which could never have shown the boundary, because there `out` and `inp` share one regex.
# An isolation proves a mechanism EXISTS; it does not bound where the mechanism APPLIES.
# ⭐ Its sibling `n_input_gate_instance` below needs no such guard: its star is at the END.
n_output_gate_instance := ( name_of_instance )? lparen output_terminal ( comma output_terminal &comma )* comma input_terminal rparen
                       -> {name: $1, outputs: [$3, $4::2*], input: $6}

n_output_gatetype := kw_buf_cb252062 -> {kind: "buf"}
                   | kw_not_557f2555 -> {kind: "not"}

name_of_instance := instance_identifier unpacked_dimension*
                 -> {name: $1, dims: $2}

@profiles: ["sv_2017"]
named_checker_port_connection_sv_2017 := attribute_instance* dot formal_port_identifier ( lparen ( property_actual_arg )? rparen )?
                                                -> {kind: "named",    attributes: $1, name: $3, value: $4}
                                       | attribute_instance* dot_star
                                                -> {kind: "wildcard", attributes: $1}

@profiles: ["sv_2023"]
named_checker_port_connection_sv_2023 := attribute_instance* dot formal_port_identifier ( lparen ( property_actual_arg )? rparen )?
                                                -> {kind: "named",    attributes: $1, name: $3, value: $4}
                                       | attribute_instance* dot star
                                                -> {kind: "wildcard", attributes: $1}

@profiles: ["sv_2017", "sv_2023"]
named_checker_port_connection := named_checker_port_connection_sv_2017 -> {kind: "sv_2017", body: $1}
                               | named_checker_port_connection_sv_2023 -> {kind: "sv_2023", body: $1}

named_parameter_assignment := dot parameter_identifier lparen ( param_expression )? rparen
                           -> {name: $2, value: $4}

named_argument := dot non_keyword_identifier lparen ( expression )? rparen
               -> {name: $2, value: $4}

@profiles: ["sv_2017", "verilog_2005"]
named_port_connection_sv_2017 := attribute_instance* dot port_identifier ( lparen ( expression )? rparen )?
                                        -> {kind: "named",    attributes: $1, name: $3, value: $4}
                               | attribute_instance* dot_star
                                        -> {kind: "wildcard", attributes: $1}

@profiles: ["sv_2023"]
named_port_connection_sv_2023 := attribute_instance* dot port_identifier ( lparen ( expression )? rparen )?
                                        -> {kind: "named",    attributes: $1, name: $3, value: $4}
                               | attribute_instance* dot star
                                        -> {kind: "wildcard", attributes: $1}

named_port_connection := named_port_connection_sv_2017 -> {kind: "sv_2017", body: $1}
                       | named_port_connection_sv_2023 -> {kind: "sv_2023", body: $1}

ncontrol_terminal := expression
                  -> {body: $1}

# POST-SV-AUDIT.2.4a Cat-A: single-token `assign` separator list of
# aliased net_lvalues → clean flat list (drop the `=` separators).
@profiles: ["sv_2017", "sv_2023"]
net_alias := kw_alias_cdb6fdbe net_lvalue assign net_lvalue ( assign net_lvalue )* semi
          -> {lvalues: [$2, $4, $5::2*]}

net_assignment := net_lvalue assign expression
               -> {lvalue: $1, value: $3}

net_decl_assignment := net_identifier unpacked_dimension* ( assign expression )?
                    -> {name: $1, dims: $2, init: $3}

@profiles: ["sv_2017", "sv_2023"]
interconnect_net_declaration_sv_only := @probe_sample: "interconnect logic a;" kw_interconnect_c8ec83f5 implicit_data_type ( hash delay_value )? net_identifier unpacked_dimension* ( comma net_identifier unpacked_dimension* )? semi
                                -> {kind: "interconnect", data_type: $2, delay: $3, name: $4, dims: $5, second: $6}

@profiles: ["sv_2017", "verilog_2005"]
net_declaration_sv_2017 := @probe_sample: "wire a;" net_type ( net_strength )? ( net_vector_scalar )? data_type_or_implicit ( delay )? list_of_net_decl_assignments semi
                                -> {kind: "wire",         net_type: $1, strength: $2, vector_scalar: $3, data_type: $4, delay: $5, assignments: $6}
                         # SV-PARSE-STRICT.2: a user net-type identifier must be a KNOWN declared type/nettype (sound store-gate via `checked_nettype_identifier`).
                         | checked_nettype_identifier ( delay_control )? list_of_net_decl_assignments semi
                                -> {kind: "alias",        net_type_id: $1, delay_control: $2, assignments: $3}
                         # SV-PARSE-STRICT.2: unresolved-wildcard-import escape — accept an otherwise-undeclared net-type id ONLY when a `pkg::*` is in scope (cannot prove undeclared; defer to elaboration). The gate lives on the `wildcard_escape_nettype_identifier` helper (a `phase: post` predicate — historically required because inline `phase: branch` predicates were flattened rule-wide; branch-LOCAL since BRANCH-PREDICATE-LOCALITY.2, the helper idiom kept as-is, shape-stable).
                         | wildcard_escape_nettype_identifier ( delay_control )? list_of_net_decl_assignments semi
                                -> {kind: "alias",        net_type_id: $1, delay_control: $2, assignments: $3}
                         | interconnect_net_declaration_sv_only

@profiles: ["sv_2023"]
net_declaration_sv_2023 := @probe_sample: "wire a;" net_type ( net_strength )? ( net_vector_scalar )? data_type_or_implicit ( delay )? list_of_net_decl_assignments semi
                                -> {kind: "wire",         net_type: $1, strength: $2, vector_scalar: $3, data_type: $4, delay: $5, assignments: $6}
                         # SV-PARSE-STRICT.2: known declared type/nettype (sound store-gate).
                         | checked_nettype_identifier ( delay_control )? list_of_net_decl_assignments semi
                                -> {kind: "alias",        nettype_id: $1, delay_control: $2, assignments: $3}
                         # SV-PARSE-STRICT.2: unresolved-wildcard-import escape (branch-local `phase: post` gate via the helper — see the sv_2017 note).
                         | wildcard_escape_nettype_identifier ( delay_control )? list_of_net_decl_assignments semi
                                -> {kind: "alias",        nettype_id: $1, delay_control: $2, assignments: $3}
                         | interconnect_net_declaration_sv_only

net_strength := drive_strength  -> {kind: "drive",  body: $1}
              | charge_strength -> {kind: "charge", body: $1}

net_vector_scalar := kw_vectored_53eb166d -> {kind: "vectored"}
                   | kw_scalared_92ab459c -> {kind: "scalared"}

net_declaration := net_declaration_sv_2017 -> {kind: "sv_2017", body: $1}
                 | net_declaration_sv_2023 -> {kind: "sv_2023", body: $1}

net_identifier := declaration_identifier

net_lvalue := ps_or_hierarchical_net_identifier constant_select
                    -> {kind: "name",          name: $1, select: $2}
            | lbrace net_lvalue ( comma net_lvalue )* rbrace
                    -> {kind: "concatenation", items: [$2, $3::2*]}
            | ( assignment_pattern_expression_type )? assignment_pattern_net_lvalue
                    -> {kind: "pattern",       type: $1, body: $2}

net_port_header := ( port_direction )? net_port_type
                -> {direction: $1, port_type: $2}

@profiles: ["sv_2017", "sv_2023"]
net_port_type_interconnect_sv_only := kw_interconnect_c8ec83f5 implicit_data_type -> {kind: "interconnect", data_type: $2}

@profiles: ["sv_2017", "verilog_2005"]
# SV-KEYWORD-PRIMARY-FIDELITY.3.1 (SV-0037): alt 1 was the *ungated* `net_type_identifier`
# (bare `declaration_identifier`, :3517). Under the global default `longest_match` branch
# policy it out-consumes alt 0's empty implicit match and greedily eats the port NAME of an
# implicit-type ANSI port (`module m(input a);` — `a` matched as a net-type, no name left →
# the ANSI branch fails and the module mis-parses as `nonansi`). Routed to the store-gated,
# profile-agnostic `checked_nettype_identifier` (:3537, `fact_attribute_equals(type_name, …,
# declaration_family, nettype)`) so only a DECLARED nettype can match here (a declared nettype
# already routes through alt 0's `known_unscoped_data_type`, so alt 1 is LRM-faithful but
# tie-dominated). AST shape `{kind:"identifier", name:$1}` preserved (`{body:X}` both sides).
net_port_type_sv_2017 := ( net_type )? data_type_or_implicit             -> {kind: "typed",        net_type: $1, data_type: $2}
                       | checked_nettype_identifier                       -> {kind: "identifier",   name: $1}
                       | net_port_type_interconnect_sv_only

@profiles: ["sv_2023"]
# SV-KEYWORD-PRIMARY-FIDELITY.3.1 (SV-0037): sv_2023 twin of the alt-1 greedy-nettype fix
# above — the ungated `nettype_identifier` (:3567) is routed to the store-gated
# `checked_nettype_identifier` (:3537) for the same reason. Same AST shape preserved.
net_port_type_sv_2023 := ( net_type )? data_type_or_implicit             -> {kind: "typed",        net_type: $1, data_type: $2}
                       | checked_nettype_identifier                       -> {kind: "identifier",   name: $1}
                       | net_port_type_interconnect_sv_only

net_port_type := net_port_type_sv_2017 -> {kind: "sv_2017", body: $1}
               | net_port_type_sv_2023 -> {kind: "sv_2023", body: $1}

net_type := kw_supply0 -> {kind: "supply0"}
         | kw_supply1 -> {kind: "supply1"}
         | kw_tri_54bf01f1    -> {kind: "tri"}
         | kw_triand_51bca013 -> {kind: "triand"}
         | kw_trior_56b8b9f0  -> {kind: "trior"}
         | kw_trireg_f7901823 -> {kind: "trireg"}
         | kw_uwire_9143a634  -> {kind: "uwire"}
         | kw_wire_6e1c6849   -> {kind: "wire"}
         | kw_wand_4be59aff   -> {kind: "wand"}
         | kw_wor_ff9e40da    -> {kind: "wor"}

# SV-AST-SHAPE-FIDELITY.2.6 — named-lift of the nettype scope-prefix alternation so the
# (double-nested) `with`-clause scope group in both nettype rules' br0 binds a clean named
# rule (`nettype_scope_prefix?`) instead of an inline alternation (which corrupted the
# positional model → the `with_clause` inner scope emitted `data_type`/`name`/`with_clause`
# `<invalid_sequence_access>` when the self-annotated `non_typedef_package_scope` branch won,
# e.g. `nettype logic n with pkg::f;`). Order preserved (`non_typedef_package_scope | class_scope`,
# NOT the reversed `scoped_type_scope_prefix`); shared by all 4 nettype occurrences (both profiles,
# both branches). The `.2.3` `scoped_type_scope_prefix` named-lift precedent.
@profiles: ["sv_2017", "sv_2023"]
nettype_scope_prefix := non_typedef_package_scope | class_scope

@profiles: ["sv_2017"]
@sample: "nettype int nt;"
net_type_declaration_sv_2017 := kw_nettype_27d30cf3 data_type declared_nettype_identifier ( kw_with_8fcd25a3 nettype_scope_prefix? tf_identifier )? semi
                             -> {data_type: $2, name: $3, with_clause: $4}
                              | kw_nettype_27d30cf3 nettype_scope_prefix? net_type_identifier declared_nettype_identifier semi

@profiles: ["sv_2017"]
net_type_declaration := net_type_declaration_sv_2017
                     -> {body: $1}

@profiles: ["sv_2017"]
net_type_identifier_sv_2017 := declaration_identifier

@profiles: ["sv_2017"]
net_type_identifier := net_type_identifier_sv_2017

# SV-PARSE-STRICT.2: a USE of a net-type identifier that MUST be a known declared
# NETTYPE — mirrors the proven `checked_type_identifier` store-gate. A bare
# `declaration_identifier` routed through a `phase: post`
# `fact_attribute_equals(type_name, …, declaration_family, nettype)` gate so it
# resolves ONLY to a declared nettype (`declared_nettype_identifier` emits
# `type_name` with `declaration_family: nettype`), and a provably-undeclared OR
# wrong-family identifier is REJECTED at parse time. Profile-agnostic (used by both
# the sv_2017 and sv_2023 `net_declaration` alias branches).
# GRAMMAR-WELLFORMED.H.12.5.5.3.3.4.2.2.1: the gate was `has_fact(type_name, $body)`
# — under-specified, since a CLASS is also a `type_name`, so `C a;` (C a declared
# class) was wrongly consumed as a net declaration (no `variable_binding` emitted),
# blocking class-handle member-method chains. Tightening to require
# `declaration_family: nettype` routes `C a;` to `data_declaration` (a class variable)
# instead — the LRM-correct categorisation (a class is not a nettype).
@predicate: { name: fact_attribute_equals, args: [type_name, $body, declaration_family, nettype], phase: post }
checked_nettype_identifier := declaration_identifier -> { body: $1.body }

# SV-PARSE-STRICT.2: a DECLARATION of a user nettype name — emits the `type_name`
# fact (declaration_family: nettype) so a later `checked_nettype_identifier` use
# resolves (binding-before-use; mirrors the `declared_*_identifier` helpers for
# class / typedef / covergroup). Profile-agnostic.
@emit_fact: { kind: type_name, name: $body, declaration_family: nettype }
declared_nettype_identifier := declaration_identifier -> { body: $1.body }

# SV-PARSE-STRICT.2: the unresolved-wildcard-import ESCAPE used by the
# `net_declaration` alias branch — accepts a (possibly undeclared) net-type
# identifier ONLY when an `import pkg::*;` is in scope (`fact_count_at_least
# (wildcard_import_open, 1)`). The gate is `phase: post` on this helper rule —
# historically REQUIRED because an inline `phase: branch` predicate was flattened
# rule-wide by `branch_predicates_for_rule` and would have wrongly gated the
# sibling `wire a;` branch; since BRANCH-PREDICATE-LOCALITY.2 (2026-07-06) inline
# branch predicates are branch-LOCAL and the two idioms are equivalent — the
# helper-rule form is kept as-is (shape-stable). Profile-agnostic.
@predicate: { name: fact_count_at_least, args: [wildcard_import_open, 1], phase: post }
wildcard_escape_nettype_identifier := declaration_identifier -> { body: $1.body }

@profiles: ["sv_2023"]
nettype_declaration_sv_2023 := kw_nettype_27d30cf3 data_type declared_nettype_identifier ( kw_with_8fcd25a3 nettype_scope_prefix? tf_identifier )? semi
                                      -> {kind: "data_type",  data_type: $2, name: $3, with_clause: $4}
                              | kw_nettype_27d30cf3 nettype_scope_prefix? nettype_identifier declared_nettype_identifier semi
                                      -> {kind: "nettype",    scope: $2, base: $3, name: $4}

@profiles: ["sv_2023"]
nettype_declaration := nettype_declaration_sv_2023
                    -> {body: $1}

@profiles: ["sv_2023"]
nettype_identifier_sv_2023 := declaration_identifier

@profiles: ["sv_2023"]
nettype_identifier := nettype_identifier_sv_2023

next_state := output_symbol -> {kind: "symbol", body: $1}
            | minus         -> {kind: "minus"}

@profiles: ["sv_2017"]
non_consecutive_repetition_sv_2017 := lbrack assign const_or_range_expression rbrack
                                   -> {range: $3}

@profiles: ["sv_2017"]
non_consecutive_repetition := non_consecutive_repetition_sv_2017
                           -> {body: $1}

@profiles: ["sv_2017", "sv_2023"]
non_integer_type_sv_only := kw_shortreal_99d69111 -> {kind: "shortreal"}

non_integer_type := non_integer_type_sv_only
                  | kw_real_c9c64e07     -> {kind: "real"}
                  | kw_realtime_91c462ed -> {kind: "realtime"}

non_port_interface_item := generate_region
                               -> {kind: "generate_region",       body: $1}
                        | interface_or_generate_item
                               -> {kind: "interface_or_generate", body: $1}
                        | program_declaration
                               -> {kind: "program_declaration",   body: $1}
                        | modport_declaration
                               -> {kind: "modport_declaration",   body: $1}
                        | interface_declaration
                               -> {kind: "interface_declaration", body: $1}
                        | timeunits_declaration
                               -> {kind: "timeunits_declaration", body: $1}

# ⛔ NOTE FOR EDITORS: a `#` comment INSIDE an alternation list TERMINATES the rule —
# every `|` arm below such a comment is silently dropped from the generated parser (the
# `.3.14b` first attempt lost its arm exactly this way; caught because
# `cascade_match_non_port_module_item` carried 8 alternatives, not 9). Keep commentary
# above the rule.
#
# SV-CORPUS-GRAD.3.14b — the LAST alternative below is the module-body host of the
# in-scope directive whitelist (see `in_scope_compiler_directive`). Last on purpose: it
# fires only where `non_port_module_item` previously failed outright.
non_port_module_item := generate_region
                            -> {kind: "generate_region",       body: $1}
                     | module_or_generate_item
                            -> {kind: "module_or_generate",    body: $1}
                     | specify_block
                            -> {kind: "specify_block",         body: $1}
                     | attribute_instance* specparam_declaration
                            -> {kind: "specparam_declaration", attributes: $1, body: $2}
                     | program_declaration
                            -> {kind: "program_declaration",   body: $1}
                     | module_declaration
                            -> {kind: "module_declaration",    body: $1}
                     | interface_declaration
                            -> {kind: "interface_declaration", body: $1}
                     | timeunits_declaration
                            -> {kind: "timeunits_declaration", body: $1}
                     | in_scope_compiler_directive
                            -> {kind: "compiler_directive",    body: $1}

non_port_program_item := attribute_instance* continuous_assign
                             -> {kind: "continuous_assign",                attributes: $1, body: $2}
                       | attribute_instance* module_or_generate_item_declaration
                             -> {kind: "module_or_generate_item_declaration", attributes: $1, body: $2}
                       | attribute_instance* initial_construct
                             -> {kind: "initial_construct",                attributes: $1, body: $2}
                       | attribute_instance* final_construct
                             -> {kind: "final_construct",                  attributes: $1, body: $2}
                       | attribute_instance* concurrent_assertion_item
                             -> {kind: "concurrent_assertion_item",        attributes: $1, body: $2}
                       | timeunits_declaration
                             -> {kind: "timeunits_declaration",            body: $1}
                       | program_generate_item
                             -> {kind: "program_generate_item",            body: $1}

nonblocking_assignment := variable_lvalue less_equal ( delay_or_event_control )? expression
                       -> {lvalue: $1, control: $3, value: $4}

@profiles: ["sv_2023"]
nonconsecutive_repetition_sv_2023 := lbrack assign const_or_range_expression rbrack
                                  -> {range: $3}

@profiles: ["sv_2023"]
nonconsecutive_repetition := nonconsecutive_repetition_sv_2023
                          -> {body: $1}

nonrange_select := ( ( dot member_identifier bit_select )* dot member_identifier )? bit_select
                -> {member_chain: $1, bits: $2}

nonrange_variable_lvalue := ( implicit_class_handle dot | package_scope | class_scope )? hierarchical_variable_identifier nonrange_select
                         -> {scope: $1, name: $2, select: $3}

notifier := variable_identifier
         -> {body: $1}

