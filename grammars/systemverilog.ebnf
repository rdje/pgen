# (SV-0030 fix, SV-DOLLAR-LRM-FIDELITY.3): scalar_constant carries the ten IEEE
# 1364-2005 / 1800-2017 A.7.5.3 alternatives (1'b0 | 1'b1 | 1'B0 | 1'B1 | 'b0 | 'b1 |
# 'B0 | 'B1 | 1 | 0). The bare 1/0 branches carry a !tick follow-guard so a rhs like
# 1'bx / 1'b01 (not a scalar_constant) falls back to the flat bare-expression branch
# of scalar_timing_check_condition instead of committing a partial match.
scalar_constant := kw_n_1_tick_b0_cc597d72 -> {kind: "1'b0"}
                | kw_n_1_tick_b1_a5c2b78e -> {kind: "1'b1"}
                | kw_n_1_tick_B0_720c4a9c -> {kind: "1'B0"}
                | kw_n_1_tick_B1_afad66cc -> {kind: "1'B1"}
                | kw_tick_b0_624cb09b     -> {kind: "'b0"}
                | kw_tick_b1_1c5be368     -> {kind: "'b1"}
                | kw_tick_B0_f33e35dd     -> {kind: "'B0"}
                | kw_tick_B1_230dd583     -> {kind: "'B1"}
                | kw_n_1_356a192b !tick   -> {kind: "1"}
                | kw_n_0_b6589fc6 !tick   -> {kind: "0"}

# (SV-0030 fix, SV-DOLLAR-LRM-FIDELITY.3): the compare-form lhs. A full `expression`
# lhs is PEG-greedy — its operand chain consumes `== scalar_constant` itself, so the
# eq/case_eq/ne/case_ne branches below could never match. This chain reuses
# expression_operand but restricts the operator tier to the operators that bind
# TIGHTER than equality (IEEE 1800-2017 Table 11-2), so the lhs stops exactly where
# the LRM compare form begins and `a & b == 1'b0` (where == binds tighter than &)
# still falls back to the precedence-correct flat expression parse.
scalar_timing_check_compare_chain := expression_operand ( binary_operator_above_equality attribute_instance* expression_operand )*
                                  -> {kind: "operand_chain", first: $1, rest: $2}

scalar_timing_check_compare_lhs := scalar_timing_check_compare_chain
                                -> {kind: "base", body: $1}

# (SV-0030 fix, SV-DOLLAR-LRM-FIDELITY.3): the IEEE compare forms precede the bare
# expression branch (they are language-redundant with it, so they must win the PEG
# ordered choice to ever emit their typed shapes). Each carries a !binary_operator
# follow-guard: if anything expression-continuable follows the scalar_constant
# (e.g. `e == 1'b0 && f`), the compare branch withdraws and the flat expression
# branch consumes the whole condition exactly as before. The tilde branch stays
# after `expression` deliberately: promoting it would mis-associate `~e && f` as
# ~(e && f); the flat parse is the precedence-correct AST for those inputs.
scalar_timing_check_condition := scalar_timing_check_compare_lhs equal scalar_constant !binary_operator          -> {kind: "eq",      lhs: $1, rhs: $3}
                               | scalar_timing_check_compare_lhs case_equal scalar_constant !binary_operator     -> {kind: "case_eq", lhs: $1, rhs: $3}
                               | scalar_timing_check_compare_lhs not_equal scalar_constant !binary_operator      -> {kind: "ne",      lhs: $1, rhs: $3}
                               | scalar_timing_check_compare_lhs case_not_equal scalar_constant !binary_operator -> {kind: "case_ne", lhs: $1, rhs: $3}
                               | expression                                                                      -> {kind: "expression", body: $1}
                               | tilde expression                                                                -> {kind: "not",        body: $2}

select := ( ( dot member_identifier !lparen bit_select )* dot member_identifier !lparen )? ( select_tail )?
