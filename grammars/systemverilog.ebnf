                          | kw_PATHPULSE_dollar_specify_input_terminal_descriptor_dollar_specify_output_terminal_descriptor_b3eb892a assign lparen reject_limit_value ( comma error_limit_value )? rparen
                                  -> {kind: "input_output",   reject: $4, error: $5}

pulsestyle_declaration := kw_pulsestyle_onevent_11e408b6 list_of_path_outputs semi
                                -> {kind: "onevent",   outputs: $2}
                        | kw_pulsestyle_ondetect_90d0b4fa list_of_path_outputs semi
                                -> {kind: "ondetect",  outputs: $2}

# VERILOG-2005-PROFILE.6.10 (SV-0034) — the queue dimension (`[$]` / `[$:N]`) is SystemVerilog-only
# (IEEE 1800 §7.10); IEEE 1364-2005 has no queues. Whole-rule @profiles gate — single-carrier SV-only
# rule, referenced only from variable_dimension's queue alt; the sv_2017/sv_2023 tree (and AST) is
# unchanged. Whole-rule gate idiom, cf. unsized_dimension (.6.9) / uniqueness_constraint.
