@profiles: ["sv_2017", "sv_2023"]
scoped_package_parameter_identifier := non_typedef_package_scope parameter_identifier -> {scope: $1, name: $2}

ps_parameter_identifier := class_scope parameter_identifier                                                                         -> {kind: "class_scope", scope: $1, name: $2}
                        | scoped_package_parameter_identifier                                                                       -> {kind: "package_scope", body: $1}
                        | known_unscoped_parameter_identifier                                                                       -> {kind: "unscoped", body: $1}
                        | ( generate_block_identifier ( lbrack constant_expression rbrack )? dot )* parameter_identifier            -> {kind: "generate_scoped", scope_chain: $1, name: $2}

@profiles: ["sv_2017"]
ps_type_identifier_sv_2017 := ( kw_local_939bb46a scope_resolution kw_n_43_0286dd55 | non_typedef_package_scope | class_scope )? type_identifier
                           -> {scope: $1, name: $2}

@profiles: ["sv_2023"]
