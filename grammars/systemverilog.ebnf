class_constructor_declaration_sv_2017 := kw_function_c218e39e ( class_scope )? kw_new_c2a6b03f ( lparen ( tf_port_list )? rparen )? semi block_item_declaration* ( kw_super_8451ba8a dot kw_new_c2a6b03f ( lparen list_of_arguments rparen )? semi )? function_statement_or_null* kw_endfunction_84b8f967 ( colon kw_new_c2a6b03f )?
                                      -> {class_scope: $2, ports: $4, decls: $6, super_call: $7, statements: $8, end_label: $10}

@profiles: ["sv_2023"]
class_constructor_declaration_sv_2023 := kw_function_c218e39e ( class_scope )? kw_new_c2a6b03f ( lparen ( class_constructor_arg_list )? rparen )? semi block_item_declaration* ( kw_super_8451ba8a dot kw_new_c2a6b03f ( lparen ( class_constructor_super_args )? rparen )? semi )? function_statement_or_null* kw_endfunction_84b8f967 ( colon kw_new_c2a6b03f )?
                                      -> {class_scope: $2, ports: $4, decls: $6, super_call: $7, statements: $8, end_label: $10}

class_constructor_super_args := kw_default_7505d64a  -> {kind: "default"}
                              | list_of_arguments    -> {kind: "args",    body: $1}

@profiles: ["sv_2017", "sv_2023"]
class_constructor_declaration := class_constructor_declaration_sv_2017 -> {kind: "sv_2017", body: $1}
                               | class_constructor_declaration_sv_2023 -> {kind: "sv_2023", body: $1}

@profiles: ["sv_2017"]
class_constructor_prototype_sv_2017 := kw_function_c218e39e kw_new_c2a6b03f ( lparen ( tf_port_list )? rparen )? semi
