@profiles: ["sv_2017", "sv_2023"]
property_expr := property_expr_sv_2017 -> {kind: "sv_2017", body: $1}
               | property_expr_sv_2023 -> {kind: "sv_2023", body: $1}

property_formal_type := kw_property_269fe373   -> {kind: "property"}
                      | sequence_formal_type   -> {kind: "sequence", body: $1}

property_identifier := declaration_identifier

@emit_fact: { kind: property_name, name: $body, declaration_family: property }
@predicate: { name: has_fact, args: [property_name, $body], phase: post }
declared_property_identifier := property_identifier -> { body: $1.body }

property_instance := ps_or_hierarchical_property_identifier ( lparen ( property_list_of_arguments )? rparen )?
                  -> {name: $1, args: $2}

property_named_arg := dot non_keyword_identifier lparen ( property_actual_arg )? rparen -> {name: $2, value: $4}
# SV-CORPUS-GRAD.13c.2s: the `!dot` guard is the SAME starving-star repair as `system_tf_call`,
# in the property family. IEEE 1800-2017 A.2.10 writes `property_list_of_arguments ::=
# [ property_actual_arg ] { , [ property_actual_arg ] } { , . identifier ( [ property_actual_arg ] ) }` —
# ordered arguments, THEN named ones. Spelled with a bare `( comma ( property_actual_arg )? )*` the
# greedy star ate the comma introducing the first NAMED argument, its inner optional matched EMPTY
# (a named argument starts with `.`, and no `property_actual_arg` can — measured: `.b(2)` and `.b` both
# REJECT as `property_actual_arg`, with `a+1` accepting as the control), and the named-argument star
# then needed a comma and saw `.`.
# ⛔ DEMONSTRATED AT SOURCE LEVEL, unlike the `let` sibling: `pr(a ##1 b, .q(d))` — a property
# instance whose positional argument only `property_actual_arg` can parse, followed by a named one —
# goes REJECT -> ACCEPT. The general `list_of_arguments` route rescues a mixed list only while every
# positional argument is ALSO a plain expression; when one is not, both routes fail and the
# construct is unparseable.
# ⛔ ABOVE the rule, never between its alternatives — see the note on `system_tf_call`.
property_list_of_arguments := property_named_arg ( comma property_named_arg )*
                                    -> {kind: "named_only", items: [$1, $2::2*]}
                            | ( property_actual_arg )? ( comma !dot ( property_actual_arg )? )* ( comma property_named_arg )*
                                    -> {kind: "mixed",      head: $1, ordered_tail: [$2::2*], named_tail: [$3::2*]}

property_lvar_port_direction := kw_input_140f86aa
                             -> {kind: "input"}

property_port_item := attribute_instance* ( kw_local_939bb46a ( property_lvar_port_direction )? )? property_formal_type formal_port_identifier variable_dimension* ( assign property_actual_arg )?
                   -> {attributes: $1, local_direction: $2, formal_type: $3, name: $4, dims: $5, default: $6}

property_port_list := property_port_item ( comma property_port_item )*
                   -> [$1, $2::2*]

property_qualifier := random_qualifier     -> {kind: "random",                body: $1}
                    | class_item_qualifier  -> {kind: "class_item_qualifier", body: $1}

@profiles: ["sv_2017", "sv_2023"]
