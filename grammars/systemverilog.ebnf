# === SV-EXH-PROOF.3.3.4.b.6.1.1 — semantic-store fact-kind schema (DECLARE stage) ===
# These `@fact_kind:` declarations register the grammar's fact schema in the
# universal semantic store. They bind to the following rule syntactically but
# take effect globally (collected into the per-grammar fact-kind registry).
#   - `type_name`: the EXISTING type-name fact emitted at class / interface_class
#     / covergroup / typedef / type_parameter sites. Declared `exportable: true`
#     so the `package_declaration` `@export_to_library` keeps exporting it for
#     cross-file (veer) type visibility — once any `@fact_kind:` is declared,
#     export is schema-governed (SV-EXH-PROOF.3.3.4.b.5.3) and an undeclared
#     `type_name` would silently stop exporting.
#   - `variable_binding` / `type_binding`: NEW kinds for the context-aware
#     method-call disambiguation (uvm `if(a.b.c(x))`). Producers wired in the
#     `.b.6.1.2` / `.b.6.1.3` sub-leaves; `type_ref` populated in `.b.6.1.4`.
@fact_kind: { name: type_name, attributes: [declaration_family], exportable: true, description: "A declared type name; declaration_family records class / interface_class / covergroup / typedef / type_parameter." }
@fact_kind: { name: variable_binding, attributes: [type_kind, type_ref], description: "A declared variable or data object with its resolved type kind, emitted at data_declaration sites." }
@fact_kind: { name: type_binding, attributes: [type_kind, type_ref], description: "A declared type (class or typedef) with its resolved type kind, emitted at class and typedef sites." }
# SV-PARSE-STRICT.2: marker that an (unresolved) wildcard package import
# `import pkg::*;` is in scope. Emitted on the wildcard `package_import_item`
# branch (a branch-start `@emit_fact`, INLINE-ACTIONS.2). The `net_declaration`
# `nt a;` alias branch consults it so the parser accepts an otherwise-undeclared
# net-type identifier ONLY when it cannot prove it undeclared (an open wildcard
# import could supply the nettype) — sound-not-complete parse-time gating;
# cross-unit resolution is elaboration's job.
@fact_kind: { name: wildcard_import_open, attributes: [package], description: "An unresolved wildcard package import (`pkg::*`) is in scope; gates sound parse-time acceptance of undeclared net-type identifiers." }
data_declaration := data_declaration_sv_2017 -> {kind: "sv_2017", body: $1}
                  | data_declaration_sv_2023 -> {kind: "sv_2023", body: $1}

data_event := timing_check_event
           -> {body: $1}

data_source_expression := expression
                       -> {body: $1}

# SV-EXH-PROOF.3.3.3: route use-site type-id through checked_type_identifier.
known_unscoped_block_type_identifier := checked_type_identifier packed_dimension*
                                     -> {type: $1, dims: $2}

# SV-AST-SHAPE-FIDELITY.2.3 — named-lift of the shared scoped-type-identifier scope prefix
# so the bare `scope: $1` in `scoped_block_type_identifier` / `scoped_data_type_identifier`
# binds a clean named rule instead of an inline alternation (which corrupted the positional
# model → `type`/`dims` `<invalid_sequence_access>` when the self-annotated `class_scope`
# branch won, e.g. `C::D::E v;`). The alt occurs ONLY at these two byte-identical rules, so
# ONE shared rule fixes both — the `.1` `ansi_port_header` / `.2.1` `forward_type_keyword`
# named-lift precedent.
@profiles: ["sv_2017", "sv_2023"]
scoped_type_scope_prefix := class_scope | non_typedef_package_scope

@profiles: ["sv_2017", "sv_2023"]
scoped_block_type_identifier := scoped_type_scope_prefix type_identifier packed_dimension*
                             -> {scope: $1, type: $2, dims: $3}

# SV-EXH-PROOF.3.3.3: route use-site type-id through checked_type_identifier.
known_unscoped_data_type_identifier := checked_type_identifier packed_dimension*
                                    -> {type: $1, dims: $2}

@profiles: ["sv_2017", "sv_2023"]
scoped_data_type_identifier := scoped_type_scope_prefix type_identifier packed_dimension*
                            -> {scope: $1, type: $2, dims: $3}

@predicate: { name: has_fact, args: [type_name, $head.body], phase: post, view: shaped }
@predicate: { name: lacks_fact_attribute_equals, args: [type_name, $head.body, declaration_family, typedef], phase: post, view: shaped }
known_unscoped_block_class_type := class_identifier ( parameter_value_assignment )? ( scope_resolution class_identifier ( parameter_value_assignment )? )*
                                -> {head: $1, params: $2, scope_chain: $3}

@predicate: { name: has_fact, args: [type_name, $head.body], phase: post, view: shaped }
provisional_unscoped_block_class_type := class_identifier ( parameter_value_assignment )? ( scope_resolution class_identifier ( parameter_value_assignment )? )*
                                      -> {head: $1, params: $2, scope_chain: $3}

@profiles: ["sv_2017", "sv_2023"]
scoped_block_class_type := non_typedef_package_scope class_identifier ( parameter_value_assignment )? ( scope_resolution class_identifier ( parameter_value_assignment )? )*
                        -> {scope: $1, head: $2, params: $3, scope_chain: $4}

@predicate: { name: fact_attribute_equals, args: [type_name, $body, declaration_family, covergroup], phase: post }
known_unscoped_covergroup_type_identifier := covergroup_identifier

@profiles: ["sv_2017", "sv_2023"]
scoped_covergroup_type_identifier := non_typedef_package_scope covergroup_identifier -> {scope: $1, name: $2}

known_unscoped_block_covergroup_identifier := known_unscoped_covergroup_type_identifier

@profiles: ["sv_2017", "sv_2023"]
scoped_block_covergroup_identifier := scoped_covergroup_type_identifier

block_data_type := integer_vector_type ( signing )? packed_dimension*
                -> {base: $1, signing: $2, dims: $3}
                 | integer_atom_type ( signing )?
                 | non_integer_type
                 | @sample: "struct { int a; }" struct_union ( kw_packed_7aca22de ( signing )? )? lbrace struct_union_member struct_union_member* rbrace packed_dimension*
                 | @sample: "enum { A }" kw_enum_e338e8e3 ( enum_base_type )? lbrace enum_name_declaration ( comma enum_name_declaration )* rbrace packed_dimension*
                 | kw_string_ecb25204
                 | kw_chandle_34401c13
                 | kw_virtual_af84d91f ( kw_interface_5ea2d81a )? interface_identifier ( parameter_value_assignment )? ( dot modport_identifier )?
                 | scoped_block_type_identifier
                 | known_unscoped_block_type_identifier
                 | scoped_block_class_type
                 | known_unscoped_block_class_type
                 | provisional_unscoped_block_class_type
                 | kw_event_5006ed02
                 | scoped_block_covergroup_identifier
                 | known_unscoped_block_covergroup_identifier
                 | type_reference

block_data_type_or_implicit := block_data_type    -> {kind: "block_data",     body: $1}
                              | implicit_data_type -> {kind: "implicit_data", body: $1}

data_type := @probe_sample: "int" integer_vector_type ( signing )? packed_dimension*
                  -> {kind: "integer_vector",        base: $1, signing: $2, dims: $3}
           | integer_atom_type ( signing )?
                  -> {kind: "integer_atom",          base: $1, signing: $2}
           | non_integer_type
                  -> {kind: "non_integer",           base: $1}
           | @sample: "struct { int a; }" struct_union ( kw_packed_7aca22de ( signing )? )? lbrace struct_union_member struct_union_member* rbrace packed_dimension*
                  -> {kind: "struct_union",         header: $1, packed_signing: $2, members: {first: $4, rest: $5}, dims: $7}
           | @sample: "enum { A }" kw_enum_e338e8e3 ( enum_base_type )? lbrace enum_name_declaration ( comma enum_name_declaration )* rbrace packed_dimension*
                  -> {kind: "enum",                  base_type: $2, names: [$4, $5::2*], dims: $7}
           | kw_string_ecb25204
                  -> {kind: "string"}
           | kw_chandle_34401c13
                  -> {kind: "chandle"}
           | kw_virtual_af84d91f ( kw_interface_5ea2d81a )? interface_identifier ( parameter_value_assignment )? ( dot modport_identifier )?
                  -> {kind: "virtual_interface",     interface_keyword: $2, name: $3, params: $4, modport: $5}
           | scoped_data_type_identifier
                  -> {kind: "scoped_data_type",      body: $1}
           | known_unscoped_data_type_identifier
                  -> {kind: "known_unscoped_data_type", body: $1}
           | class_type
                  -> {kind: "class_type",            body: $1}
           # SV-EXH-PROOF.5.2.4.1 — use the typedef-EXCLUDING sibling here, not the
           # permissive `provisional_unscoped_block_class_type`. The provisional rule
           # is gated only by `has_fact(type_name, head)`, so a plain `typedef int T`
           # head passed even with a `::P` scope_chain — making `localparam int Y = T::P`
           # wrongly parseable (T::P is invalid per IEEE 1800 when T is not a class/
           # package; sv_semantic_scope_contract case `parameter_typedef_fail`).
           # `known_unscoped_block_class_type` adds the correct
           # `lacks_fact_attribute_equals(type_name, head, declaration_family, typedef)`
           # gate (same `{head, params, scope_chain}` shape, so the emitted
           # `provisional_class_type` AST kind is unchanged). Bare typedef-as-datatype
           # `T x;` is unaffected (it matches `known_unscoped_data_type_identifier`
           # above). `block_data_type` keeps the permissive `provisional_*` branch for
           # class-internal scoped types. Per [[feedback_grammar_rules_must_consult_store]].
           | known_unscoped_block_class_type
                  -> {kind: "provisional_class_type", body: $1}
           | kw_event_5006ed02
                  -> {kind: "event"}
           | ps_covergroup_identifier
                  -> {kind: "covergroup",            body: $1}
           | type_reference
                  -> {kind: "type_reference",        body: $1}

data_type_or_implicit := data_type          -> {kind: "data_type",     body: $1}
                       | implicit_data_type -> {kind: "implicit",       body: $1}

@profiles: ["sv_2023"]
data_type_or_incomplete_class_scoped_type_sv_2023 := data_type                     -> {kind: "data_type",            body: $1}
                                                   | incomplete_class_scoped_type  -> {kind: "incomplete_class_scoped", body: $1}

@profiles: ["sv_2023"]
data_type_or_incomplete_class_scoped_type := data_type_or_incomplete_class_scoped_type_sv_2023
                                           -> {body: $1}

# VERILOG-2005-PROFILE.6.8 (SV-0032): `void` is categorically absent from IEEE 1364-2005
# (§10.4 return types; nowhere in Annex A), so its SV-only surface is lifted into a
# profile-gated named rule (the established `_sv_only` idiom, cf. `delay_value_sv_only`).
# Bare pass-through reference keeps the sv_2017/sv_2023 AST byte-identical; the gate makes
# `void` reject under `verilog_2005`.
@profiles: ["sv_2017", "sv_2023"]
data_type_or_void_sv_only := kw_void_e9cede9b -> {kind: "void"}

data_type_or_void := data_type                 -> {kind: "data_type", body: $1}
                   | data_type_or_void_sv_only

default_clause := kw_default_7505d64a
               -> {kind: "default"}

default_skew := kw_input_140f86aa clocking_skew
                      -> {kind: "input",       skew: $2}
              | kw_output_1029d676 clocking_skew
                      -> {kind: "output",      skew: $2}
              | kw_input_140f86aa clocking_skew kw_output_1029d676 clocking_skew
                      -> {kind: "input_output", input_skew: $2, output_skew: $4}

deferred_immediate_assert_statement := kw_assert_64b5daad hash kw_n_0_b6589fc6 lparen expression rparen action_block
                                            -> {kind: "zero_delay", expression: $5, action: $7}
                                     | kw_assert_64b5daad kw_final_d594c2cc lparen expression rparen action_block
                                            -> {kind: "final",      expression: $4, action: $6}

@profiles: ["sv_2017", "sv_2023"]
deferred_immediate_assertion_item := ( block_identifier colon )? deferred_immediate_assertion_statement
                                  -> {label: $1, body: $2}

@profiles: ["sv_2017", "sv_2023"]
deferred_immediate_assertion_statement := deferred_immediate_assert_statement -> {kind: "assert", body: $1}
                                        | deferred_immediate_assume_statement -> {kind: "assume", body: $1}
                                        | deferred_immediate_cover_statement  -> {kind: "cover",  body: $1}

deferred_immediate_assume_statement := kw_assume_661e458e hash kw_n_0_b6589fc6 lparen expression rparen action_block
                                            -> {kind: "zero_delay", expression: $5, action: $7}
                                     | kw_assume_661e458e kw_final_d594c2cc lparen expression rparen action_block
                                            -> {kind: "final",      expression: $4, action: $6}

deferred_immediate_cover_statement := kw_cover_a28100fa hash kw_n_0_b6589fc6 lparen expression rparen statement_or_null
                                            -> {kind: "zero_delay", expression: $5, statement: $7}
                                    | kw_cover_a28100fa kw_final_d594c2cc lparen expression rparen statement_or_null
                                            -> {kind: "final",      expression: $4, statement: $6}

defparam_assignment := hierarchical_parameter_identifier assign constant_mintypmax_expression
                    -> {name: $1, value: $3}

@profiles: ["sv_2017", "verilog_2005"]
delay_sv_2017 := @probe_sample: "#1" hash delay_value                                                                                                  -> {kind: "value", body: $2}
              | hash lparen mintypmax_expression ( comma mintypmax_expression ( comma mintypmax_expression )? )? rparen                              -> {kind: "triple_optional", first: $3, rest: $4}
              | hash lparen mintypmax_expression ( comma mintypmax_expression )? rparen                                                              -> {kind: "pair_optional", first: $3, second: $4}

@profiles: ["sv_2023"]
delay_sv_2023 := hash delay_value                                                                                                                      -> {kind: "value", body: $2}
              | hash lparen mintypmax_expression ( comma mintypmax_expression )? rparen                                                              -> {kind: "pair_optional", first: $3, second: $4}
              | hash lparen mintypmax_expression ( comma mintypmax_expression ( comma mintypmax_expression )? )? rparen                              -> {kind: "triple_optional", first: $3, rest: $4}

delay := delay_sv_2017 -> {body: $1}
       | delay_sv_2023 -> {body: $1}

delay_control := hash delay_value                          -> {kind: "value",    body: $2}
               | hash lparen mintypmax_expression rparen   -> {kind: "mintypmax", body: $3}

delay_or_event_control := delay_control                                                  -> {kind: "delay",  body: $1}
                        | event_control                                                  -> {kind: "event",  body: $1}
                        | kw_repeat_c0ac4842 lparen expression rparen event_control      -> {kind: "repeat", count: $3, control: $5}

@profiles: ["sv_2017", "sv_2023"]
delay_value_sv_only := time_literal        -> {kind: "time_literal",    body: $1}
                     | kw_n_1step_e6d37e7c -> {kind: "step"}

delay_value := unsigned_number     -> {kind: "unsigned_number", body: $1}
             | real_number         -> {kind: "real_number",     body: $1}
             | ps_identifier       -> {kind: "ps_identifier",   body: $1}
             | delay_value_sv_only

delayed_data := terminal_identifier                                            -> {kind: "simple",    name: $1}
              | terminal_identifier ( constant_mintypmax_expression )?         -> {kind: "with_expr", name: $1, expr: $2}

delayed_reference := terminal_identifier                                       -> {kind: "simple",    name: $1}
                   | terminal_identifier ( constant_mintypmax_expression )?    -> {kind: "with_expr", name: $1, expr: $2}

@profiles: ["sv_2017", "sv_2023"]
description_unit_item_sv_only := attribute_instance* package_item -> {kind: "package_item", attributes: $1, body: $2}

description := module_declaration                 -> {kind: "module_declaration", body: $1}
             | udp_declaration                    -> {kind: "udp_declaration", body: $1}
             | interface_declaration              -> {kind: "interface_declaration", body: $1}
             | program_declaration                -> {kind: "program_declaration", body: $1}
             | package_declaration                -> {kind: "package_declaration", body: $1}
             | description_unit_item_sv_only
             | attribute_instance* bind_directive -> {kind: "bind_directive", attributes: $1, body: $2}
             | config_declaration                 -> {kind: "config_declaration", body: $1}

design_statement := kw_design_056f1182 ( ( library_identifier dot )? cell_identifier )* semi
                 -> {cells: $2}

disable_statement := kw_disable_ccf09e2d hierarchical_task_identifier semi
                          -> {kind: "task",  target: $2}
                   | kw_disable_ccf09e2d hierarchical_block_identifier semi
                          -> {kind: "block", target: $2}
                   | kw_disable_ccf09e2d kw_fork_3f673f2a semi
                          -> {kind: "fork"}

@profiles: ["sv_2017"]
dist_item_sv_2017 := value_range ( dist_weight )?
                  -> {value: $1, weight: $2}

@profiles: ["sv_2023"]
dist_item_sv_2023 := value_range ( dist_weight )?
                          -> {kind: "value", value: $1, weight: $2}
                   | kw_default_7505d64a colon slash expression
                          -> {kind: "default", weight: $4}

@profiles: ["sv_2017", "sv_2023"]
dist_item := dist_item_sv_2017 -> {kind: "sv_2017", body: $1}
           | dist_item_sv_2023 -> {kind: "sv_2023", body: $1}

@profiles: ["sv_2017", "sv_2023"]
dist_list := dist_item ( comma dist_item )*
          -> [$1, $2::2*]

dist_weight := colon assign expression -> {kind: "equal",       weight: $3}
             | colon slash expression  -> {kind: "proportional", weight: $3}

dpi_function_import_property := kw_context_ec2727b3 -> {kind: "context"}
                              | kw_pure_afe003f1    -> {kind: "pure"}

@profiles: ["sv_2017", "sv_2023"]
dpi_function_proto := function_prototype
                   -> {body: $1}

@profiles: ["sv_2017", "sv_2023"]
dpi_import_export := kw_import_62fdfbd5 dpi_spec_string ( dpi_function_import_property )? ( c_identifier assign )? dpi_function_proto semi
                            -> {kind: "import_function", spec: $2, property: $3, c_alias: $4, proto: $5}
                  | kw_import_62fdfbd5 dpi_spec_string ( dpi_task_import_property )? ( c_identifier assign )? dpi_task_proto semi
                            -> {kind: "import_task",     spec: $2, property: $3, c_alias: $4, proto: $5}
                  | kw_export_51713409 dpi_spec_string ( c_identifier assign )? kw_function_c218e39e function_identifier semi
                            -> {kind: "export_function", spec: $2, c_alias: $3, name: $5}
                  | kw_export_51713409 dpi_spec_string ( c_identifier assign )? kw_task_7fbb727d task_identifier semi
                            -> {kind: "export_task",     spec: $2, c_alias: $3, name: $5}

dpi_spec_string := trivia /"DPI-C"/   -> {kind: "DPI-C"}
                 | trivia /"DPI"/     -> {kind: "DPI"}

dpi_task_import_property := kw_context_ec2727b3
                         -> {kind: "context"}

@profiles: ["sv_2017", "sv_2023"]
dpi_task_proto := task_prototype
               -> {body: $1}

# IEEE 1800-2017 A.8.6 (A.2.2.2) — a drive strength is ALWAYS one `strength0` and one
# `strength1` (in either order), or a strength/highz mix where the `highz` takes the
# OPPOSITE digit. Same-digit pairs like `(strong1, strong1)` are a syntax error (verilator
# `t_strength_strong1_strong1_bad`); modelling `strength0`/`strength1` separately — rather
# than a single permissive `strength` — is what keeps that negative rejecting
# (SV-CORPUS-GRAD.3.7). `kw_highz0`/`kw_highz1` are referenced directly (the highz value is
# not carried in the node, matching the pre-existing dead rule's shape).
drive_strength := lparen strength0 comma strength1 rparen  -> {kind: "pair_strength",  first: $2, second: $4}
               | lparen strength1 comma strength0 rparen  -> {kind: "pair_strength",  first: $2, second: $4}
               | lparen strength0 comma kw_highz1 rparen  -> {kind: "strength_highz", first: $2}
               | lparen strength1 comma kw_highz0 rparen  -> {kind: "strength_highz", first: $2}
               | lparen kw_highz0 comma strength1 rparen  -> {kind: "highz_strength", second: $4}
               | lparen kw_highz1 comma strength0 rparen  -> {kind: "highz_strength", second: $4}

dynamic_array_new := kw_new_c2a6b03f lbrack expression rbrack ( lparen expression rparen )?
                  -> {size: $3, init: $5}

dynamic_array_variable_identifier := variable_identifier

@profiles: ["sv_2023"]
dynamic_override_specifiers_sv_2023 := ( initial_or_extends_specifier )? ( final_specifier )?
                                    -> {initial_or_extends: $1, final: $2}

@profiles: ["sv_2023"]
dynamic_override_specifiers := dynamic_override_specifiers_sv_2023
                            -> {body: $1}

edge_control_specifier := kw_edge_a0f2c69a ( edge_descriptor ( comma edge_descriptor )* )?
                       -> {descriptors: $2}

edge_descriptor := kw_n_01_ddfe1633        -> {kind: "01"}
                 | kw_n_10_b1d57811        -> {kind: "10"}
                 | z_or_x zero_or_one      -> {kind: "z_or_x_first", z: $1, digit: $2}
                 | zero_or_one z_or_x      -> {kind: "digit_first",  digit: $1, z: $2}

edge_identifier := kw_posedge_7529558b -> {kind: "posedge"}
                 | kw_negedge_c77fbc5c -> {kind: "negedge"}
                 | kw_edge_a0f2c69a    -> {kind: "edge"}

edge_indicator := lparen level_symbol level_symbol rparen   -> {kind: "pair",   first: $2, second: $3}
                | edge_symbol                                -> {kind: "symbol", body: $1}

edge_input_list := level_symbol* edge_indicator level_symbol*
                -> {leading_levels: $1, indicator: $2, trailing_levels: $3}

edge_sensitive_path_declaration := parallel_edge_sensitive_path_description assign path_delay_value
                                          -> {kind: "parallel", path: $1, delay: $3}
                                 | full_edge_sensitive_path_description assign path_delay_value
                                          -> {kind: "full",     path: $1, delay: $3}

edge_symbol := kw_r_4dc7c9ec -> {kind: "r"}
             | kw_R_06576556 -> {kind: "R"}
             | kw_f_4a0a1921 -> {kind: "f"}
             | kw_F_e69f20e9 -> {kind: "F"}
             | kw_p_516b9783 -> {kind: "p"}
             | kw_P_511993d3 -> {kind: "P"}
             | kw_n_d1854cae -> {kind: "n"}
             | kw_N_b51a6073 -> {kind: "N"}
             | star          -> {kind: "star"}

@profiles: ["sv_2023"]
elaboration_severity_system_task_sv_2023 := severity_system_task
                                         -> {body: $1}

@profiles: ["sv_2023"]
elaboration_severity_system_task := elaboration_severity_system_task_sv_2023
                                 -> {body: $1}

@profiles: ["sv_2017"]
elaboration_system_task_sv_2017 := kw_sv_dollar_fatal_ecc3c9fd ( lparen finish_number ( comma list_of_arguments )? rparen )? semi
                                          -> {kind: "fatal",   args: $2}
                                 | kw_sv_dollar_error_d304cf0a ( lparen ( list_of_arguments )? rparen )? semi
                                          -> {kind: "error",   args: $2}
                                 | kw_sv_dollar_warning_22a41474 ( lparen ( list_of_arguments )? rparen )? semi
                                          -> {kind: "warning", args: $2}
                                 | kw_sv_dollar_info_d116cb1c ( lparen ( list_of_arguments )? rparen )? semi
                                          -> {kind: "info",    args: $2}

@profiles: ["sv_2017"]
elaboration_system_task := elaboration_system_task_sv_2017
                        -> {body: $1}

# IEEE 1800-2017 A.8.1 (+ footnote 35, + §7.10 prose):
#   empty_unpacked_array_concatenation35 ::= { }
#   35) "{ } shall denote an empty unpacked array concatenation, as described in
#       10.10, and shall not be used in any other form of concatenation."
#   §7.10: "The empty queue can be denoted by an empty unpacked array
#       concatenation {}."
#
# ONE ARM — the LRM production, and nothing else. (SV-CORPUS-GRAD.3.26e: this header
# used to read "TWO ARMS … do not collapse them", which .3.26c's re-modelling left
# behind; it contradicted the ⭐ paragraph 10 lines below in the same block.)
#
# `lbrace rbrace` is the LRM production, verbatim. SV-CORPUS-GRAD.3.26 restored it:
# it had never been accepted. History — SV-EXH-PROOF.3.3.4.b.6.2.37.8 replaced a
# genuinely broken body (`lbrace epsilon rbrace`, where `epsilon` is undefined in
# this grammar, so the rule could never match) and that half was right; but it wrote
# the replacement literal as `'{ }` and cited "§A.6.7". The production is at A.8.1
# and reads `{ }`. Because its motivating input (uvm's `return '{};`) genuinely uses
# the apostrophe form, the citation error reproduced as a SUCCESS and went unread.
#
# ⭐ THIS RULE IS NOW PURE A.8.1 — the bare-brace form ONLY. The apostrophe form `'{ }`
# is LEGAL SV (see below) but it is NOT this production: it is an `assignment_pattern`
# whose ELEMENT LIST IS EMPTY, and it is modelled there (director 2026-08-10:
# *"the inside of '{...} can be empty. this need to be properly capture in the EBNF"*).
# SV-CORPUS-GRAD.3.26c moved it. Modelling it here as a second arm was expedient and
# wrong: it made `'{}` a kind of *concatenation* when the standard's own notation
# (§11.4.12) calls `'{ }` the delimiter of a structure/array LITERAL, and it gave the
# empty case an AST node no assignment-pattern consumer would look for.
#
# ⛔ DO NOT re-add a `tick lbrace rbrace` arm here. `'{}` acceptance is preserved via
# assignment_pattern -> assignment_pattern_expression, reachable at every site this
# rule is (primary, constant_primary via constant_assignment_pattern_expression, and
# the two lvalue sites) — verified by parse before the move.
#
# The apostrophe form is LEGAL and must keep parsing — ⛔ do not "fix" it away.
# Annex A's four assignment_pattern alternatives each require >= 1 expression, so the
# PRODUCTIONS do not derive `'{ }`. That is an ANNEX GAP, not a prohibition, and this
# grammar has two other measured instances of the same class (`q[a:$]` licensed by
# A.8.4 footnote 42 — SV-CORPUS-GRAD.3.25; `use #(...)` written 7 times in clause
# 33.4.3 but absent from Annex A's use_clause — .3.19). See the Knowledge-Map card
# annex-a-footnotes-license-derivations-the-productions-cannot-derive.
#
# What the standard actually says, searched across 1800-2017 and 1800-2023:
#   - §11.4.12: "structure and array literals are enclosed in braces that begin with
#     an apostrophe ( '{ } )" — the LRM writes the delimiter pair itself as `'{ }`.
#   - Annex M/VPI: `#define vpiAssignmentPatternOp 75 /* '{} assignment pattern */`.
#   - NO text anywhere declares `'{}` illegal or unsupported.
# uvm-core writes `return '{};` (uvm_lru_cache.svh:206,:273); 49 corpus files use it.
#
# ⚠️ SV-CORPUS-GRAD.3.26a DELETED this arm on the claim that it was "non-LRM
# over-acceptance". That claim was never read in the LRM — it was INFERRED from
# non-derivability, which is exactly the inference this project had already refuted
# twice. Director ruling 2026-08-10 reverted it; see the BOUNDING RULING section of
# feedback_sv_strict_lrm_compliance_default. "non-LRM" requires a CITATION, never an
# inference.
#
# ⛔ Comments stay OUTSIDE the rule body: a column-0 comment between alternatives
# DELETES the alternatives that follow it (project_standing_tripwires).
empty_unpacked_array_concatenation := lbrace rbrace
                                   -> {kind: "empty_unpacked_array_concat"}

enable_gate_instance := ( name_of_instance )? lparen output_terminal comma input_terminal comma enable_terminal rparen
                     -> {name: $1, output: $3, input: $5, enable: $7}

# SV-CORPUS-GRAD.13c.2q: the LRM writes FOUR alternatives and every one carries a trailing digit —
# `enable_gatetype ::= bufif0 | bufif1 | notif0 | notif1` (IEEE 1364-2005 Annex A A.3.4,
# IEEE 1800-2017 §28 / A.3.4, IEEE 1800-2023 Annex A — identical in all three, so no `@profiles`).
# The extraction collapsed each pair to its alphabetic STEM and dropped the digit, leaving
# `/bufif\b/` and `/notif\b/`, which can never match `bufif0`: `\b` demands a word boundary and `0`
# is a word character. ⇒ this whole alternative of `gate_instantiation` was unmatchable, and every
# `bufif0 g(o,i,e);` in the corpus was parsing as a UDP INSTANTIATION whose type name is a reserved
# keyword — an over-acceptance (`.13c.2k`) that was load-bearing for a construct nothing else reached.
enable_gatetype := kw_bufif0_e58d9bd3 -> {kind: "bufif0"}
                | kw_bufif1_a2b83a3e -> {kind: "bufif1"}
                | kw_notif0_2c8df148 -> {kind: "notif0"}
                | kw_notif1_245fe7ea -> {kind: "notif1"}

enable_terminal := expression
                -> {body: $1}

end_edge_offset := mintypmax_expression
                -> {body: $1}

enum_base_type := integer_atom_type ( signing )?
                       -> {kind: "atom",       base: $1, signing: $2}
                | integer_vector_type ( signing )? ( packed_dimension )?
                       -> {kind: "vector",     base: $1, signing: $2, dim: $3}
                | type_identifier ( packed_dimension )?
                       -> {kind: "type_alias", name: $1, dim: $2}

enum_identifier := declaration_identifier

enum_name_declaration := enum_identifier ( lbrack integral_number ( colon integral_number )? rbrack )? ( assign constant_expression )?
                      -> {name: $1, range: $2, value: $3}

error_limit_value := limit_value
                  -> {body: $1}

event_based_flag := constant_expression
                 -> {body: $1}

@profiles: ["sv_2017", "verilog_2005"]
event_control_sv_2017 := at_sign hierarchical_event_identifier        -> {kind: "event",       body: $2}
                       | at_sign lparen event_expression rparen        -> {kind: "expression",  body: $3}
                       | at_sign star                                  -> {kind: "wildcard"}
                       | at_sign attr_open rparen                      -> {kind: "wildcard_alt"}
                       | at_sign ps_or_hierarchical_sequence_identifier -> {kind: "sequence",    body: $2}

@profiles: ["sv_2023"]
event_control_sv_2023 := clocking_event           -> {kind: "clocking",     body: $1}
                       | at_sign star              -> {kind: "wildcard"}
                       | at_sign lparen star rparen -> {kind: "wildcard_paren"}

event_control := event_control_sv_2017 -> {kind: "sv_2017", body: $1}
               | event_control_sv_2023 -> {kind: "sv_2023", body: $1}

event_expression_primary := ( edge_identifier )? expression ( kw_iff_ee1c009e expression )?
                                  -> {kind: "expression", edge: $1, expr: $2, iff: $3}
                          | sequence_instance ( kw_iff_ee1c009e expression )?
                                  -> {kind: "sequence",   body: $1, iff: $2}
                          | lparen event_expression rparen
                                  -> {kind: "paren",      body: $2}

event_expression := event_expression_primary ( ( kw_or_1758356d | comma ) event_expression_primary )*
                 -> [$1, $2::2*]

# SV-OVER-REJECTION-FIDELITY.3 / ledger SV-0023 — IEEE 1800 §15.5 + A.6.5 event triggers.
#   `->` is the BLOCKING named-event trigger (§15.5.3); `->>` is the NONBLOCKING trigger (§15.5.4)
#   and is the ONLY form that carries the optional [ delay_or_event_control ]. IEEE 1800-2017 A.6.5:
#   `-> hei ;` | `->> [ delay_or_event_control ] hei ;` (no select). IEEE 1800-2023 Annex A: each
#   alternative gains a trailing nonrange_select. IEEE 1364-2005 (verilog_2005_lrm_extracted.ebnf
#   :370-371): `-> hei { [ expression ] } ;` — bracket array-selects, no `->>`. The prior encoding
#   had no `->>` token (nonblocking unsupported), mis-attached the control to a second `->` branch
#   (`-> #5 e;` over-accepted), SWAPPED the consumer-visible blocking/non_blocking labels, and shared
#   the sv_2017 rule with verilog_2005 (no array-select → `-> e[0];` rejected under 1364-2005).
@profiles: ["sv_2017", "sv_2023"]
nonblocking_implies := trivia "->>"           -> {kind: "nonblocking_implies"}

@profiles: ["sv_2017"]
event_trigger_sv_2017 := nonblocking_implies ( delay_or_event_control )? hierarchical_event_identifier semi
                              -> {kind: "non_blocking", control: $2, name: $3}
                       | implies hierarchical_event_identifier semi
                              -> {kind: "blocking",     name: $2}

@profiles: ["sv_2023"]
event_trigger_sv_2023 := nonblocking_implies ( delay_or_event_control )? hierarchical_event_identifier nonrange_select semi
                              -> {kind: "non_blocking", control: $2, name: $3, select: $4}
                       | implies hierarchical_event_identifier nonrange_select semi
                              -> {kind: "blocking",     name: $2, select: $3}

@profiles: ["verilog_2005"]
event_trigger_verilog_2005 := implies hierarchical_event_identifier bit_select semi
                              -> {kind: "blocking",     name: $2, select: $3}

event_trigger := event_trigger_sv_2017      -> {kind: "sv_2017",      body: $1}
               | event_trigger_sv_2023      -> {kind: "sv_2023",      body: $1}
               | event_trigger_verilog_2005 -> {kind: "verilog_2005", body: $1}

@profiles: ["sv_2017", "sv_2023"]
expect_property_statement := kw_expect_ff93c451 lparen property_spec rparen action_block
                          -> {spec: $3, action: $5}

# SV-EXH-PROOF.3.3.4.b.6.2.37.7 — per IEEE 1800 §A.6.6:
#   cond_predicate ::= expression_or_cond_pattern { &&& expression_or_cond_pattern }
#   expression_or_cond_pattern ::= expression | cond_pattern
# The LRM uses `expression` (not `expression_base`). pgen had `expression_base`
# directly here, which BYPASSED `expression`'s outer alternation
# `expression := expression_base | inside_expression`. The consequence:
# `if (x inside {…})` failed because cond_predicate couldn't reach
# `inside_expression`.
# CONSERVATIVE FIX (after a more invasive `expression_base → expression`
# replacement caused a uvm_pkg furthest regression 1,278,335 → 191,248
# during in-slice verification): KEEP `expression_base` as the first branch
# (preserves the existing parse priority that the rest of the grammar
# depends on transitively) and ADD `inside_expression` as a sibling
# alternative so cond_predicate also reaches it directly. Surfaced by
# `.37.6`'s 1,278,335 furthest at uvm_root::die where
# `if (get_core_state() inside {UVM_CORE_PRE_ABORT,UVM_CORE_ABORTED})`
# was unparseable.
expression_or_cond_pattern := inside_expression -> {kind: "inside",       body: $1}
                            | expression_base   -> {kind: "expression",   body: $1}
                            | cond_pattern      -> {kind: "cond_pattern", body: $1}

# IEEE 1800-2017 A.2.10: `expression_or_dist ::= expression [ dist { dist_list } ]`.
# ⛔ The `{ }` around `dist_list` are LITERAL SystemVerilog braces, not BNF repetition —
# two lines above them, `dist_list ::= dist_item { , dist_item }` uses the SAME characters
# as repetition metasyntax, and that collision is what the earlier `dist_list*` rendering
# fell into (SV-CORPUS-GRAD.3.18, the seventh instance of the dropped-delimiter class and
# the third in A.2.10 alone). The LRM settles it in its own prose and examples: §18.5.4
# writes `x dist {100 := 1, 200 := 2, 300 := 5}` and §18.5.11 `soft x dist {5, 8};`.
# The `*` retires with it — `dist_list` already carries its own `( comma dist_item )*`.
expression_or_dist := @probe_sample: "1" expression ( kw_dist_02450072 lbrace dist_list rbrace )?
                   -> {expr: $1, dist: $2}

@profiles: ["sv_2017"]
extern_constraint_declaration_sv_2017 := ( kw_static_a381562a )? kw_constraint_9f454fd4 class_scope constraint_identifier constraint_block
                                      -> {static_keyword: $1, scope: $3, name: $4, body: $5}

@profiles: ["sv_2023"]
extern_constraint_declaration_sv_2023 := ( kw_static_a381562a )? kw_constraint_9f454fd4 ( dynamic_override_specifiers )? class_scope constraint_identifier constraint_block
                                      -> {static_keyword: $1, dynamic_override: $3, scope: $4, name: $5, body: $6}

@profiles: ["sv_2017", "sv_2023"]
extern_constraint_declaration := extern_constraint_declaration_sv_2017 -> {kind: "sv_2017", body: $1}
                               | extern_constraint_declaration_sv_2023 -> {kind: "sv_2023", body: $1}

@profiles: ["sv_2017", "sv_2023"]
extern_tf_declaration := kw_extern_bf1ee311 method_prototype semi
                                  -> {kind: "method",   prototype: $2}
                       | kw_extern_bf1ee311 kw_forkjoin_91d67e81 task_prototype semi
                                  -> {kind: "forkjoin", prototype: $3}

@profiles: ["sv_2017", "sv_2023"]
final_construct := kw_final_d594c2cc function_statement
                -> {body: $2}

@profiles: ["sv_2023"]
final_specifier_sv_2023 := colon kw_final_d594c2cc
                        -> {kind: "final"}

@profiles: ["sv_2023"]
final_specifier := final_specifier_sv_2023
                -> {body: $1}

finish_number := kw_n_0_b6589fc6 -> {kind: "0"}
               | kw_n_1_356a192b -> {kind: "1"}
               | kw_n_2_da4b9237 -> {kind: "2"}

for_initialization := list_of_variable_assignments
                              -> {kind: "assignments",  body: $1}
                    | for_variable_declaration ( comma for_variable_declaration )*
                              -> {kind: "declarations", items: [$1, $2::2*]}

for_step := for_step_assignment ( comma for_step_assignment )*
         -> [$1, $2::2*]

for_step_assignment := operator_assignment   -> {kind: "operator_assignment", body: $1}
                     | inc_or_dec_expression -> {kind: "inc_or_dec",          body: $1}
                     | function_subroutine_call -> {kind: "function_call",    body: $1}

for_variable_declaration := ( kw_var_e5b4e786 )? data_type variable_identifier assign expression ( comma variable_identifier assign expression )*
                         -> {var_keyword: $1, data_type: $2, name: $3, value: $5, tail: $6}

// formal_identifier := declaration_identifier

formal_port_identifier := declaration_identifier

@profiles: ["sv_2023"]
forward_type_sv_2023 := kw_enum_e338e8e3                            -> {kind: "enum"}
                      | kw_struct_d118e5a3                          -> {kind: "struct"}
                      | kw_union_67ad5a07                           -> {kind: "union"}
                      | kw_class_8d767bf5                           -> {kind: "class"}
                      | kw_interface_5ea2d81a kw_class_8d767bf5     -> {kind: "interface_class"}

@profiles: ["sv_2023"]
forward_type := forward_type_sv_2023
             -> {body: $1}

@profiles: ["sv_2017", "verilog_2005"]
full_edge_sensitive_path_description_sv_2017 := lparen ( edge_identifier )? list_of_path_inputs ( polarity_operator )? full_path_arrow lparen list_of_path_outputs ( polarity_operator )? colon data_source_expression rparen rparen
                                             -> {edge: $2, inputs: $3, in_polarity: $4, outputs: $7, out_polarity: $8, data_source: $10}

@profiles: ["sv_2023"]
full_edge_sensitive_path_description_sv_2023 := lparen ( edge_identifier )? list_of_path_inputs ( polarity_operator )? full_path_arrow lparen list_of_path_outputs ( polarity_operator )? colon data_source_expression rparen rparen
                                                      -> {kind: "with_data_source", edge: $2, inputs: $3, in_polarity: $4, outputs: $7, out_polarity: $8, data_source: $10}
                                              | lparen ( edge_identifier )? list_of_path_inputs ( polarity_operator )? full_path_arrow list_of_path_outputs rparen
                                                      -> {kind: "simple",           edge: $2, inputs: $3, in_polarity: $4, outputs: $6}

full_edge_sensitive_path_description := full_edge_sensitive_path_description_sv_2017 -> {kind: "sv_2017", body: $1}
                                       | full_edge_sensitive_path_description_sv_2023 -> {kind: "sv_2023", body: $1}

full_path_description := lparen list_of_path_inputs ( polarity_operator )? full_path_arrow list_of_path_outputs rparen
                      -> {inputs: $2, polarity: $3, outputs: $5}

function_body_declaration := @sample: "int f; endfunction : f" function_data_type_or_implicit function_identifier semi tf_item_declaration* function_statement_or_null* kw_endfunction_84b8f967 ( colon function_identifier )?
                          -> {return_type: $1, name: $2, items: $4, statements: $5, end_label: $7}
                           | @sample: "int f(); endfunction : f" function_data_type_or_implicit function_identifier lparen ( tf_port_list )? rparen semi block_item_declaration* function_statement_or_null* kw_endfunction_84b8f967 ( colon function_identifier )?
                           | function_data_type_or_implicit ( interface_identifier dot | class_scope ) function_identifier semi tf_item_declaration* function_statement_or_null* kw_endfunction_84b8f967 ( colon function_identifier )?
                           | function_data_type_or_implicit ( interface_identifier dot | class_scope ) function_identifier lparen ( tf_port_list )? rparen semi block_item_declaration* function_statement_or_null* kw_endfunction_84b8f967 ( colon function_identifier )?

function_data_type_or_implicit := data_type_or_void   -> {kind: "data_type", body: $1}
                                | implicit_data_type  -> {kind: "implicit",  body: $1}

@profiles: ["sv_2017", "verilog_2005"]
function_declaration_sv_2017 := kw_function_c218e39e ( lifetime )? function_body_declaration
                             -> {lifetime: $2, body: $3}

@profiles: ["sv_2023"]
function_declaration_sv_2023 := kw_function_c218e39e ( dynamic_override_specifiers )? ( lifetime )? function_body_declaration
                             -> {dynamic_override: $2, lifetime: $3, body: $4}

function_declaration := function_declaration_sv_2017 -> {kind: "sv_2017", body: $1}
                      | function_declaration_sv_2023 -> {kind: "sv_2023", body: $1}

function_identifier := declaration_identifier

@profiles: ["sv_2017"]
function_prototype_sv_2017 := kw_function_c218e39e data_type_or_void function_identifier ( lparen ( tf_port_list )? rparen )?
                           -> {return_type: $2, name: $3, ports: $4}

@profiles: ["sv_2023"]
function_prototype_sv_2023 := kw_function_c218e39e ( dynamic_override_specifiers )? data_type_or_void function_identifier ( lparen ( tf_port_list )? rparen )?
                           -> {dynamic_override: $2, return_type: $3, name: $4, ports: $5}

@profiles: ["sv_2017", "sv_2023"]
function_prototype := function_prototype_sv_2017 -> {kind: "sv_2017", body: $1}
                    | function_prototype_sv_2023 -> {kind: "sv_2023", body: $1}

function_statement := statement
                   -> {body: $1}

function_statement_or_null := function_statement       -> {kind: "statement", body: $1}
                            | attribute_instance* semi -> {kind: "null",      attributes: $1}

function_subroutine_call := call_primary
                                  -> {kind: "call_primary", body: $1}
                          | ( kw_std_55ec981f scope_resolution )? randomize_call
                                  -> {kind: "randomize",    std_prefix: $1, body: $2}

@profiles: ["sv_2017", "verilog_2005"]
gate_instantiation_sv_2017 := cmos_switchtype ( delay )? cmos_switch_instance ( comma cmos_switch_instance )* semi
                                   -> {kind: "cmos",     switchtype: $1, delay: $2, instances: [$3, $4::2*]}
                            | enable_gatetype ( drive_strength )? ( delay )? enable_gate_instance ( comma enable_gate_instance )* semi
                                   -> {kind: "enable",   gatetype: $1, drive_strength: $2, delay: $3, instances: [$4, $5::2*]}
                            | mos_switchtype ( delay )? mos_switch_instance ( comma mos_switch_instance )* semi
                                   -> {kind: "mos",      switchtype: $1, delay: $2, instances: [$3, $4::2*]}
                            | n_input_gatetype ( drive_strength )? ( delay )? n_input_gate_instance ( comma n_input_gate_instance )* semi
                                   -> {kind: "n_input",  gatetype: $1, drive_strength: $2, delay: $3, instances: [$4, $5::2*]}
                            | n_output_gatetype ( drive_strength )? ( delay )? n_output_gate_instance ( comma n_output_gate_instance )* semi
                                   -> {kind: "n_output", gatetype: $1, drive_strength: $2, delay: $3, instances: [$4, $5::2*]}
                            | pass_en_switchtype ( delay )? pass_enable_switch_instance ( comma pass_enable_switch_instance )* semi
                                   -> {kind: "pass_en",  switchtype: $1, delay: $2, instances: [$3, $4::2*]}
                            | pass_switchtype pass_switch_instance ( comma pass_switch_instance )* semi
                                   -> {kind: "pass",     switchtype: $1, instances: [$2, $3::2*]}
                            | kw_pulldown_20560243 ( pulldown_strength )? pull_gate_instance ( comma pull_gate_instance )* semi
                                   -> {kind: "pulldown", strength: $2, instances: [$3, $4::2*]}
                            | kw_pullup_f7402b53 ( pullup_strength )? pull_gate_instance ( comma pull_gate_instance )* semi
                                   -> {kind: "pullup",   strength: $2, instances: [$3, $4::2*]}

@profiles: ["sv_2023"]
gate_instantiation_sv_2023 := cmos_switchtype ( delay )? cmos_switch_instance ( comma cmos_switch_instance )* semi
                                   -> {kind: "cmos",     switchtype: $1, delay: $2, instances: [$3, $4::2*]}
                            | mos_switchtype ( delay )? mos_switch_instance ( comma mos_switch_instance )* semi
                                   -> {kind: "mos",      switchtype: $1, delay: $2, instances: [$3, $4::2*]}
                            | enable_gatetype ( drive_strength )? ( delay )? enable_gate_instance ( comma enable_gate_instance )* semi
                                   -> {kind: "enable",   gatetype: $1, drive_strength: $2, delay: $3, instances: [$4, $5::2*]}
                            | n_input_gatetype ( drive_strength )? ( delay )? n_input_gate_instance ( comma n_input_gate_instance )* semi
                                   -> {kind: "n_input",  gatetype: $1, drive_strength: $2, delay: $3, instances: [$4, $5::2*]}
                            | n_output_gatetype ( drive_strength )? ( delay )? n_output_gate_instance ( comma n_output_gate_instance )* semi
                                   -> {kind: "n_output", gatetype: $1, drive_strength: $2, delay: $3, instances: [$4, $5::2*]}
                            | pass_en_switchtype ( delay )? pass_enable_switch_instance ( comma pass_enable_switch_instance )* semi
                                   -> {kind: "pass_en",  switchtype: $1, delay: $2, instances: [$3, $4::2*]}
                            | pass_switchtype pass_switch_instance ( comma pass_switch_instance )* semi
                                   -> {kind: "pass",     switchtype: $1, instances: [$2, $3::2*]}
                            | kw_pulldown_20560243 ( pulldown_strength )? pull_gate_instance ( comma pull_gate_instance )* semi
                                   -> {kind: "pulldown", strength: $2, instances: [$3, $4::2*]}
                            | kw_pullup_f7402b53 ( pullup_strength )? pull_gate_instance ( comma pull_gate_instance )* semi
                                   -> {kind: "pullup",   strength: $2, instances: [$3, $4::2*]}

gate_instantiation := gate_instantiation_sv_2017 -> {kind: "sv_2017", body: $1}
                    | gate_instantiation_sv_2023 -> {kind: "sv_2023", body: $1}

generate_block_identifier := non_keyword_identifier

generate_item := module_or_generate_item    -> {kind: "module_or_generate_item",    body: $1}
               | interface_or_generate_item -> {kind: "interface_or_generate_item", body: $1}
               | checker_or_generate_item   -> {kind: "checker_or_generate_item",   body: $1}

generate_region := kw_generate_9e59d425 generate_item* kw_endgenerate_efb1f00a
                -> {items: $2}

genvar_declaration := kw_genvar_9cb2eb8a list_of_genvar_identifiers semi
                   -> {items: $2}

genvar_expression := constant_expression
                  -> {body: $1}

# SV-0035 (SV-KEYWORD-PRIMARY-FIDELITY.2): keyword-exclude the genvar-name carrier
# (the `constant_primary` alternative right after `specparam_identifier`, where the
# leak would otherwise move). Shape-preserving `{body:X}`.
genvar_identifier := non_keyword_identifier

genvar_initialization := ( kw_genvar_9cb2eb8a )? genvar_identifier assign constant_expression
                      -> {genvar_keyword: $1, name: $2, value: $4}

genvar_iteration := genvar_identifier assignment_operator genvar_expression
                         -> {kind: "assign",         name: $1, op: $2, value: $3}
                  | inc_or_dec_operator genvar_identifier
                         -> {kind: "prefix_inc_dec", op: $1, name: $2}
                  | genvar_identifier inc_or_dec_operator
                         -> {kind: "postfix_inc_dec", name: $1, op: $2}

goto_repetition := lbrack implies const_or_range_expression rbrack
                -> {range: $3}

hierarchical_array_identifier := hierarchical_identifier

hierarchical_block_identifier := hierarchical_identifier

hierarchical_btf_identifier := hierarchical_tf_identifier
                                    -> {kind: "tf",     body: $1}
                             | hierarchical_block_identifier
                                    -> {kind: "block",  body: $1}
                             | ( hierarchical_identifier dot | class_scope )? method_identifier
                                    -> {kind: "method", scope: $1, name: $2}

hierarchical_event_identifier := hierarchical_identifier

# SV-0029 wave-3 (SV-DOLLAR-LRM-FIDELITY.4): the `$root.` anchor is IEEE 1800-only
# (§3.12 / A.9.3) — Verilog-2005 hierarchical names have no `$root` — so the prefix
# is lifted into a profile-gated named rule (the established `_sv_only` idiom, cf.
# `delay_value_sv_only`). The lift returns a `{kind: "root"}` marker: downstream
# consumers see the LRM anchor explicitly in the `root:` field (null when absent).
@profiles: ["sv_2017", "sv_2023"]
hierarchical_root_prefix_sv_only := kw_sv_dollar_root_f65f0e67 dot
                                 -> {kind: "root"}

# SV-0035 (SV-KEYWORD-PRIMARY-FIDELITY.2): the trailing name segment is keyword-excluded
# so a reserved type keyword can no longer match as a bare non-constant `primary`
# hierarchical name (`assign w = integer;`). A hierarchical name segment can never be a
# reserved word, so this is universally correct; shape-preserving (`name` stays `{body:X}`).
hierarchical_identifier := ( hierarchical_root_prefix_sv_only )? ( non_keyword_identifier constant_bit_select dot )* non_keyword_identifier
                        -> {root: $1, scope: $2, name: $3}

hierarchical_instance := name_of_instance lparen ( list_of_port_connections )? rparen
                     -> {name: $1, connections: $3}

hierarchical_net_identifier := hierarchical_identifier

hierarchical_parameter_identifier := hierarchical_identifier

hierarchical_property_identifier := hierarchical_identifier

hierarchical_sequence_identifier := hierarchical_identifier

hierarchical_task_identifier := hierarchical_identifier

hierarchical_tf_identifier := hierarchical_root_prefix_sv_only ( non_keyword_identifier constant_bit_select dot )* callable_identifier
                                                                                                                       -> {kind: "rooted", scope_chain: $2, name: $3}
                           | non_keyword_identifier constant_bit_select dot ( non_keyword_identifier constant_bit_select dot )* callable_identifier
                                                                                                                       -> {kind: "anchored", head: $1, head_select: $2, scope_chain: $4, name: $5}

hierarchical_variable_identifier := hierarchical_identifier

identifier_list := non_keyword_identifier ( comma non_keyword_identifier )*
                -> [$1, $2::2*]

if_generate_construct := kw_if_958f57f5 lparen constant_expression rparen generate_block ( if_generate_else_clause )?
                      -> {condition: $3, then_block: $5, else_clause: $6}

if_generate_else_clause := kw_else_ae050f5b if_generate_construct -> {kind: "elseif",     body: $2}
                         | kw_else_ae050f5b generate_block        -> {kind: "else_block", body: $2}

@profiles: ["sv_2017", "sv_2023"]
immediate_assertion_statement := simple_immediate_assertion_statement   -> {kind: "simple",   body: $1}
                               | deferred_immediate_assertion_statement -> {kind: "deferred", body: $1}

implicit_class_handle := kw_this_c2543fff                                -> {kind: "this"}
                       | kw_super_8451ba8a                               -> {kind: "super"}
                       | kw_this_c2543fff dot kw_super_8451ba8a          -> {kind: "this_super"}

implicit_data_type := ( signing )? packed_dimension*
                   -> {signing: $1, dims: $2}

import_export := kw_import_62fdfbd5 -> {kind: "import"}
               | kw_export_51713409 -> {kind: "export"}

@profiles: ["sv_2017", "sv_2023"]
inc_or_dec_expression := inc_or_dec_operator attribute_instance* variable_lvalue
                              -> {kind: "prefix",  op: $1, attributes: $2, lvalue: $3}
                       | variable_lvalue attribute_instance* inc_or_dec_operator
                              -> {kind: "postfix", lvalue: $1, attributes: $2, op: $3}

inc_or_dec_operator := plus_plus    -> {kind: "plus_plus"}
                     | minus_minus  -> {kind: "minus_minus"}

include_statement := kw_include_d3ecb0d8 kw_file_path_spec_c26c9dc9 semi
                  -> {path: $2}

@profiles: ["sv_2023"]
incomplete_class_scoped_type_sv_2023 := type_identifier scope_resolution type_identifier_or_class_type
                                              -> {kind: "head",      head: $1, tail: $3}
                                      | incomplete_class_scoped_type scope_resolution type_identifier_or_class_type
