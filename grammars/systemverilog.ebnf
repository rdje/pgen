                          | constant_cast
                                  -> {kind: "cast",             body: $1}
                          | constant_assignment_pattern_expression
                                  -> {kind: "assign_pattern",   body: $1}
                          | type_reference
                                  -> {kind: "type_reference",   body: $1}
                          | kw_null_2be88ca4
                                  -> {kind: "null"}

