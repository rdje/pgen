# ===================================================================
# systemverilog.ebnf
# ===================================================================
# Active profile-aware IEEE 1800 SystemVerilog grammar.
#
# This file is the promoted single-file grammar used by the normal HDL
# flow. It carries the clause-derived dual-profile surface for:
#   - sv_2017 from docs/systemverilog/2017/md/section-41-data-read-api.md
#   - sv_2023 from docs/systemverilog/2023/md/section-Annex_A-normative-formal-syntax.md
#
# 2026-04-25 REFACTOR — RECONNECTION OF UNREACHABLE SUBGRAPHS
# ----------------------------------------------------------
# This grammar has been refactored to make the SystemVerilog EBNF a
# connected fanout tree where every defined rule is reachable from a
# top-level entry, while remaining IEEE 1800-2017/2023 compliant and
# LRM-faithful. Before the refactor, sv_syntax_closure_gate flagged
# 101 unreachable rules and 115 distinct unreachable branch debt
# entries. After the refactor: 1 unreachable rule (LRM mutual-
# recursion budget case for module_path_conditional_expression) and
# 0 actionable branch debt entries.
#
# RECONNECTIONS APPLIED
# ---------------------
# (1) Numeric chain
#     - integral_number, real_number, unsigned_number carry clean
#       single-regex LRM-faithful definitions (PGEN-SV-EXH-PROOF-0021,
#       .3.2 Strategy 1); `number` dispatches real_number / integral_number.
#     - HISTORICAL: the earlier decomposed-number subgraph (the binary/
#       octal/decimal/hex base/digit/value/tail rules, the *_number
#       aliases, size, exp, sign, fixed_point_number, non_zero_* and
#       their private single-character kw_* digit/base tokens) was
#       SEVERED by Strategy 1's regex consolidation and left as harmless
#       orphans. Those 48 dead useless symbols were REMOVED at source by
#       GRAMMAR-WELLFORMED.H.12.1 (the SV cert-coverage UNKNOWN->0 drive;
#       Hopcroft-Ullman reduced-grammar requirement; the
#       systemverilog_syntax_closure_contract.json drift-policy "delete
#       the orphan" path) - the regex H.10.1 / svpp trivia / vhdl
#       white_space dead-rule-removal precedent.
#
# (2) sv_multi_entry_root — synthetic multi-entry root
#     - Union of systemverilog_file, library_text, and
#       systemverilog_parseable_file.
#     - This is a closure-gate analysis aid that lets the gate's
#       single-entry static reachability analyzer see all three real
#       top-level entries at once. The runtime parser does NOT use it
#       as an entry; sv_parser/runtime code paths still use
#       systemverilog_file or systemverilog_parseable_file directly.
#     - Long-term tooling fix: extend ast_pipeline --entry-rule and
#       the closure-gate contract to accept a list of entries; once
#       that lands, sv_multi_entry_root can be removed.
#
# (3) Library subgraph
#     - library_text, library_description, library_declaration,
#       include_statement and helper kw_* tokens are reachable via
#       sv_multi_entry_root.
#
# (4) Parseable lane
#     - systemverilog_parseable_file, parseable_source_item are
#       reachable via sv_multi_entry_root.
#
# (5) Path-delay widening — IEEE 1800 specify-block compliance
#     - list_of_path_delay_expressions widened to LRM 5 alternatives:
#         (a) t_path_delay_expression
#         (b) trise, tfall (2-form)
#         (c) trise, tfall, tz (3-form)
#         (d) t01, t10, t0z, tz1, t1z, tz0 (6-form edge transitions)
#         (e) t01..tzx (12-form full edge matrix)
#     - Previously narrowed to alt (a) only; now full LRM coverage.
#
# (6) Triple-quoted string — SV 2023 compliance
#     - string_literal extended to also match """..."""  literals.
#     - Pragmatic compliance fix; the LRM string-escape rule chain
#       in the extracted grammar references broken helper kw_* tokens
#       (see RETIRED below), so wiring it would not actually parse
#       triple-quoted strings.
#
# (7) `| epsilon` cleanup in select / constant_select
#     - Replaced "( A | B | epsilon )" with "( A | B )?" in both
#       rules. Same accepted language, no reference to a non-existent
#       epsilon rule. Removes 2 unreachable-branch-debt entries.
#
# FORMERLY-KEPT UNREACHABLE BUDGET CASE — RETIRED (H.12.6.1, PGEN-GRAMMAR-WELLFORMED-0111)
# ----------------------------------------------------------------
# - module_path_conditional_expression was previously stranded: its
#   condition referenced module_path_expression, whose first branch
#   was module_path_conditional_expression — an indirect LEFT-RECURSION.
#   The left-recursion eliminator rewrote module_path_expression into
#   module_path_expression_lr_base/_lr_suffix and left
#   module_path_conditional_expression as an UNREFERENCED rewritten
#   seed (no_path; its generated parse fn was defined-but-never-called),
#   and the _lr_suffix reconstruction leaked raw wrapper_specs metadata
#   into the ternary module-path AST. The earlier "RecursionGuard
#   handles it / max_unreachable_rules <= 1 budget case" rationalization
#   was DISPROVEN tools-first. H.12.6.1 makes mpce's condition the
#   non-left-recursive module_path_expression_operand chain (same
#   accepted language per IEEE 1800 A.8.3 — the right-associative
#   ternary reading), so module_path_expression is natively non-left-
#   recursive, module_path_conditional_expression is positively
#   reachable + witnessed, the wrapper_specs leak is gone, and the
#   syntax-closure contract's max_unreachable_rules budget is now 0.
#   No rule is intentionally kept unreachable.
#
# RETIRED LRM RULES (REMOVED FROM THIS GRAMMAR)
# ----------------------------------------------
# The following 35 LRM-extracted rules are intentionally absent from
# this grammar because they offer no functional value:
#
# - LRM comment chain (3): comment, one_line_comment, comment_text
#   Reason: the LRM documents the lexical shape of comments, but
#   tokenization is handled at the trivia layer (line_comment,
#   block_comment, documentation_comment regex). The LRM rules are
#   documentation, not parser productions.
#
# - LRM identifier aliases (4): array_identifier, formal_identifier,
#   covergroup_variable_identifier, identifier_code
#   Reason: superseded by the active hand-rolled identifier
#   disambiguation machinery (declared_*, scoped_*, known_unscoped_*).
#
# - LRM package-scoped aliases (2): ps_class_identifier,
#   ps_or_hierarchical_tf_identifier
#   Reason: superseded by the active scoped_* equivalents.
#
# - DPI literal aliases (2): lit_DPI_C_*, lit_DPI_*
#   Reason: shadowed by manual dpi_spec_string regex.
#
# - Vestigial profile alias (1): non_zero_unsigned_number_sv_2017
#   Reason: after numeric chain reconnection, no longer referenced.
#
# - LRM string-escape chain (12 rules + 3 lit tokens): quoted_string,
#   quoted_string_sv_2023, quoted_string_item,
#   quoted_string_item_sv_2023, triple_quoted_string,
#   triple_quoted_string_sv_2023, triple_quoted_string_item,
#   triple_quoted_string_item_sv_2023, string_escape_seq,
#   string_escape_seq_sv_2023, plus the lit_quoted_*,
#   lit_triple_quoted_*, lit_token_* literal tokens.
#   Reason: the rule chain depends on helper kw_* tokens that the
#   extractor produced as broken regexes matching the literal text of
#   their LRM placeholder names (e.g., kw_any_ASCII_character_*
#   matches the text "any_ASCII_character", not an ASCII character).
#   Wiring these in would not parse any real string. Compliance for
#   triple-quoted strings is achieved through the string_literal
#   regex extension (see (6) above), not through this chain. If/when
#   the extractor is fixed to translate LRM placeholders into proper
#   character-class regexes, this chain can be revisited.
#
# - Broken extractor helper tokens (8): kw_any_ASCII_character_*,
#   kw_except_672fccd7, kw_newline_f6fd7a43, kw_token_08534f33,
#   kw_x_fc9847dc, kw_one_to_three_digit_octal_number_*,
#   kw_one_to_two_digit_hex_number_*
#   Reason: support the broken LRM string-escape chain; retire
#   alongside.
#
# - Stray helper tokens (2): kw_n_14_fa35e192, kw_n_ef7e6794
#   Reason: residual extractor output not referenced by anything kept.
#
# These retired rules remain in the file as `// `-prefixed comments
# so the rationale stays inline with the grammar; they are inert as
# far as the EBNF parser is concerned but discoverable for anyone
# reading the file.
#
# CLOSURE-GATE STATE (post-refactor)
# -----------------------------------
#   defined_rule_count:        1419
#   reachable_rules:           1418
#   unreachable_rules:         1   (module_path_conditional_expression)
#   unreachable_rule_debt:     1   (LRM mutual-recursion budget case)
#   unreachable_branch_debt:   0   distinct entries
#   unreachable_branches:      20  (metric — internal sub-quantifier
#                                   accounting; not actionable debt)
# ===================================================================

# systemverilog.ebnf
#
# Active profile-aware IEEE 1800 SystemVerilog grammar.
#
# This file is the promoted single-file grammar used by the normal HDL flow. It
# keeps stable entry rules (`systemverilog_file`, `systemverilog_parseable_file`)
# and carries the clause-derived dual-profile surface for:
# - `sv_2017` from `docs/systemverilog/2017/md/section-41-data-read-api.md`
# - `sv_2023` from `docs/systemverilog/2023/md/section-Annex_A-normative-formal-syntax.md`
#
# The profile synthesis artifacts remain alongside this file:
# - `systemverilog_lrm_profiled_generated.ebnf`
# - `systemverilog_lrm_profiled_wrapper.ebnf`
#
# The active grammar is flattened into one file because the legacy Perl EBNF
# frontend used in the current HDL pipeline does not expand `include(...)`.

# PROFILE-ALIAS.2: the request-spelling alias map for this grammar's three
# canonical dialect profiles (sv_2017 / sv_2023 / verilog_2005). These are the
# spellings a caller may pass as the requested profile (CLI --profile /
# --grammar-profile, registry, embedding); the generated parser resolves them
# case-insensitively inside set_grammar_profile, and the registry/generation/
# interpreter lanes consult the same compiled map. Declared HERE so the
# spellings are grammar-owned (never engine name-gates).
@profile_alias: { "2017": sv_2017, "ieee1800-2017": sv_2017, "ieee_1800_2017": sv_2017 }
@profile_alias: { "2023": sv_2023, "ieee1800-2023": sv_2023, "ieee_1800_2023": sv_2023 }
@profile_alias: { "1364-2005": verilog_2005, "ieee1364-2005": verilog_2005, "ieee_1364_2005": verilog_2005 }
@branch_policy: priority_first
@priority: [12, 3, 2, 1, 1]
@coverage_target: 4
@critical_path: true
@entry: true
systemverilog_file := trivia source_text trivia
                   -> {type: "systemverilog_file", source_text: $2}

# --- Multi-entry closure-gate analysis aid (NOT a runtime parse entry) ---
# Unions the three real top-level SV entries so the closure-gate static
# reachability analyzer can see the complete reach-set of the grammar.
# Placed AFTER systemverilog_file so parser generation (which defaults to
# the first defined rule) keeps `parse_full_systemverilog_file` as the
# embedding-API entry. Long-term, the closure gate should support a list
# of entries directly so this rule can be removed.
sv_multi_entry_root := systemverilog_file              -> {kind: "systemverilog_file",            body: $1}
                     | library_text                     -> {kind: "library_text",                  body: $1}
                     | systemverilog_parseable_file     -> {kind: "systemverilog_parseable_file", body: $1}

@branch_policy: priority_first
@priority: [20, 6, 4, 2]
systemverilog_parseable_file := trivia parseable_source_item* trivia
                             -> {type: "systemverilog_parseable_file", items: $2}

@branch_policy: priority_first
@priority: [20, 6, 4, 2]
parseable_source_item := semi
                      -> {kind: "semi"}
//                        | package_import_declaration
//                        | timeunits_declaration
//                        | compiler_directive

@branch_policy: priority_first
@priority: [24, 16, 16, 12, 10, 8, 4]
@profiles: ["sv_2017", "sv_2023"]
source_text_item_unit_sv_only := local_parameter_declaration semi -> {kind: "local_parameter_declaration", body: $1}
                               | parameter_declaration semi       -> {kind: "parameter_declaration", body: $1}

source_text_item := description                       -> {kind: "description", body: $1}
                  | source_text_item_unit_sv_only
                  | package_import_declaration         -> {kind: "package_import_declaration", body: $1}
                  | timeunits_declaration              -> {kind: "timeunits_declaration", body: $1}
                  | compiler_directive                 -> {kind: "compiler_directive", body: $1}
# SV-0028 (SV-LRM-SHAPE-FIDELITY.2, 2026-07-04): the former `| semi -> {kind:"semi"}` alternative was
# removed. It was the sole `verilog_2005` accepting path for a stray top-level `;` (IEEE 1364-2005 A.1.2
# `source_text ::= { description }` admits no null/empty item), and was PEG-dead under `sv_2017`/`sv_2023`
# (shadowed by the `description` branch above, which reaches the LRM-legitimate empty package item
# `package_or_generate_item_declaration ::= … | ;` — IEEE 1800-2017 §26 / 2023 Annex A). Removing it makes
# a stray `;` correctly REJECT under `verilog_2005` while leaving the SV-profile empty-item path + AST
# untouched (SV-profile-byte-invariant). See docs/tasks/SV-LRM-SHAPE-FIDELITY.md `.2`.

# Auto-generated by tools/extract_systemverilog_lrm_profiles.py
# Source markdowns:
# - sv_2017: /Users/richarddje/Documents/github/pgen/docs/systemverilog/2017/md/section-41-data-read-api.md
# - sv_2023: /Users/richarddje/Documents/github/pgen/docs/systemverilog/2023/md/section-Annex_A-normative-formal-syntax.md

# Shared lexical foundation

compiler_directive := trivia /`[^\r\n]*/
                   -> $2

# SV-CORPUS-GRAD.3.14b — IN-SCOPE compiler directives.
#
# `compiler_directive` above is an alternative of `source_text_item` and of NOTHING
# ELSE, so a directive is tolerated only at file top level. The same text one line
# lower — inside a module or class body — REJECTS. That asymmetry is the F5 defect
# routed by `.3.13`: `` `default_nettype none `` before `module m;` PASSES and yields
# a `{kind:"compiler_directive"}` node; inside the module it rejects at
# `furthest_position=9` (measured, `artifacts/sv_corpus_grad/ch22_directive_split/repro/`).
#
# ⛔ THE FIX IS A WHITELIST, NOT `compiler_directive` ITSELF, and the two reasons are
# both defect classes this repo has already paid for:
#
#   (a) PLACEMENT IS NOT UNIFORM ACROSS CLAUSE 22. Read directive by directive, the
#       clause forbids FOUR names inside a design element, and reusing the blanket
#       `` `[^\r\n]* `` rule would have widened acceptance into every one of them —
#       an over-acceptance REGRESSION dressed as a burn-down
#       (feedback_sv_strict_lrm_compliance_default: over-acceptance is a defect,
#       tolerance is additive). The parser already refuses all four and is RIGHT to.
#   (b) A BACKTICK LINE IS NOT NECESSARILY A DIRECTIVE. `` `MY_MACRO(x) `` at an item
#       position is a §22.13-class text-macro use — an unexpanded PREPROCESSING
#       DEPENDENCY, not honest parser input. A blanket rule swallows the line, drops
#       the items the macro expands to, and turns a correct reject into a silent pass.
#       This is the same conflation `.3.13` found in the adjudicator's directive
#       allowlist (`__FILE__`/`__LINE__` are §22.13 MACROS, not directives).
#
# THE RULE, in one line: tolerate a compiler directive wherever the LRM does not
# restrict its placement AND the directive neither hides nor rewrites the source text
# that follows it. Every name below was read in full in BOTH normative clauses —
# IEEE 1800-2017 clause 22 (`docs/systemverilog/2017/md/section-22-compiler-directives.md`)
# and IEEE 1364-2005 clause 19 (`docs/verilog/2005/md/section-19-compiler-directives.md`)
# — which agree name for name:
#
#   TOLERATED (no placement restriction; leaves the following text intact)
#     `celldefine / `endcelldefine  §22.10 / §19.1   "may appear anywhere in the source description"
#     `undef                        §22.5.2 / §19.3.2  no placement restriction stated
#     `undefineall                  §22.5.3            "may appear anywhere in the source description"  (SV-ONLY — absent from 1364-2005)
#     `timescale                    §22.7  / §19.8    no placement restriction stated
#     `pragma                       §22.11 / §19.10   no placement restriction stated
#     `line                         §22.12 / §19.7    "can be specified anywhere within the … source description"
#
#   KEPT REJECTING — PLACEMENT-RESTRICTED (the parser is the only stage that can
#   enforce these: deciding "was this inside a design element" needs design-element
#   boundaries, i.e. a parse, so it is NOT preprocessor-stage business)
#     `resetall                     §22.3  / §19.6    "illegal … within a design element"
#     `default_nettype              §22.8  / §19.2    "can be used only outside design elements"
#     `unconnected_drive
#     `nounconnected_drive          §22.9  / §19.9    "shall be specified outside the design element declarations"
#     `begin_keywords
#     `end_keywords                 §22.14 / §19.11   "can only be specified outside a design element"
#
#   KEPT REJECTING — TEXT-HIDING / TEXT-REWRITING (the file is not honest parser
#   input; the adjudicator already routes these to `explained_svpp_*`). `` `define ``
#   additionally continues across lines with a trailing `\`, so a single-line carrier
#   would MIS-CONSUME it.
#     `include                      §22.4  / §19.5
#     `define                       §22.5.1 / §19.3.1
#     `ifdef `ifndef `else `elsif `endif   §22.6 / §19.4
#
#   NOT DIRECTIVES AT ALL — §22.13 predefined text MACROS (the `.3.13` ruling)
#     `__FILE__  `__LINE__
#
# ⚠️ `unconnected_drive`/`nounconnected_drive` (§22.9) and `begin_keywords`/
# `end_keywords` (§22.14) are restricted by clause text that the `.3.14a` ruling table
# did not cover — that table enumerated only the routed population's six names. Reading
# the clause end to end, not sampling it, is what kept them out of the whitelist.
#
# Structural note on why this cannot shadow anything: the arms below are the LAST
# alternative of each host rule and every one starts with a backtick, which no other
# alternative of `non_port_module_item` or `class_item` can begin with. Under PEG
# ordered choice a new final alternative fires only where the rule previously FAILED,
# so no currently-accepted input changes shape — the AST-byte-invariance measurement in
# the `.3.14b` leaf confirms this rather than assuming it.
#
# ⚠️ HONEST BOUND (stated, not silently capped): an item-list alternative tolerates a
# directive BETWEEN items, never between two tokens of one statement, and the hosts are
# the module body and the class body — the two the measured population needs. Generate/
# interface/program/package/checker bodies are the stated residue, routed in `.3.14b`.

@profiles: ["sv_2017", "sv_2023"]
in_scope_compiler_directive_sv_only := trivia /`undefineall\b[^\r\n]*/
                                    -> $2

in_scope_compiler_directive := in_scope_compiler_directive_sv_only
                             | trivia /`(?:endcelldefine|celldefine|timescale|pragma|line|undef)\b[^\r\n]*/
                                    -> $2

# GRAMMAR-WELLFORMED.H.12.5.3: the former `comment_only_source_region`
# rule (and its `source_text_item` branch above) was ENGINE-SHADOWED-DEAD.
# The generated layout skipper consumes comments (and whitespace) as
# leading trivia before `source_text_item`'s branches are tried, so a
# comment-only region is always absorbed as layout and the branch never
# fires — a comment-only file parses to an empty `source_text` and no
# `comment_only_source_region` node has ever appeared in any AST
# (probe-confirmed parsed=true/witnessed=false on "//x\n"; 0 occurrences
# across six comment-only / comment-containing inputs). It was removed
# accept-identically per the literal-0 doctrine (the vhdl H.11.4-UNPARK
# `white_space` precedent), together with the now-freed `white_space` rule
# (see the `trivia` adjudication note below).

binary_operator := plus                     -> {kind: "plus"}
                 | minus                    -> {kind: "minus"}
                 | star                     -> {kind: "star"}
                 | slash                    -> {kind: "slash"}
                 | percent                  -> {kind: "percent"}
                 | equal                    -> {kind: "equal"}
                 | not_equal                -> {kind: "not_equal"}
                 | case_equal               -> {kind: "case_equal"}
                 | case_not_equal           -> {kind: "case_not_equal"}
                 | wildcard_equal           -> {kind: "wildcard_equal"}
                 | wildcard_not_equal       -> {kind: "wildcard_not_equal"}
                 | logical_and              -> {kind: "logical_and"}
                 | logical_or               -> {kind: "logical_or"}
                 | power                    -> {kind: "power"}
                 | less_than                -> {kind: "less_than"}
                 | less_equal               -> {kind: "less_equal"}
                 | greater_than             -> {kind: "greater_than"}
                 | greater_equal            -> {kind: "greater_equal"}
                 | bitwise_and              -> {kind: "bitwise_and"}
                 | bitwise_or               -> {kind: "bitwise_or"}
                 | bitwise_xor              -> {kind: "bitwise_xor"}
                 | reduction_xnor_alt       -> {kind: "reduction_xnor_alt"}
                 | reduction_xnor           -> {kind: "reduction_xnor"}
                 | shift_right              -> {kind: "shift_right"}
                 | shift_left               -> {kind: "shift_left"}
                 | arithmetic_shift_right   -> {kind: "arithmetic_shift_right"}
                 | arithmetic_shift_left    -> {kind: "arithmetic_shift_left"}
                 | implies                  -> {kind: "implies"}
                 | iff_arrow                -> {kind: "iff_arrow"}

# (SV-0030 fix, SV-DOLLAR-LRM-FIDELITY.3): the binary operators that bind TIGHTER
# than the equality family (IEEE 1800-2017 Table 11-2 precedence rows 3-7: power,
# mul/div/mod, add/sub, shifts, relational). Used only by
# scalar_timing_check_compare_chain so the compare-form lhs stops before any
# equality/bitwise/logical operator. Alternatives keep binary_operator's relative
# order and per-branch kinds so chain `rest` items are shape-identical to
# expression_base's.
binary_operator_above_equality := plus                     -> {kind: "plus"}
                               | minus                    -> {kind: "minus"}
                               | star                     -> {kind: "star"}
                               | slash                    -> {kind: "slash"}
                               | percent                  -> {kind: "percent"}
                               | power                    -> {kind: "power"}
                               | less_than                -> {kind: "less_than"}
                               | less_equal               -> {kind: "less_equal"}
                               | greater_than             -> {kind: "greater_than"}
                               | greater_equal            -> {kind: "greater_equal"}
                               | shift_right              -> {kind: "shift_right"}
                               | shift_left               -> {kind: "shift_left"}
                               | arithmetic_shift_right   -> {kind: "arithmetic_shift_right"}
                               | arithmetic_shift_left    -> {kind: "arithmetic_shift_left"}

assignment_operator := assign                          -> {kind: "assign"}
                     | plus_assign                     -> {kind: "plus_assign"}
                     | minus_assign                    -> {kind: "minus_assign"}
                     | star_assign                     -> {kind: "star_assign"}
                     | slash_assign                    -> {kind: "slash_assign"}
                     | percent_assign                  -> {kind: "percent_assign"}
                     | and_assign                      -> {kind: "and_assign"}
                     | or_assign                       -> {kind: "or_assign"}
                     | xor_assign                      -> {kind: "xor_assign"}
                     | shift_left_assign               -> {kind: "shift_left_assign"}
                     | shift_right_assign              -> {kind: "shift_right_assign"}
                     | arithmetic_shift_left_assign    -> {kind: "arithmetic_shift_left_assign"}
                     | arithmetic_shift_right_assign   -> {kind: "arithmetic_shift_right_assign"}

constant_expression_operand := unary_operator attribute_instance* constant_primary
                                    -> {kind: "unary",   op: $1, attributes: $2, primary: $3}
                             | constant_primary
                                    -> {kind: "primary", body: $1}

constant_expression := @probe_sample: "1" constant_expression_operand ( binary_operator attribute_instance* constant_expression_operand )* ( question attribute_instance* constant_expression colon constant_expression )?
                    -> {first: $1, rest: $2, ternary: $3}

expression_operand := unary_operator attribute_instance* primary
                            -> {kind: "unary",      op: $1, attributes: $2, primary: $3}
                    | inc_or_dec_expression
                            -> {kind: "inc_or_dec", body: $1}
                    | primary
                            -> {kind: "primary",    body: $1}

expression_base := tagged_union_expression
                        -> {kind: "tagged_union",   body: $1}
                | expression_operand ( binary_operator attribute_instance* expression_operand )*
                        -> {kind: "operand_chain",  first: $1, rest: $2}
                | lparen operator_assignment rparen
                        -> {kind: "paren_op_assign", body: $2}

expression := @probe_sample: "1" expression_base -> {kind: "base",        body: $1}
            | inside_expression                  -> {kind: "inside",      body: $1}
            | conditional_expression             -> {kind: "conditional", body: $1}

identifier := escaped_identifier -> {body: $1}
           | simple_identifier  -> {body: $1}

# SV-EXH-PROOF.3.3.1: raw `-> $2` returns the Alternative-wrapped
# identifier node (positional-extraction codegen lacks the
# Alternative-unwrap arm that implicit-passthrough has), so every
# declared_*_identifier `-> {body:$1.body}` directive routed through
# this rule fails "could not resolve fact name". Reconstruct the
# engine-proven `{body:…}` object (same shape as
# `identifier := simple_identifier -> {body:$1}`) so downstream
# `$1.body` resolves a concrete object, not a bare Alternative.
# ⛔⛔ SV-CORPUS-GRAD.13c.2k — READ THIS BEFORE WRITING `identifier` IN A NEW RULE.
#
# IEEE 1800-2017 A.9.3 writes `identifier ::= simple_identifier | escaped_identifier`, and §5.6.2
# forbids a reserved word (Annex B) from being a `simple_identifier`. **Almost every LRM
# `identifier` position is therefore a NON-KEYWORD identifier position, and spells
# `non_keyword_identifier` here.** Until `-0237` the exclusion was spelled at only some of them:
# 45 sites referenced the raw `identifier` rule and admitted reserved keywords, so a reserved word
# parsed in every NON-FINAL component of a hierarchical path — `ral.module[0].g()`,
# `ral.module.g()` and `module.g()` all ACCEPTED, while the guarded positions `ral.arr[0].module`,
# `ral.arr[0].module()` and `int module;` were correctly refused. The leak was POSITIONAL, not a
# missing keyword, and it was LOAD-BEARING: closing it exposed five latent defects it had been
# masking (`.13c.2q`, `.13c.2r`, `.13c.2t`).
#
# The population is enumerated, not remembered:
# `docs/tasks/artifacts/sv_corpus_grad/raw_identifier_census/census.py` cross-checks the frontend's
# own `raw_ast` against a text scan of this file and refuses if the two disagree. Exactly ONE raw
# `identifier` reference remains, by design — `rooted_tf_call_sv_only`'s `!( identifier )`
# firewall, where guarding would INVERT the lookahead and make that rule strictly MORE permissive.
#
# ⭐⭐ AND THE SHAPE BELOW IS MEASURED, NOT INCIDENTAL — do not "simplify" it. `non_keyword_identifier`
# matches the token ITSELF rather than delegating to `identifier`. Two other spellings of the same
# fix were built and measured over the pinned 192-file parse-cost sample (four arms, `-0236`/`-0237`,
# `docs/tasks/artifacts/sv_corpus_grad/strictness_cost_arms/`, TOOLBOX 3.7b), and both are refused by
# `PARSE-COST-RATCHET`:
#   * exclusion moved INTO `identifier`, this rule a bare alias — `entries` **+1.775 %**. ⛔ That
#     cost is REDIRECTED SPECULATION, not an inlining effect: the generator's own census says the
#     arm changed NEITHER rule's inline decision (see below). Rejecting a keyword does not end a
#     parse, it sends a backtracking engine down further alternatives.
#   * this rule delegating to `identifier` (`:= !reserved_non_keyword_identifier identifier`) —
#     `entries` −0.892 % but `committed` **+0.72 %**, because wrapping adds one COMMITTED FRAME per
#     committed identifier at the 45 rewritten sites.
#   * THIS spelling — `entries` **−1.072 %**, `memo_hits` **−2.407 %**, `committed` **−5.110 %**.
#     All three binding counters FALL, for two separate reasons. (1) THE MEMO BOUNDARY MOVED, and
#     the generator states the mechanism itself rather than it being inferred:
#     `ast_pipeline --report-fusibility-census` prints `INLINE-DECISIONS … duplication_cap`, and a
#     rule is inlined (taking NO memo lookup at all) while its REFERENCE COUNT × BODY SIZE stays
#     under that budget. Moving the 45 references carried both rules across it in opposite
#     directions — `identifier` 47 → 1 refs (over-budget ⇒ memoized → INLINED) and this rule
#     7 → 52 (INLINED → over-budget ⇒ memo-served, 94.5 % hits), so the repeated question is now
#     answered here instead of one level down. (2) NO FRAME IS ADDED ANYWHERE: matching the token
#     directly deletes `identifier`'s committed frame outright (415,534 → 0).
#     ⛔ Re-derive with `docs/tasks/artifacts/sv_corpus_grad/strictness_cost_arms/inline_decision.py`
#     — never from counts of `inlined_frame_call` in the generated parser, which are EMITTED sites
#     after transitive expansion and led this comment to claim a decision change that never
#     happened (corrected under DIRECTOR CHALLENGE, `-0238`).
# ⭐ `escaped_identifier` is deliberately NOT guarded: §5.6.1 makes `\module ` a legal identifier
# distinct from the keyword.
non_keyword_identifier := escaped_identifier -> {body: $1}
                       | !reserved_non_keyword_identifier simple_identifier -> {body: $2}

declaration_identifier := non_keyword_identifier

callable_identifier := non_keyword_identifier

simple_identifier := trivia /[a-zA-Z_][a-zA-Z0-9_$]*/
                  -> $2

# SV-EXH-PROOF.3.3.4.b.6.2.15 — second broken regex (lookahead) fixed.
# Pre-fix: `(?![ \t\r\n]*::)` is a negative lookahead in the regex — NOT
# supported by Rust's `regex` crate. Like the .b.6.2.15 string_literal
# fix, this regex failed to compile every invocation. The intent
# ("identifier NOT followed by ::") is preserved by using grammar-level
# `!scope_resolution` negative lookahead — which IS supported by the
# PEG engine and is a zero-width assertion (no input consumed).
# Parser-AGNOSTIC level 0.
@sample: "foo"
simple_identifier_no_scope := trivia /[a-zA-Z_][a-zA-Z0-9_$]*/ !scope_resolution
                           -> $2

@sample: "\\foo "
escaped_identifier := trivia /\\[!-~]+/
                   -> $2

@profiles: ["sv_2017", "sv_2023"]
reserved_non_keyword_identifier_sv := trivia /(?:parameter|localparam|type|context|pure|import|export|typedef|module|package|interface|program|class|checker|function|task|property|sequence|generate|modport|clocking|enum|struct|union|bit|logic|reg|byte|shortint|int|longint|integer|time|shortreal|real|realtime|ref|string|chandle|event|signed|unsigned|void|endchecker|endclass|endfunction|endinterface|endmodule|endpackage|endprogram|endproperty|endsequence|endtask|begin|end|if|else|case|casez|casex|endcase|for|foreach|forever|repeat|while|do|wait|wait_order|disable|return|break|continue|fork|join|join_any|join_none|assert|assume|expect|randcase|randsequence|always|and|assign|automatic|buf|bufif0|bufif1|cell|cmos|config|deassign|default|defparam|design|edge|endconfig|endgenerate|endprimitive|endspecify|endtable|force|genvar|highz0|highz1|ifnone|incdir|include|initial|inout|input|instance|large|liblist|library|macromodule|medium|nand|negedge|nmos|nor|noshowcancelled|not|notif0|notif1|or|output|pmos|posedge|primitive|pull0|pull1|pulldown|pullup|pulsestyle_onevent|pulsestyle_ondetect|rcmos|release|rnmos|rpmos|rtran|rtranif0|rtranif1|scalared|showcancelled|small|specify|specparam|strong0|strong1|supply0|supply1|table|tran|tranif0|tranif1|tri|tri0|tri1|triand|trior|trireg|use|uwire|vectored|wand|weak0|weak1|wire|wor|xnor|xor)\b/

@profiles: ["verilog_2005"]
reserved_non_keyword_identifier_v2005 := trivia /(?:always|and|assign|automatic|begin|buf|bufif0|bufif1|case|casex|casez|cell|cmos|config|deassign|default|defparam|design|disable|edge|else|end|endcase|endconfig|endfunction|endgenerate|endmodule|endprimitive|endspecify|endtable|endtask|event|for|force|forever|fork|function|generate|genvar|highz0|highz1|if|ifnone|incdir|include|initial|inout|input|instance|integer|join|large|liblist|library|localparam|macromodule|medium|module|nand|negedge|nmos|nor|noshowcancelled|not|notif0|notif1|or|output|parameter|pmos|posedge|primitive|pull0|pull1|pulldown|pullup|pulsestyle_onevent|pulsestyle_ondetect|rcmos|real|realtime|reg|release|repeat|rnmos|rpmos|rtran|rtranif0|rtranif1|scalared|showcancelled|signed|small|specify|specparam|strong0|strong1|supply0|supply1|table|task|time|tran|tranif0|tranif1|tri|tri0|tri1|triand|trior|trireg|unsigned|use|uwire|vectored|wait|wand|weak0|weak1|while|wire|wor|xnor|xor)\b/

reserved_non_keyword_identifier := reserved_non_keyword_identifier_sv
                                | reserved_non_keyword_identifier_v2005

@branch_policy: priority_first
scope_free_identifier := simple_identifier_no_scope                -> {body: $1}
                      | escaped_identifier !scope_resolution       -> {body: $1}

number := real_number     -> {kind: "real",     body: $1}
        | integral_number -> {kind: "integral", body: $1}

# PGEN-SV-EXH-PROOF-0021 (.3.2 Strategy 1): the 115-slice campaign +
# POST-SV-AUDIT decomposed these into a per-digit-token tree
# (decimal_digit ( unsigned_number_tail )*, size '? base value, …)
# that the generator's blanket `\b`-append on every single-char
# alnum token (digits 0-9, base letters h/b/d/o/s/S, x/z) + the
# `__SV_RULE__`-sentinel-mangled `_` separator made 100% unparseable
# for any multi-digit / underscore / sized / based number — the
# external-corpus 0/14 root cause. Empirically proven Strategy-2
# (patch each corrupt token) is unbounded whack-a-mole. Strategy 1:
# restore the clean single-regex lexical form (IEEE 1800 A.8.7
# number BNF — NOT the generator's MANUAL_RULE_BODIES verbatim,
# which has a plain-before-sized PEG-order bug + mandatory-size
# bug). SIZED alternative FIRST (PEG longest-match), size OPTIONAL
# (`'hFF` unsized based is valid SV). Value class
# `[0-9a-fA-FxXzZ?_]` is the LRM superset over hex/bin/oct/dec digits
# + x/z/? + `_` separators (intentionally pragmatic, per the
# generator's own design note). The typed `number := real_number ->
# {kind:"real",body:$1} | integral_number -> {kind:"integral",
# body:$1}` top shape is KEPT — real_number/integral_number are now
# clean Terminals so `$1` = the matched number string ⇒ a clean flat
# `{kind, body:"<number>"}` (the prior nested decomposed shapes never
# emitted — numbers were 100% unparseable — so no working consumer).
#
# PGEN-SV-CORPUS-GRAD-0020 (.3.5, the #6 rejects-valid family): the two
# `[ \t]*` seams admit LRM-legal white space in a based literal. IEEE
# 1800-2017 section 5.7.1 (1364-2005 section 3.5.1 identical): white space is
# legal between the size and the `'` and between the base format and the
# value, but NOT between the `'` and the base character (`'[sS]?[dDhHoObB]`
# stays contiguous). The value charset is unchanged, so a `-` between base and
# value (LRM: illegal) and interior white space inside the value both still
# reject. Terminal-internal, so cross-profile (heals sv_2017/sv_2023 AND
# verilog_2005); no new rule/token (census unchanged); `body:$1` shape
# unchanged (spaced literals were 100% unparseable ==> additive, no lock
# broken). `[ \t]` (horizontal) covers the whole observed corpus; a literal
# spanning a newline needs the composite-rule form (deferred).
integral_number := /([0-9][0-9_]*[ \t]*)?'[sS]?[dDhHoObB][ \t]*[0-9a-fA-FxXzZ?_]+/
                 | /[0-9][0-9_]*/

real_number := /[0-9][0-9_]*\.[0-9][0-9_]*([eE][+-]?[0-9][0-9_]*)?/
             | /[0-9][0-9_]*[eE][+-]?[0-9][0-9_]*/

# PGEN-SV-EXH-PROOF-0021 (.3.2 Strategy 1): the POST-SV-AUDIT.2.4a
# `unsigned_number_tail` lift is SUPERSEDED — `unsigned_number` is
# the LRM plain decimal literal (`decimal_digit { _ | decimal_digit }`
# = `[0-9][0-9_]*`), a clean Terminal. The decomposed per-digit-token
# tree (with the `\b`-broken digit tokens + the `__SV_RULE__`-mangled
# `_`) is gone. `unsigned_number` is referenced broadly (delays,
# ranges, replication, sizes) so it stays a named rule.
unsigned_number := /[0-9][0-9_]*/

# SV-EXH-PROOF.3.3.4.b.6.2.15 — REMOVED broken triple-quoted regex.
# Pre-fix: branch 1 was `/"""([^"]|"(?!""))*"""/` which uses `(?!"")`
# negative lookahead — NOT SUPPORTED by Rust's `regex` crate. Every
# attempt to compile this regex at parse time threw
# `error: look-around, including look-ahead and look-behind, is not supported`,
# causing the parser to backtrack and try the next branch. Each
# string_literal invocation hit this failed-compile + backtrack cycle.
# Over heavy uvm-style nested speculative parses, this became the
# DOMINANT source of catastrophic backtracking — the trace pinned it to
# 96 invocations at the SAME byte position (117064) in a 5-second
# window of the hanging parse, ultimately causing the >180s hang on
# `head -11755 + endpackage` of uvm_pkg.
#
# Triple-quoted string literals (`"""..."""`) are NOT standard SV
# (LRM doesn't define them; they're a Python/Scala syntax). The
# broken branch was added speculatively per the line-66 comment block
# but has been broken since introduction — the regex never actually
# matched anything because it never compiled. Removing it restores
# the simple `string_literal := trivia /"([^"\\]|\\.)*"/` form which is
# the LRM-correct SV string-literal definition (single double-quoted
# strings with backslash escapes).
#
# Effect: eliminates the catastrophic-backtracking hot loop. Parser-
# AGNOSTIC level 0 (grammar simplification).
string_literal := trivia /"([^"\\]|\\.)*"/        -> {kind: "double_quoted", body: $2}

unbased_unsized_literal := trivia /'(0|1|x|X|z|Z)/

time_literal := number time_unit
             -> {value: $1, unit: $2}

c_identifier := non_keyword_identifier

system_tf_identifier := trivia /\$[a-zA-Z0-9_$]+/

// identifier_code := trivia /[^\\r\\n]*/

// comment_text := trivia /([^*]|\*+[^*\/])*/

generate_block := kw_begin_8cbd0a74 ( colon generate_block_identifier )? generate_item* kw_end_7a92f3d2 ( colon generate_block_identifier )?
                       -> {kind: "anonymous",     label: $2, items: $3, end_label: $5}
               | generate_block_identifier colon kw_begin_8cbd0a74 ( colon generate_block_identifier )? generate_item* kw_end_7a92f3d2 ( colon generate_block_identifier )?
                       -> {kind: "labeled",       name: $1, label: $4, items: $5, end_label: $7}
               | generate_item
                       -> {kind: "generate_item", body: $1}

# SV-EXH-PROOF.3.3.4.b.6.2.14 — priority_first on trivia. Default
# longest_match causes catastrophic backtracking on inputs with block
# comments (the inner alternation is tried both ways per token boundary;
# combined with rule alternations exploring all branches, work explodes
# multiplicatively). priority_first picks the FIRST matching alternative
# (line_comment, then block_comment) — these alternatives are MUTUALLY
# EXCLUSIVE (line_comment starts with //, block_comment starts with /*) so
# priority_first vs longest_match produce IDENTICAL successful matches.
# The only difference is performance: priority_first stops at first match.
# Parser-AGNOSTIC level 0.
#
# GRAMMAR-WELLFORMED.H.12.5.3: the former `white_space := /[ \t\r\n]+/`
# arm was ENGINE-SHADOWED-DEAD — the generated layout skipper consumes
# whitespace before any non-empty-matchable regex executes, so a
# pure-whitespace-class rule can never match its own bytes on any input
# (probe-confirmed parsed=true/witnessed=false; the vhdl H.11.4-UNPARK
# precedent). The arm was removed accept-identically (it never matched) and
# the orphaned rule removed at source per the literal-0 doctrine.
@branch_policy: priority_first
trivia := (line_comment | block_comment)*

@sample: "//x\n"
line_comment := /\/\/[^\n]*(\n|$)/

block_comment := /\/\*([^*]|\*+[^*\/])*\*+\//

# IEEE 1800-2017 §25 / A.2.9: a single port_direction is shared across a
# comma-separated list of modport_simple_port. The `{ , modport_simple_port }`
# repetition was absent (only one port per direction admitted), so
# `modport master(input a, b, output c, d)` rejected at the shared-direction
# port `b` (SV-CORPUS-GRAD.3.4, ledger SV-0040). The greedy `*` stops at the
# next port_direction keyword (a reserved word, not a port_identifier), so a
# new direction group still opens a fresh modport_ports_declaration.
modport_simple_ports_declaration := port_direction modport_simple_port ( comma modport_simple_port )*
                                 -> {direction: $1, ports: [$2, $3::2*]}

# Profile-aware LRM-derived syntax

action_block := statement_or_null
                     -> {kind: "always",    body: $1}
              | ( statement )? kw_else_ae050f5b statement_or_null
                     -> {kind: "with_else", pass: $1, fail: $3}

always_construct := always_keyword statement
                 -> {keyword: $1, body: $2}

@profiles: ["sv_2017", "sv_2023"]
always_keyword_sv_only := kw_always_comb_a1f2a86b  -> {kind: "always_comb"}
                        | kw_always_latch_23c99af9 -> {kind: "always_latch"}
                        | kw_always_ff_3c7a051e    -> {kind: "always_ff"}

always_keyword := kw_always_6656018a -> {kind: "always"}
                | always_keyword_sv_only

anonymous_program := kw_program_81d9aeea semi anonymous_program_item* kw_endprogram_6b609b1f
                  -> {items: $3}

@profiles: ["sv_2017"]
anonymous_program_item_sv_2017 := task_declaration              -> {kind: "task",                body: $1}
                                | function_declaration          -> {kind: "function",            body: $1}
                                | class_declaration             -> {kind: "class",               body: $1}
                                | interface_class_declaration   -> {kind: "interface_class",     body: $1}
                                | covergroup_declaration        -> {kind: "covergroup",          body: $1}
                                | class_constructor_declaration -> {kind: "class_constructor",   body: $1}
                                | semi                          -> {kind: "semi"}

@profiles: ["sv_2023"]
anonymous_program_item_sv_2023 := task_declaration              -> {kind: "task",                body: $1}
                                | function_declaration          -> {kind: "function",            body: $1}
                                | class_declaration             -> {kind: "class",               body: $1}
                                | interface_class_declaration   -> {kind: "interface_class",     body: $1}
                                | covergroup_declaration        -> {kind: "covergroup",          body: $1}
                                | class_constructor_declaration -> {kind: "class_constructor",   body: $1}
                                | semi                          -> {kind: "semi"}

@profiles: ["sv_2017", "sv_2023"]
anonymous_program_item := anonymous_program_item_sv_2017 -> {kind: "sv_2017", body: $1}
                        | anonymous_program_item_sv_2023 -> {kind: "sv_2023", body: $1}

ansi_port_header := net_port_header | interface_port_header

ansi_port_declaration := ansi_port_header? port_identifier unpacked_dimension* ( assign constant_expression )?
                                                                                                                       -> {kind: "net_or_interface", header: $1, name: $2, dims: $3, default: $4}
                       | ( variable_port_header )? port_identifier variable_dimension* ( assign constant_expression )?
                                                                                                                       -> {kind: "variable", header: $1, name: $2, dims: $3, default: $4}
                       | ( port_direction )? dot port_identifier lparen ( expression )? rparen
                                                                                                                       -> {kind: "named_dot", direction: $1, name: $3, expr: $5}

// array_identifier := identifier

array_manipulation_call := array_method_name attribute_instance* ( lparen list_of_arguments rparen )? ( kw_with_8fcd25a3 lparen expression rparen )?
                        -> {method: $1, attributes: $2, args: $3, with_clause: $4}

array_method_name := method_identifier      -> {kind: "method_identifier", body: $1}
                   | kw_unique_58037c00     -> {kind: "unique"}
                   | kw_and_cffa50a3        -> {kind: "and"}
                   | kw_or_1758356d         -> {kind: "or"}
                   | kw_xor_f1922a23        -> {kind: "xor"}

array_pattern_key := constant_expression      -> {kind: "expression",    body: $1}
                   | assignment_pattern_key   -> {kind: "pattern_key",   body: $1}

array_range_expression := expression                                    -> {kind: "expression",       body: $1}
                        | expression colon expression                    -> {kind: "range",            lo: $1, hi: $3}
                        | expression plus colon expression               -> {kind: "plus_indexed",     base: $1, width: $4}
                        | expression minus colon expression              -> {kind: "minus_indexed",    base: $1, width: $4}

@profiles: ["sv_2017", "sv_2023"]
assert_property_statement := kw_assert_64b5daad kw_property_269fe373 lparen property_spec rparen action_block
                          -> {spec: $4, action: $6}

@profiles: ["sv_2017", "sv_2023"]
assertion_item := concurrent_assertion_item            -> {kind: "concurrent",            body: $1}
               | deferred_immediate_assertion_item     -> {kind: "deferred_immediate",    body: $1}

@profiles: ["sv_2017", "sv_2023"]
assertion_item_declaration := property_declaration -> {kind: "property", body: $1}
                            | sequence_declaration -> {kind: "sequence", body: $1}
                            | let_declaration      -> {kind: "let",      body: $1}

assertion_variable_declaration := var_data_type list_of_variable_decl_assignments semi
                               -> {data_type: $1, items: $2}

# POST-SV-AUDIT.2.4b Cat-A: shared record rule for the named
# assignment-pattern entries (used by every assignment_pattern named
# branch); the branch becomes a clean flat {name,pattern} record list.
@profiles: ["sv_2017", "sv_2023"]
assignment_pattern_entry := member_identifier colon pattern -> {name: $1, pattern: $3}

# IEEE 1800-2017 A.6.7.1 assignment_pattern — FOUR productions, each requiring >= 1
# element, PLUS a fifth alternative below for the EMPTY pattern `'{ }`.
#
# ⛔⛔ DO NOT DELETE THE `@sample: "'{}"` ALTERNATIVE. It is NOT a transcription slip and
# it is NOT over-acceptance. It has been deleted once already (SV-CORPUS-GRAD.3.26a, on
# the reasoning "Annex A's four alternatives all require an expression, therefore `'{}`
# is non-LRM") and a director ruling REVERTED that deletion the same day, because it
# makes the parser reject input the ecosystem writes — uvm-core's `return '{};`
# (uvm_lru_cache.svh:206,:273) and 49 corpus files.
#
# `'{ }` is LEGAL SystemVerilog. Read, not inferred, across 1800-2017 AND 1800-2023:
#   - §11.4.12: "Concatenations are enclosed in just braces ( { } ), whereas structure
#     and array literals are enclosed in braces that begin with an apostrophe ( '{ } )"
#     — the standard writes THIS construct's own delimiter pair with the apostrophe.
#   - Annex M / VPI: `#define vpiAssignmentPatternOp 75 /* '{} assignment pattern */`.
#   - NO text anywhere declares `'{}` illegal or unsupported.
# Annex A simply does not derive it. That is an ANNEX GAP — measured three times in this
# grammar (`'{ }` here; `q[a:$]` licensed by A.8.4 footnote 42, .3.25; `use #(...)`
# written 7x in clause 33.4.3, .3.19) — and an annex gap is NOT a prohibition.
#
# ⛔ STANDING RULE: "non-LRM" is a CITATION, never an inference. Before deleting any arm
# as non-compliant, produce the LRM sentence that forbids it. See
# docs/decisions/feedback_sv_strict_lrm_compliance_default.md § BOUNDING RULING, and the
# card annex-a-footnotes-license-derivations-the-productions-cannot-derive.
#
# WHY THE EMPTY CASE LIVES HERE and not on empty_unpacked_array_concatenation (which is
# the BARE-brace `{ }` form, A.8.1, a different production — see its own comment):
# director 2026-08-10, *"the inside of '{...} can be empty. this need to be properly
# capture in the EBNF"*. §11.4.12 calls `'{ }` the delimiter of a structure/array
# LITERAL, so the empty case is the degenerate ASSIGNMENT PATTERN. Modelling it as a
# concatenation gave it an AST node no assignment-pattern consumer looks for; it now
# emits the same shape as any other pattern, differing only in the element list
# (`'{}` -> {pattern: {exprs: []}, type: []}). SV-CORPUS-GRAD.3.26c moved it;
# .3.26e moved THIS COMMENT, which .3.26c left behind on the old rule.
#
# ⛔ Comments stay OUTSIDE the rule body: a column-0 comment between alternatives
# DELETES the alternatives that follow it (project_standing_tripwires).
assignment_pattern := @sample: "'{0, 1}" tick lbrace expression ( comma expression )* rbrace
                   -> {exprs: [$3, $4::2*]}
                    | @sample: "'{x: 0}" tick lbrace structure_pattern_key colon expression ( comma structure_pattern_key colon expression )* rbrace
                    | @sample: "'{1: 0}" tick lbrace array_pattern_key colon expression ( comma array_pattern_key colon expression )* rbrace
                    | @sample: "'{2{0, 1}}" tick lbrace constant_expression lbrace expression ( comma expression )* rbrace rbrace
                    | @sample: "'{}" tick lbrace rbrace
                   -> {exprs: []}

assignment_pattern_expression := ( assignment_pattern_expression_type )? assignment_pattern
                              -> {type: $1, pattern: $2}

assignment_pattern_expression_type := ps_type_identifier        -> {kind: "ps_type",           body: $1}
                                    | ps_parameter_identifier   -> {kind: "ps_parameter",      body: $1}
                                    | integer_atom_type         -> {kind: "integer_atom_type", body: $1}
                                    | type_reference            -> {kind: "type_reference",    body: $1}

# SV-CORPUS-GRAD.13c.2t: the UNION of the standard's TWO normative statements about this key,
# which disagree — identically in 1800-2017 and 1800-2023, so this is a standing LRM defect and
# not an edition difference.
#   Annex A (2023 A.6.7.1, :1480):  assignment_pattern_key ::= simple_type | default
#   §10.9.2 clause text:            "The '{member:value} or '{data_type: default_value} syntax can
#                                    also be used", with the worked example
#                                    `initial s2 = '{int:1, default:0, string:""};`
# ⛔ The two sets are NOT nested, so neither alone is compliant: `ps_parameter_identifier` is in
# `simple_type` ONLY, while `string` / `chandle` / `event` / `class_type` / `type_reference` are in
# `data_type` ONLY. Keeping just `simple_type` REJECTS the standard's own §10.9.2 example (a
# rejects-valid non-conformance); replacing it with `data_type` silently DROPS
# `ps_parameter_identifier`. The union is the only spelling under which every derivation either
# normative clause licenses is derivable, and it admits nothing the standard forbids — §10.9.2 says
# the key names a TYPE, and `data_type` is the LRM's own name for the set of types.
# ⭐ `simple_type` stays FIRST so every construct that parses today keeps its existing AST arm.
# ⭐⭐ Corroborated by the standard's own drafting rather than by reading: Annex A's
# `casting_type ::= simple_type | constant_primary | signing | string | const` patches the SAME
# shortfall with an explicit `| string` at the one other site that uses a type keyword this way.
# The sweep is bounded at 1 of 3 `simple_type` references — `casting_type` and `slice_size` were
# both checked against their own Annex A productions and match exactly.
assignment_pattern_key := simple_type        -> {kind: "type",      body: $1}
                        | data_type          -> {kind: "data_type", body: $1}
                        | kw_default_7505d64a -> {kind: "default"}

assignment_pattern_net_lvalue := tick lbrace net_lvalue ( comma net_lvalue )* rbrace
                              -> {items: [$3, $4::2*]}

assignment_pattern_variable_lvalue := tick lbrace variable_lvalue ( comma variable_lvalue )* rbrace
                                   -> {items: [$3, $4::2*]}

# VERILOG-2005-PROFILE.6.10 (SV-0034) — the associative-array dimension (`[data_type]` and the
# wildcard `[*]`) is SystemVerilog-only (IEEE 1800 §7.8); IEEE 1364-2005 has no associative arrays
# (Annex A array dimensions are ranged `[msb:lsb]` only). Whole-rule @profiles gate — single-carrier
# SV-only rule, referenced only from variable_dimension's associative alt; the sv_2017/sv_2023 tree
# (and AST) is unchanged. Whole-rule gate idiom, cf. unsized_dimension (.6.9) / uniqueness_constraint.
@profiles: ["sv_2017", "sv_2023"]
associative_dimension := lbrack data_type rbrack    -> {kind: "data_type", body: $2}
                       | lbrack star rbrack          -> {kind: "wildcard"}

@profiles: ["sv_2017", "sv_2023"]
assume_property_statement := kw_assume_661e458e kw_property_269fe373 lparen property_spec rparen action_block
                          -> {spec: $4, action: $6}

attr_name := non_keyword_identifier
          -> {body: $1}

attr_spec := attr_name ( assign constant_expression )?
          -> {name: $1, value: $2}

attribute_instance := attr_open attr_spec ( comma attr_spec )* attr_close
                   -> [$2, $3::2*]

bin_identifier := non_keyword_identifier

binary_module_path_operator := equal                -> {kind: "equal"}
                            | not_equal           -> {kind: "not_equal"}
                            | logical_and         -> {kind: "logical_and"}
                            | logical_or          -> {kind: "logical_or"}
                            | bitwise_and         -> {kind: "bitwise_and"}
                            | bitwise_or          -> {kind: "bitwise_or"}
                            | bitwise_xor         -> {kind: "bitwise_xor"}
                            | reduction_xnor_alt  -> {kind: "reduction_xnor_alt"}
                            | reduction_xnor      -> {kind: "reduction_xnor"}

@profiles: ["sv_2017", "sv_2023"]
bind_directive := kw_bind_6bdd4db9 bind_target_scope ( colon bind_target_instance_list )? bind_instantiation
                    -> {kind: "scoped", target_scope: $2, instances: $3, instantiation: $4}
               | kw_bind_6bdd4db9 bind_target_instance bind_instantiation
                    -> {kind: "single", target_instance: $2, instantiation: $3}

bind_instantiation := program_instantiation   -> {kind: "program",   body: $1}
                   | module_instantiation     -> {kind: "module",    body: $1}
                   | interface_instantiation  -> {kind: "interface", body: $1}
                   | checker_instantiation    -> {kind: "checker",   body: $1}

bind_target_instance := hierarchical_identifier constant_bit_select
                     -> {name: $1, bit_select: $2}

bind_target_instance_list := bind_target_instance ( comma bind_target_instance )*
                          -> [$1, $2::2*]

bind_target_scope := module_identifier    -> {kind: "module",    name: $1}
                  | interface_identifier -> {kind: "interface", name: $1}

bins_expression := variable_identifier                       -> {kind: "variable",     name: $1}
                 | cover_point_identifier ( dot bin_identifier )? -> {kind: "cover_point", name: $1, bin: $2}

bins_keyword := kw_bins_7de92be6           -> {kind: "bins"}
              | kw_illegal_bins_909dfbf3   -> {kind: "illegal_bins"}
              | kw_ignore_bins_c8b3e6e5    -> {kind: "ignore_bins"}

bins_or_empty := lbrace ( attribute_instance* ( bins_or_options semi )* ) rbrace  -> {kind: "block", body: $2}
               | semi                                                              -> {kind: "empty"}

bins_or_options := coverage_option
                          -> {kind: "coverage_option", body: $1}
                 | ( kw_wildcard_08654ea6 )? bins_keyword bin_identifier ( lbrack ( covergroup_expression )? rbrack )? assign lbrace covergroup_range_list rbrace ( kw_with_8fcd25a3 lparen with_covergroup_expression rparen )? ( kw_iff_ee1c009e lparen expression rparen )?
                          -> {kind: "range_list",      wildcard: $1, keyword: $2, name: $3, index: $4, ranges: $7, with_expr: $9, iff: $10}
                 | ( kw_wildcard_08654ea6 )? bins_keyword bin_identifier ( lbrack ( covergroup_expression )? rbrack )? assign cover_point_identifier kw_with_8fcd25a3 lparen with_covergroup_expression rparen ( kw_iff_ee1c009e lparen expression rparen )?
                          -> {kind: "cover_point_with", wildcard: $1, keyword: $2, name: $3, index: $4, cover_point: $6, with_expr: $9, iff: $11}
                 | ( kw_wildcard_08654ea6 )? bins_keyword bin_identifier ( lbrack ( covergroup_expression )? rbrack )? assign set_covergroup_expression ( kw_iff_ee1c009e lparen expression rparen )?
                          -> {kind: "set",             wildcard: $1, keyword: $2, name: $3, index: $4, value: $6, iff: $7}
                 | ( kw_wildcard_08654ea6 )? bins_keyword bin_identifier ( lbrack rbrack )? assign trans_list ( kw_iff_ee1c009e lparen expression rparen )?
                          -> {kind: "trans_list",      wildcard: $1, keyword: $2, name: $3, array: $4, trans: $6, iff: $7}
                 | bins_keyword bin_identifier ( lbrack ( covergroup_expression )? rbrack )? assign kw_default_7505d64a ( kw_iff_ee1c009e lparen expression rparen )?
                          -> {kind: "default",         keyword: $1, name: $2, index: $3, iff: $6}
                 | bins_keyword bin_identifier assign kw_default_7505d64a kw_sequence_92504616 ( kw_iff_ee1c009e lparen expression rparen )?
                          -> {kind: "default_sequence", keyword: $1, name: $2, iff: $6}

bins_selection := bins_keyword bin_identifier assign select_expression ( kw_iff_ee1c009e lparen expression rparen )?
               -> {keyword: $1, name: $2, select: $4, iff: $5}

bins_selection_or_option := attribute_instance* coverage_option -> {kind: "option",    attributes: $1, body: $2}
                          | attribute_instance* bins_selection  -> {kind: "selection", attributes: $1, body: $2}

@branch_policy: priority_first
# SV-EXH-PROOF.3.3.4.b.6.2.13 — `q[$]` queue-back operator. SV LRM
# allows `$` as a bit-select expression meaning "last element of a queue
# or dynamic array" (e.g. `matched_overrides[$]` accesses the queue's
# last element). The existing `expression` branch doesn't accept bare
# `$` (primary's `kw_sv_dollar_04da59ec` is the SV system-dollar
# primary token — IEEE 1800 A.8.4 `primary ::= … $ …`; bare `$` as an
# expression operand isn't a primary form). Adding `kw_dollar` as a
# direct alternative lets `q[$]` parse via the bit_select path. Also
# matches the LRM rule `bit_select := { [ expression ] }` which in
# IEEE 1800 §11.4.13 explicitly includes `$` for queues. Strictly
# additive — no existing matches change. Parser-AGNOSTIC level 0.
bit_select_expression := method_call -> {kind: "method",     body: $1}
                       | kw_dollar   -> {kind: "dollar"}
                       | expression  -> {kind: "expression", body: $1}

bit_select := ( lbrack bit_select_expression rbrack )*
           -> {body: $1}

block_event_expression := block_event_expression kw_or_1758356d block_event_expression
                                -> {kind: "or",    lhs: $1, rhs: $3}
                       | kw_begin_8cbd0a74 hierarchical_btf_identifier
                                -> {kind: "begin", body: $2}
                       | kw_end_7a92f3d2 hierarchical_btf_identifier
                                -> {kind: "end",   body: $2}

block_identifier := declaration_identifier

block_item_declaration := attribute_instance* block_data_declaration
                                    -> {kind: "block_data",        attributes: $1, body: $2}
                        | attribute_instance* local_parameter_declaration semi
                                    -> {kind: "local_parameter",   attributes: $1, body: $2}
                        | attribute_instance* parameter_declaration semi
                                    -> {kind: "parameter",         attributes: $1, body: $2}
                        | attribute_instance* let_declaration
                                    -> {kind: "let",               attributes: $1, body: $2}

@profiles: ["sv_2017", "verilog_2005"]
block_data_declaration_sv_2017 := @probe_sample: "int a;" ( kw_const_b42f3f6f )? ( kw_var_e5b4e786 )? ( lifetime )? block_data_type_or_implicit list_of_variable_decl_assignments semi
                               -> {const_keyword: $1, var_keyword: $2, lifetime: $3, data_type: $4, items: $5}
                               | @probe_sample: "typedef int t;" type_declaration
                               | @probe_sample: "import p::*;" package_import_declaration
                               | @probe_sample: "nettype int nt;" net_type_declaration

@profiles: ["sv_2023"]
block_data_declaration_sv_2023 := ( kw_const_b42f3f6f )? ( kw_var_e5b4e786 )? ( lifetime )? block_data_type_or_implicit list_of_variable_decl_assignments semi
                                        -> {kind: "data",       const_keyword: $1, var_keyword: $2, lifetime: $3, data_type: $4, items: $5}
                                | type_declaration
                                        -> {kind: "type",       body: $1}
                                | package_import_declaration
                                        -> {kind: "import",     body: $1}
                                | nettype_declaration
                                        -> {kind: "nettype",    body: $1}

block_data_declaration := block_data_declaration_sv_2017 -> {kind: "sv_2017", body: $1}
                        | block_data_declaration_sv_2023 -> {kind: "sv_2023", body: $1}

@profiles: ["sv_2017", "verilog_2005"]
blocking_assignment_sv_2017 := @probe_sample: "a = #1 1" variable_lvalue assign delay_or_event_control expression
                                  -> {kind: "delay_assign",      lvalue: $1, delay: $3, value: $4}
                             | nonrange_variable_lvalue assign dynamic_array_new
                                  -> {kind: "dynamic_array_new", lvalue: $1, value: $3}
                             | ( class_or_package_scope )? hierarchical_variable_identifier select assign class_new
                                  -> {kind: "class_new",         scope: $1, name: $2, select: $3, value: $5}
                             | @probe_sample: "a = 1" operator_assignment
                                  -> {kind: "operator",          body: $1}

@profiles: ["sv_2023"]
blocking_assignment_sv_2023 := variable_lvalue assign delay_or_event_control expression
                                  -> {kind: "delay_assign",      lvalue: $1, delay: $3, value: $4}
                             | nonrange_variable_lvalue assign dynamic_array_new
                                  -> {kind: "dynamic_array_new", lvalue: $1, value: $3}
                             | ( class_or_package_scope )? hierarchical_variable_identifier select assign class_new
                                  -> {kind: "class_new",         scope: $1, name: $2, select: $3, value: $5}
                             | operator_assignment
                                  -> {kind: "operator",          body: $1}
                             | inc_or_dec_expression
                                  -> {kind: "inc_or_dec",        body: $1}

class_or_package_scope := implicit_class_handle dot -> {kind: "instance",      handle: $1}
                        | class_scope               -> {kind: "class_scope",   body: $1}
                        | package_scope             -> {kind: "package_scope", body: $1}

blocking_assignment := blocking_assignment_sv_2017 -> {kind: "sv_2017", body: $1}
                     | blocking_assignment_sv_2023 -> {kind: "sv_2023", body: $1}

@profiles: ["sv_2017"]
boolean_abbrev_sv_2017 := consecutive_repetition      -> {kind: "consecutive",      body: $1}
                        | non_consecutive_repetition  -> {kind: "non_consecutive",  body: $1}
                        | goto_repetition             -> {kind: "goto",             body: $1}

@profiles: ["sv_2023"]
boolean_abbrev_sv_2023 := consecutive_repetition       -> {kind: "consecutive",      body: $1}
                        | nonconsecutive_repetition    -> {kind: "non_consecutive",  body: $1}
                        | goto_repetition              -> {kind: "goto",             body: $1}

@profiles: ["sv_2017", "sv_2023"]
boolean_abbrev := boolean_abbrev_sv_2017 -> {kind: "sv_2017", body: $1}
                | boolean_abbrev_sv_2023 -> {kind: "sv_2023", body: $1}

built_in_method_call := array_manipulation_call -> {kind: "array_manipulation", body: $1}
                      | randomize_call          -> {kind: "randomize",         body: $1}

case_expression := expression
                -> {body: $1}

case_generate_construct := kw_case_6406510c lparen constant_expression rparen case_generate_item case_generate_item* kw_endcase_a27a6786
                        -> {expr: $3, items: {first: $5, rest: $6}}

case_generate_item := constant_expression ( comma constant_expression )* colon generate_block
                          -> {kind: "expr_list", exprs: [$1, $2::2*], block: $4}
                   | kw_default_7505d64a ( colon )? generate_block
                          -> {kind: "default",   block: $3}

@profiles: ["sv_2017"]
case_inside_item_sv_2017 := open_range_list colon statement_or_null
                                 -> {kind: "range_list", ranges: $1, body: $3}
                          | kw_default_7505d64a ( colon )? statement_or_null
                                 -> {kind: "default",    body: $3}

@profiles: ["sv_2023"]
case_inside_item_sv_2023 := range_list colon statement_or_null
                                 -> {kind: "range_list", ranges: $1, body: $3}
                          | kw_default_7505d64a ( colon )? statement_or_null
                                 -> {kind: "default",    body: $3}

@profiles: ["sv_2017", "sv_2023"]
case_inside_item := case_inside_item_sv_2017 -> {kind: "sv_2017", body: $1}
                  | case_inside_item_sv_2023 -> {kind: "sv_2023", body: $1}

case_item := case_item_expression ( comma case_item_expression )* colon statement_or_null
                  -> {kind: "expr_list", exprs: [$1, $2::2*], body: $4}
           | kw_default_7505d64a ( colon )? statement_or_null
                  -> {kind: "default",   body: $3}

case_item_expression := expression
                     -> {body: $1}

case_keyword := kw_case_6406510c  -> {kind: "case"}
              | kw_casez_b8fbe0e1 -> {kind: "casez"}
              | kw_casex_b31a7350 -> {kind: "casex"}

@profiles: ["sv_2017", "sv_2023"]
case_pattern_item := pattern ( logical_and3 expression )? colon statement_or_null
                          -> {kind: "pattern", pattern: $1, condition: $2, body: $4}
                   | kw_default_7505d64a ( colon )? statement_or_null
                          -> {kind: "default", body: $3}

case_statement := @sample: "case (a) default: ; endcase" ( unique_priority )? case_keyword lparen case_expression rparen case_item case_item* kw_endcase_a27a6786
               -> {unique_priority: $1, keyword: $2, expr: $4, items: {first: $6, rest: $7}}
                | @sample: "case (a) matches default: ; endcase" ( unique_priority )? case_keyword lparen case_expression rparen kw_matches_9f3e9242 case_pattern_item case_pattern_item* kw_endcase_a27a6786
                | @sample: "case (a) inside [0:1]: ; endcase" ( unique_priority )? kw_case_6406510c lparen case_expression rparen kw_inside_fcc53788 case_inside_item case_inside_item* kw_endcase_a27a6786

cast := casting_type tick lparen expression rparen
     -> {type: $1, body: $4}

casting_type := simple_type            -> {kind: "simple_type",     body: $1}
              | constant_primary       -> {kind: "constant_primary", body: $1}
              | signing                -> {kind: "signing",          body: $1}
              | kw_string_ecb25204     -> {kind: "string"}
              | kw_const_b42f3f6f      -> {kind: "const"}

cell_clause := kw_cell_5f435eb3 ( library_identifier dot )? cell_identifier
