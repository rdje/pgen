                 -> {body: $1}

operator_assignment := variable_lvalue assignment_operator expression
                    -> {lvalue: $1, operator: $2, value: $3}

ordered_checker_port_connection := attribute_instance* ( property_actual_arg )?
                                -> {attributes: $1, arg: $2}

ordered_parameter_assignment := param_expression
                             -> {body: $1}

ordered_port_connection := attribute_instance* ( expression )?
                        -> {attributes: $1, expression: $2}

output_declaration := kw_output_1029d676 net_port_type list_of_port_identifiers
                            -> {kind: "net",      port_type: $2, items: $3}
                    | kw_output_1029d676 variable_port_type list_of_variable_port_identifiers
                            -> {kind: "variable", port_type: $2, items: $3}

output_identifier := output_port_identifier                           -> {kind: "output_port", name: $1}
                  | inout_port_identifier                             -> {kind: "inout_port", name: $1}
                  | interface_identifier dot port_identifier          -> {kind: "interface_dot_port", interface: $1, port: $3}

output_port_identifier := non_keyword_identifier

output_symbol := kw_n_0_b6589fc6 -> {kind: "0"}
               | kw_n_1_356a192b -> {kind: "1"}
               | kw_x_11f6ad8e   -> {kind: "x"}
               | kw_X_c032adc1   -> {kind: "X"}

output_terminal := net_lvalue
                -> {body: $1}

# SV-EXH-PROOF.3.3.2: package was the only declaration NOT using the
# proven `declared_X_identifier := X_identifier -> {body:$1.body}` +
# `@emit_fact {name:$body}` idiom — it put `@emit_fact {name:
# $package_identifier}` directly on this multi-element rule, and
# `package_identifier` occurs twice (decl + trailing label), so the
# named ref resolved to the `{body:…}` object / was unresolvable ⇒
# "could not resolve fact name". Mirror the family idiom: route the
# decl-site through `declared_package_identifier` (below), trailing
# `( colon package_identifier )?` stays the plain label use-site
# (exactly as class/module do `( colon class_identifier )?`).
# SV-EXH-PROOF.3.3.4.a MVP-0: emit a package artifact at commit time.
# `name_from: $name.body` drills the shaped output's `name` field (a
# `declared_package_identifier` node whose `body` field carries the
# package's scalar name) — the resolver walks the JSON object-key path.
# Fires AFTER the rule's body has parsed every `package_item` (every
# `typedef`/`localparam`/etc. has emitted its `type_name` fact), AFTER
# post-predicates have validated the rule, BEFORE commit — so a failed
# write rolls back atomically (`.3.3.3` IIFE invariant).
#
# SV-EXH-PROOF.3.3.4.a.1 (2026-05-20, PGEN-SV-EXH-PROOF-0026): the prior
# `body: $4.body` shape workaround was needed because the semantic-
# annotation language's `rule_reference_name` regex rejected `.`. That
# bootstrap-parser-surface gap is now closed (the runtime resolver always
# supported `$a.b` walking), so the directive references the nested field
# directly and the workaround field is removed from the SV shape.
@export_to_library: { kind: package, name_from: $name.body }
@profiles: ["sv_2017", "sv_2023"]
package_declaration := attribute_instance* kw_package_582681c2 ( lifetime )? declared_package_identifier semi ( timeunits_declaration )? ( attribute_instance* package_item )* kw_endpackage_4f31e93e ( colon package_identifier )?
                    -> {attributes: $1, lifetime: $3, name: $4, timeunits: $6, items: $7, end_label: $9}

@profiles: ["sv_2017", "sv_2023"]
package_export_declaration := kw_export_51713409 star scope_resolution star semi
                                 -> {kind: "wildcard"}
                            | kw_export_51713409 package_import_item ( comma package_import_item )* semi
                                 -> {kind: "explicit", items: [$2, $3::2*]}

package_identifier := declaration_identifier

# SV-EXH-PROOF.3.3.2: the proven declared-id idiom (mirrors
# `declared_class_identifier := class_identifier -> {body:$1.body}`)
# so `@emit_fact name:$body` resolves a scalar. Package originally
# had ONLY `@emit_fact` (no `@predicate has_fact` — a package is not
# a type, unlike class); that behavior is preserved (emit-only).
@emit_fact: { kind: package_name, name: $body }
declared_package_identifier := package_identifier -> { body: $1.body }

@profiles: ["sv_2017", "sv_2023"]
package_import_declaration := kw_import_62fdfbd5 package_import_item ( comma package_import_item )* semi
                            -> {items: [$2, $3::2*]}

# SV-EXH-PROOF.3.3.4.a MVP-0: merge facts from a previously-compiled
# package artifact when the importer references it. `name_from:
# $package.body` drills the shaped output's `package` field (a
# `package_identifier` node whose pass-through chain to `identifier`
# carries the `{body:...}` shape). Fires AFTER body parse so the
# reference is bound; fact-merge into the importer's scope happens
# BEFORE post-predicates and BEFORE the surrounding rule continues, so
# subsequent sibling `@predicate has_fact(type_name, X)` checks observe
# the merged facts.
#
# SV-EXH-PROOF.3.3.4.a.1 (2026-05-20, PGEN-SV-EXH-PROOF-0026): the prior
# per-branch `body: $1.body` shape workaround is removed for the same
# reason as on `package_declaration` (see above).
@import_from_library: { kind: package, name_from: $package.body }
@profiles: ["sv_2017", "sv_2023"]
package_import_item := package_identifier scope_resolution non_keyword_identifier
                          -> {kind: "explicit", package: $1, name: $3}
                     | @emit_fact: { kind: wildcard_import_open, name: $package.body }
                       package_identifier scope_resolution star
                          -> {kind: "wildcard", package: $1}

package_item := package_or_generate_item_declaration -> {kind: "declaration",        body: $1}
             | anonymous_program                     -> {kind: "anonymous_program",  body: $1}
             | package_export_declaration            -> {kind: "export",             body: $1}
             | timeunits_declaration                 -> {kind: "timeunits",          body: $1}

@branch_policy: priority_first
@profiles: ["sv_2017", "verilog_2005"]
# SV-EXH-PROOF.3.3.4.b.6.2.15 — priority_first on the 14-branch
# package_or_generate_item_declaration_sv_2017 alternation. Default
# longest_match runs all 14 branches and picks the longest match —
# pathological when nested under heavy uvm-style typedef + class
# definitions. Each branch starts with a DISTINCT keyword
# (`localparam`, `parameter`, `wire`/`tri`/net-kwd, `import "DPI"`,
# `task`, `function`, `checker`, `constraint`, `class`/`virtual class`,
# `function new` [via `new` keyword], `covergroup`, `assert`/`assume`,
# `;`) OR is a broad `data_declaration` that handles type-rooted forms.
# Ordering verified semantically disjoint: priority_first vs longest_match
# produces IDENTICAL successful matches because the first-matching
# keyword is deterministic. Only difference is perf: priority_first
# stops at first match instead of exhaustively exploring all 14.
# Parser-AGNOSTIC level 0.
@branch_policy: priority_first
package_or_generate_item_declaration_sv_2017 := local_parameter_declaration semi  -> {kind: "local_parameter_declaration",  body: $1}
                                              | parameter_declaration semi        -> {kind: "parameter_declaration",        body: $1}
                                              | net_declaration                   -> {kind: "net_declaration",              body: $1}
                                              | dpi_import_export                 -> {kind: "dpi_import_export",            body: $1}
                                              | data_declaration                  -> {kind: "data_declaration",             body: $1}
                                              | task_declaration                  -> {kind: "task_declaration",             body: $1}
                                              | function_declaration              -> {kind: "function_declaration",         body: $1}
                                              | checker_declaration               -> {kind: "checker_declaration",          body: $1}
                                              | extern_constraint_declaration     -> {kind: "extern_constraint_declaration", body: $1}
                                              | class_declaration                 -> {kind: "class_declaration",            body: $1}
                                              | interface_class_declaration       -> {kind: "interface_class_declaration",  body: $1}
                                              | class_constructor_declaration     -> {kind: "class_constructor_declaration", body: $1}
                                              | covergroup_declaration            -> {kind: "covergroup_declaration",       body: $1}
                                              | assertion_item_declaration        -> {kind: "assertion_item_declaration",   body: $1}
                                              | semi                              -> {kind: "semi"}

@branch_policy: priority_first
@profiles: ["sv_2023"]
package_or_generate_item_declaration_sv_2023 := local_parameter_declaration semi   -> {kind: "local_parameter_declaration",   body: $1}
                                              | parameter_declaration semi         -> {kind: "parameter_declaration",         body: $1}
                                              | net_declaration                    -> {kind: "net_declaration",               body: $1}
                                              | dpi_import_export                  -> {kind: "dpi_import_export",             body: $1}
                                              | data_declaration                   -> {kind: "data_declaration",              body: $1}
                                              | task_declaration                   -> {kind: "task_declaration",              body: $1}
                                              | function_declaration               -> {kind: "function_declaration",          body: $1}
                                              | checker_declaration                -> {kind: "checker_declaration",           body: $1}
                                              | extern_constraint_declaration      -> {kind: "extern_constraint_declaration", body: $1}
                                              | class_declaration                  -> {kind: "class_declaration",             body: $1}
                                              | interface_class_declaration        -> {kind: "interface_class_declaration",   body: $1}
                                              | class_constructor_declaration      -> {kind: "class_constructor_declaration", body: $1}
                                              | covergroup_declaration             -> {kind: "covergroup_declaration",        body: $1}
                                              | assertion_item_declaration         -> {kind: "assertion_item_declaration",    body: $1}
                                              | semi                               -> {kind: "semi"}

package_or_generate_item_declaration := package_or_generate_item_declaration_sv_2017 -> {kind: "sv_2017", body: $1}
                                       | package_or_generate_item_declaration_sv_2023 -> {kind: "sv_2023", body: $1}

# SV-0029 wave-3 (SV-DOLLAR-LRM-FIDELITY.4): `$unit::` is the IEEE 1800-only
# compilation-unit scope (§3.12.1) — profile-gated out of verilog_2005 via the
# `_sv_only` lift idiom (the SV-0026 posture: v2005 has no $unit surface).
# The `name: {body: "$unit"}` field is LOAD-BEARING, not decorative: package_scope
# consumers gate on typedef-exclusion predicates that drill `$….name.body`
# (`non_typedef_package_scope`'s post predicate, `scoped_or_hierarchical_tf_identifier`'s
# branch predicate). An absent field makes those `$refs` UNRESOLVABLE, which the
# predicate runtime treats as a hard REJECT (the .b.6.2.2-documented ContextualError
# back-out) — trace-proven in .4: `$unit::y` died inside `non_typedef_package_scope`
# with package_scope itself succeeding. With the field present the refs resolve to
# "$unit" — an impossible identifier, so every `lacks_fact…` typedef-exclusion passes
# unconditionally, which is semantically exact: `$unit` can never name a typedef.
@profiles: ["sv_2017", "sv_2023"]
package_scope_dollar_unit_sv_only := kw_sv_dollar_unit_1d99223f scope_resolution
                                  -> {kind: "dollar_unit", name: {body: "$unit"}}

@profiles: ["sv_2017", "sv_2023"]
package_scope := package_identifier scope_resolution             -> {kind: "package",     name: $1}
               | package_scope_dollar_unit_sv_only

