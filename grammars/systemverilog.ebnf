                            | parameter_port_declaration_sv_2023 -> {kind: "sv_2023", body: $1}

@profiles: ["sv_2017", "sv_2023"]
mixed_string_parameter_port_list := kw_type_d0a3e7f8 type_assignment ( !( comma kw_string_ecb25204 ) comma type_assignment )* comma kw_string_ecb25204 list_of_param_assignments ( comma parameter_port_declaration )*
                                 -> {first_type: $2, type_tail: $3, string_list: $6, decl_tail: $7}

@profiles: ["sv_2017", "sv_2023"]
mixed_parameter_port_list := kw_type_d0a3e7f8 list_of_type_assignments comma parameter_port_declaration ( comma parameter_port_declaration )*
                          -> {types: $2, first_decl: $4, decl_tail: $5}

parameter_port_list := hash lparen mixed_string_parameter_port_list rparen
                              -> {kind: "mixed_string",      body: $3}
                     | hash lparen mixed_parameter_port_list rparen
                              -> {kind: "mixed",             body: $3}
                     | hash lparen kw_type_d0a3e7f8 type_assignment ( comma kw_type_d0a3e7f8 type_assignment )* rparen
                              -> {kind: "type_only",         items: [$4, $5::3*]}
                     | hash lparen parameter_port_declaration ( comma parameter_port_declaration )* rparen
                              -> {kind: "declarations",      items: [$3, $4::2*]}
                     | hash lparen list_of_param_assignments ( comma parameter_port_declaration )* rparen
                              -> {kind: "list_then_decls",   first_list: $3, decls: $4}
                     | hash lparen rparen
                              -> {kind: "empty"}

@profiles: ["sv_2017", "verilog_2005"]
parameter_value_assignment_sv_2017 := hash lparen ( list_of_parameter_assignments )? rparen
                                   -> {params: $3}

@profiles: ["sv_2023"]
parameter_value_assignment_sv_2023 := hash lparen ( list_of_parameter_value_assignments )? rparen
                                   -> {params: $3}

parameter_value_assignment := parameter_value_assignment_sv_2017 -> {kind: "sv_2017", body: $1}
                            | parameter_value_assignment_sv_2023 -> {kind: "sv_2023", body: $1}

# SV-CORPUS-GRAD.3.25 — the queue-slice `q[a:$]` bound. IEEE 1800-2017 A.8.4
# footnote 42 states the `$` primary "shall be legal only in a select for a
# queue variable, …", and §7.10.1 states the slice bounds of `Q[a:b]` "may be
# arbitrary integral expressions and, in particular, are not required to be
# constant expressions" — but A.8.4's own production tree routes a select's
# range through `part_select_range → constant_range → constant_expression`,
# whose `constant_primary` has no `$`. So the footnote presupposes a derivation
# the productions do not provide: the contradiction is INSIDE the standard.
# §7.10.4's normative examples are written in this syntax (`q = q[1:$];`,
# `q = q[0:$-1];`, `q = { q[0:pos-1], e, q[pos:$] };`, `q = q[1:$-1];`).
# ⛔ The wider fix (`expression colon expression`, Annex A's evident intent —
# cf. `indexed_range := expression plus colon constant_expression`, which
# already distinguishes select from constant-select on exactly that axis) was
# measured and REFUSED: it takes `v[a++ : b]` and `v[a inside {1,2} : 0]`
# REJECT→PASS, which no part-select may accept. Adding `$` and nothing else is
# the honest minimum. Strictly additive — a bound with no `$` still matches via
# `constant_range`, so no existing match changes. Sibling half of the same
# footnote: `bit_select_expression`'s `kw_dollar` alternative (`q[$]`,
# SV-EXH-PROOF.3.3.4.b.6.2.13).
part_select_range := constant_range            -> {kind: "range",         body: $1}
                   | queue_slice_range_sv_only -> {kind: "queue_slice",   body: $1}
                   | indexed_range             -> {kind: "indexed_range", body: $1}

# IEEE 1364-2005 has neither queues nor a `$` primary, so this rule is gated out
# of the v2005-admitted surface via the same `_sv_only` lift idiom that
# `primary_dollar_sv_only` uses — an ungated rule would hand the `verilog_2005`
# lane a new accepts-invalid form.
@profiles: ["sv_2017", "sv_2023"]
queue_slice_range_sv_only := constant_expression colon queue_slice_dollar_bound
                                  -> {kind: "dollar_hi",   lo: $1, hi: $3}
                           | queue_slice_dollar_bound colon constant_expression
                                  -> {kind: "dollar_lo",   lo: $1, hi: $3}
                           | queue_slice_dollar_bound colon queue_slice_dollar_bound
                                  -> {kind: "dollar_both", lo: $1, hi: $3}

# `$`, and the `$ ± constant_expression` offsets §7.10.4 writes (`q[0:$-1]`).
# ⛔ The offset is a NAMED rule, not an inline `( plus -> {…} | minus -> {…} )`
# group: an inline return annotation inside a parenthesized group is re-read by
# the EBNF frontend as that element's QUANTIFIER (measured via `--dump-gen-ast`:
# `Quantified{element: plus, quantifier: "kind: \"plus\""}`). Codegen then fails
# CLOSED — `Unknown quantifier: kind: "plus"` — so no wrong parser ships; the
# defect is that the message names a quantifier nobody wrote, and
# `--lint-grammar` passes the grammar with only an oblique always-succeeds note.
# Family-neutral (reproduced on a 5-rule synthetic). Routed to
# `EBNF-FRONTEND-SILENT-TRUNCATION.4`.
@profiles: ["sv_2017", "sv_2023"]
queue_slice_dollar_bound := kw_dollar ( queue_slice_dollar_offset )?
                         -> {kind: "dollar", offset: $2}

@profiles: ["sv_2017", "sv_2023"]
queue_slice_dollar_offset := plus constant_expression  -> {kind: "plus",  body: $2}
                           | minus constant_expression -> {kind: "minus", body: $2}

# SV-CORPUS-GRAD.13c.2q: `pass_en_switchtype ::= tranif0 | tranif1 | rtranif1 | rtranif0` — the
# same lost-digit collapse as `enable_gatetype` above, from the same Annex A block.
pass_en_switchtype := kw_tranif0_96ae6b37 -> {kind: "tranif0"}
                   | kw_tranif1_41e0f26e -> {kind: "tranif1"}
                   | kw_rtranif0_caee0cc0 -> {kind: "rtranif0"}
                   | kw_rtranif1_91fafa05 -> {kind: "rtranif1"}

pass_enable_switch_instance := ( name_of_instance )? lparen inout_terminal comma inout_terminal comma enable_terminal rparen
                            -> {name: $1, in1: $3, in2: $5, enable: $7}

pass_switch_instance := ( name_of_instance )? lparen inout_terminal comma inout_terminal rparen
                    -> {name: $1, in1: $3, in2: $5}

pass_switchtype := kw_tran_8cc27d13   -> {kind: "tran"}
                 | kw_rtran_edbf7838  -> {kind: "rtran"}

path_declaration := simple_path_declaration semi          -> {kind: "simple",          body: $1}
                  | edge_sensitive_path_declaration semi  -> {kind: "edge_sensitive",  body: $1}
                  | state_dependent_path_declaration semi -> {kind: "state_dependent", body: $1}

path_delay_expression := constant_mintypmax_expression
                      -> {body: $1}

path_delay_value := list_of_path_delay_expressions          -> {kind: "bare",   body: $1}
                  | lparen list_of_path_delay_expressions rparen -> {kind: "paren",  body: $2}

@profiles: ["sv_2017"]
pattern_sv_2017 := dot variable_identifier
                        -> {kind: "variable_capture", name: $2}
                | dot_star
                        -> {kind: "wildcard"}
                | constant_expression
                        -> {kind: "expression",       body: $1}
                | kw_tagged_8e1ec218 member_identifier ( pattern )?
                        -> {kind: "tagged",           name: $2, sub_pattern: $3}
                | tick lbrace pattern ( comma pattern )* rbrace
                        -> {kind: "ordered",          patterns: [$3, $4::2*]}
                | tick lbrace assignment_pattern_entry ( comma assignment_pattern_entry )* rbrace
                        -> {kind: "named",            entries: [$3, $4::2*]}

@profiles: ["sv_2023"]
pattern_sv_2023 := lparen pattern rparen
                        -> {kind: "parenthesized",   body: $2}
                | dot variable_identifier
                        -> {kind: "variable_capture", name: $2}
                | dot star
                        -> {kind: "wildcard"}
                | constant_expression
                        -> {kind: "expression",       body: $1}
                | kw_tagged_8e1ec218 member_identifier ( pattern )?
                        -> {kind: "tagged",           name: $2, sub_pattern: $3}
                | tick lbrace pattern ( comma pattern )* rbrace
                        -> {kind: "ordered",          patterns: [$3, $4::2*]}
                | tick lbrace assignment_pattern_entry ( comma assignment_pattern_entry )* rbrace
                        -> {kind: "named",            entries: [$3, $4::2*]}

@profiles: ["sv_2017", "sv_2023"]
pattern := pattern_sv_2017 -> {kind: "sv_2017", body: $1}
         | pattern_sv_2023 -> {kind: "sv_2023", body: $1}

pcontrol_terminal := expression
                  -> {body: $1}

polarity_operator := plus  -> {kind: "plus"}
                   | minus -> {kind: "minus"}

port := dot port_identifier lparen ( port_expression )? rparen
        -> {kind: "named", name: $2, expr: $4}
     | ( port_expression )?
        -> {kind: "expression", expr: $1}

port_declaration := attribute_instance* inout_declaration
                            -> {kind: "inout",     attributes: $1, body: $2}
                  | attribute_instance* input_declaration
                            -> {kind: "input",     attributes: $1, body: $2}
                  | attribute_instance* output_declaration
                            -> {kind: "output",    attributes: $1, body: $2}
                  | attribute_instance* ref_declaration
                            -> {kind: "ref",       attributes: $1, body: $2}
                  | attribute_instance* interface_port_declaration
                            -> {kind: "interface", attributes: $1, body: $2}

@profiles: ["sv_2017", "sv_2023"]
port_direction_sv_only := kw_ref_69449f99 -> {kind: "ref"}

port_direction := kw_input_140f86aa  -> {kind: "input"}
               | kw_output_1029d676 -> {kind: "output"}
               | kw_inout_c900aaa9  -> {kind: "inout"}
               | port_direction_sv_only

port_expression := port_reference
                          -> {kind: "single", body: $1}
                | lbrace port_reference ( comma port_reference )* rbrace
                          -> {kind: "list",   body: [$2, $3::2*]}

port_identifier := declaration_identifier

port_reference := port_identifier constant_select
               -> {name: $1, select: $2}

@profiles: ["sv_2017", "verilog_2005"]
primary_sv_2017 := @probe_sample: "1" primary_literal
                        -> {kind: "literal",            body: $1}
                 | call_primary
                        -> {kind: "call",               body: $1}
                 | @probe_sample: "a" ( primary_hier_scope_prefix )? hierarchical_identifier select
                        -> {kind: "hierarchical",       scope: $1, name: $2, select: $3}
                 | empty_unpacked_array_concatenation
                        -> {kind: "empty_array_concat", body: $1}
                 | multiple_concatenation ( lbrack range_expression rbrack )?
                        -> {kind: "multiple_concat",    body: $1, select: $2}
                 | concatenation ( lbrack range_expression rbrack )?
                        -> {kind: "concat",             body: $1, select: $2}
                 | let_expression
                        -> {kind: "let",                body: $1}
                 | lparen mintypmax_expression rparen
                        -> {kind: "paren",              body: $2}
                 | cast
                        -> {kind: "cast",               body: $1}
                 | assignment_pattern_expression
                        -> {kind: "assign_pattern",     body: $1}
                 | streaming_concatenation
                        -> {kind: "streaming_concat",   body: $1}
                 | sequence_method_call
                        -> {kind: "sequence_method",    body: $1}
                 | @probe_sample: "this" kw_this_c2543fff
                        -> {kind: "this"}
                 | primary_dollar_sv_only
                 | kw_null_2be88ca4 kw_class_qualifier_fa08937d colon assign ( kw_local_939bb46a scope_resolution kw_n_43_0286dd55 )? ( instance_or_class_scope )?
                        -> {kind: "null_class_assign",  local_n: $5, scope: $6}
                 | scope_randomize_sv_only

# SV-0029 wave-3 (SV-DOLLAR-LRM-FIDELITY.4): the bare-`$` primary is IEEE 1800-only
# (A.8.4 `primary ::= … $ …`; 1364-2005 has no `$` primary) — profile-gated out of
# the v2005-admitted `primary_sv_2017` via the `_sv_only` lift idiom. The sibling
# `primary_sv_2023` / `method_call_receiver_*` hosts are never verilog_2005-active,
# so their inline `kw_sv_dollar_04da59ec` branches stay as-is.
@profiles: ["sv_2017", "sv_2023"]
primary_dollar_sv_only := kw_sv_dollar_04da59ec
                       -> {kind: "system_dollar"}

# SV-CORPUS-GRAD.13c.2v slice 1 (SV-0065): IEEE 1800-2017/2023 A.8.4 spells the call
# alternative of `primary` as `function_subroutine_call`, and A.8.2 expands that to
# `subroutine_call ::= tf_call | system_tf_call | method_call | [ std :: ] randomize_call`.
# PGEN renders it as `call_primary` — the postfix-chain rule the LR lift authored — whose
# eleven alternatives do NOT include `randomize_call`. That alternative exists only on the
# sibling wrapper `function_subroutine_call`, which no expression path reaches, so the
# `with constraint_block` tail of a SCOPE randomize was unreachable from every expression
# while the statement path (`subroutine_call`) and the constant path (`constant_function_call`)
# both had it. Lifted as a `_sv_only` rule — the same idiom as `primary_dollar_sv_only`
# directly above — because `primary_sv_2017` is verilog_2005-admitted and IEEE 1364-2005 has
# no `randomize`; the gate keeps `verilog_2005` at REJECT.
@profiles: ["sv_2017", "sv_2023"]
scope_randomize_sv_only := ( kw_std_55ec981f scope_resolution )? randomize_call
                        -> {kind: "scope_randomize", std_scope: $1, body: $2}

primary_hier_scope_prefix := kw_class_qualifier_fa08937d -> {kind: "class_qualifier", body: $1}
                           | non_typedef_package_scope    -> {kind: "package_scope",   body: $1}
                           # SV-EXH-PROOF.3.3.4.b.6.2.37.3 — H2 follow-up: class-scoped
                           # member access (`Class::member`, `super_t::m_name`,
                           # `pkg::Class::staticMember`) as a primary expression. Per
                           # IEEE 1800 §A.8.4 the LRM's `primary` accepts a `class_qualifier`
                           # prefix and the LRM's `class_qualifier` nonterminal expands to
                           # `[ local:: ] [ implicit_class_handle . | class_scope ]`.
                           # pgen's `primary_hier_scope_prefix` was missing the `class_scope`
                           # branch — surfaced by H2's furthest_position deepening into
                           # `uvm_callbacks #(T,CB)` at uvm_pkg line ~25726 where
                           # `super_t::m_typename = tname` (typedef-aliased parameterized
                           # base scoped-member assignment) was unparseable. `class_scope` is
                           # gated by `known_unscoped_class_scope_class_identifier`'s
                           # `fact_attribute_equals(type_name, $body, declaration_family, class)`
                           # predicate so this branch only fires for known class names —
                           # safe to add as a sibling to `non_typedef_package_scope`.
                           | class_scope                  -> {kind: "class_scope",     body: $1}

instance_or_class_scope := implicit_class_handle dot -> {kind: "instance",    handle: $1}
                         | class_scope               -> {kind: "class_scope", body: $1}

@profiles: ["sv_2023"]
primary_sv_2023 := primary_literal
                        -> {kind: "literal",            body: $1}
                 | call_primary ( lbrack range_expression rbrack )?
                        -> {kind: "call",               body: $1, select: $2}
                 | ( primary_hier_scope_prefix )? hierarchical_identifier select
                        -> {kind: "hierarchical",       scope: $1, name: $2, select: $3}
                 | empty_unpacked_array_concatenation
                        -> {kind: "empty_array_concat", body: $1}
                 | multiple_concatenation ( lbrack range_expression rbrack )?
                        -> {kind: "multiple_concat",    body: $1, select: $2}
                 | concatenation ( lbrack range_expression rbrack )?
                        -> {kind: "concat",             body: $1, select: $2}
                 | let_expression
                        -> {kind: "let",                body: $1}
                 | lparen mintypmax_expression rparen
                        -> {kind: "paren",              body: $2}
                 | cast
                        -> {kind: "cast",               body: $1}
                 | assignment_pattern_expression
                        -> {kind: "assign_pattern",     body: $1}
                 | streaming_concatenation
                        -> {kind: "streaming_concat",   body: $1}
                 | sequence_method_call
                        -> {kind: "sequence_method",    body: $1}
                 | kw_this_c2543fff
                        -> {kind: "this"}
                 | kw_sv_dollar_04da59ec
                        -> {kind: "system_dollar"}
                 | kw_null_2be88ca4 kw_class_qualifier_fa08937d colon assign ( kw_local_939bb46a scope_resolution kw_n_48_64e095fe )? ( instance_or_class_scope )?
                        -> {kind: "null_class_assign",  local_n: $5, scope: $6}
                 | scope_randomize_sv_only

primary := primary_sv_2017 -> {kind: "sv_2017", body: $1}
         | primary_sv_2023 -> {kind: "sv_2023", body: $1}

@profiles: ["sv_2017", "sv_2023"]
primary_literal_sv_only := time_literal            -> {kind: "time_literal",          body: $1}
                         | unbased_unsized_literal -> {kind: "unbased_unsized_literal", body: $1}

primary_literal := number                  -> {kind: "number",                body: $1}
                 | primary_literal_sv_only
                 | string_literal          -> {kind: "string_literal",        body: $1}

@profiles: ["sv_2017", "sv_2023"]
procedural_assertion_statement := concurrent_assertion_statement -> {kind: "concurrent",             body: $1}
                                | immediate_assertion_statement  -> {kind: "immediate",              body: $1}
                                | checker_instantiation          -> {kind: "checker_instantiation",  body: $1}

procedural_continuous_assignment := kw_assign_9009b730 variable_assignment
                                         -> {kind: "assign",          body: $2}
                                  | kw_deassign_1af170b4 variable_lvalue
                                         -> {kind: "deassign",        target: $2}
                                  | kw_force_fafec1e5 variable_assignment
                                         -> {kind: "force_variable",  body: $2}
                                  | kw_force_fafec1e5 net_assignment
                                         -> {kind: "force_net",       body: $2}
                                  | kw_release_01f561ac variable_lvalue
                                         -> {kind: "release_variable", target: $2}
                                  | kw_release_01f561ac net_lvalue
                                         -> {kind: "release_net",     target: $2}

procedural_timing_control := delay_control -> {kind: "delay", body: $1}
                           | event_control -> {kind: "event", body: $1}
                           | cycle_delay   -> {kind: "cycle", body: $1}

procedural_timing_control_statement := procedural_timing_control statement_or_null
                                    -> {control: $1, body: $2}

@profiles: ["sv_2017"]
production_sv_2017 := ( data_type_or_void )? production_identifier ( lparen tf_port_list rparen )? colon rs_rule ( bitwise_or rs_rule )* semi
                   -> {return_type: $1, name: $2, ports: $3, rules: [$5, $6::2*]}

@profiles: ["sv_2017"]
production := production_sv_2017
           -> {body: $1}

@profiles: ["sv_2017"]
production_identifier_sv_2017 := non_keyword_identifier

@profiles: ["sv_2017"]
production_identifier := production_identifier_sv_2017

@profiles: ["sv_2017"]
production_item_sv_2017 := production_identifier ( lparen list_of_arguments rparen )?
                        -> {name: $1, args: $2}

@profiles: ["sv_2017"]
production_item := production_item_sv_2017
                -> {body: $1}

@sample: "program p(input logic a);"
program_ansi_header := attribute_instance* kw_program_81d9aeea ( lifetime )? program_identifier package_import_declaration* ( parameter_port_list )? ( list_of_port_declarations )? semi
                    -> {attributes: $1, lifetime: $3, name: $4, imports: $5, parameters: $6, ports: $7}

@profiles: ["sv_2017"]
program_declaration_sv_2017 := @sample: "program p(a); endprogram" program_nonansi_header ( timeunits_declaration )? program_item* kw_endprogram_6b609b1f ( colon program_identifier )?
                                 -> {kind: "nonansi", header: $1, timeunits: $2, items: $3, end_label: $5}
                             | @sample: "program p; endprogram" program_ansi_header ( timeunits_declaration )? non_port_program_item* kw_endprogram_6b609b1f ( colon program_identifier )?
                                 -> {kind: "ansi", header: $1, timeunits: $2, items: $3, end_label: $5}
                             | @sample: "program p(.*); endprogram" attribute_instance* kw_program_81d9aeea program_identifier lparen dot_star rparen semi ( timeunits_declaration )? program_item* kw_endprogram_6b609b1f ( colon program_identifier )?
                                 -> {kind: "wildcard", attributes: $1, name: $3, timeunits: $8, items: $9, end_label: $11}
                             | @sample: "extern program p(a);" kw_extern_bf1ee311 program_nonansi_header
                                 -> {kind: "extern_nonansi", header: $2}
                             | @sample: "extern program p;" kw_extern_bf1ee311 program_ansi_header
                                 -> {kind: "extern_ansi", header: $2}

@profiles: ["sv_2023"]
program_declaration_sv_2023 := @sample: "program p(a); endprogram" program_nonansi_header ( timeunits_declaration )? program_item* kw_endprogram_6b609b1f ( colon program_identifier )?
                                 -> {kind: "nonansi", header: $1, timeunits: $2, items: $3, end_label: $5}
                             | @sample: "program p; endprogram" program_ansi_header ( timeunits_declaration )? non_port_program_item* kw_endprogram_6b609b1f ( colon program_identifier )?
                                 -> {kind: "ansi", header: $1, timeunits: $2, items: $3, end_label: $5}
                             | @sample: "program p(.*); endprogram" attribute_instance* kw_program_81d9aeea program_identifier lparen dot star rparen semi ( timeunits_declaration )? program_item* kw_endprogram_6b609b1f ( colon program_identifier )?
                                 -> {kind: "wildcard", attributes: $1, name: $3, timeunits: $9, items: $10, end_label: $12}
                             | @sample: "extern program p(a);" kw_extern_bf1ee311 program_nonansi_header
                                 -> {kind: "extern_nonansi", header: $2}
                             | @sample: "extern program p;" kw_extern_bf1ee311 program_ansi_header
                                 -> {kind: "extern_ansi", header: $2}

@profiles: ["sv_2017", "sv_2023"]
program_declaration := @sample: "program p; endprogram" program_declaration_sv_2017
                              -> {kind: "sv_2017", body: $1}
                     | @sample: "program p; endprogram" program_declaration_sv_2023
                              -> {kind: "sv_2023", body: $1}

@profiles: ["sv_2017"]
program_generate_item_sv_2017 := loop_generate_construct           -> {kind: "loop",         body: $1}
                                | conditional_generate_construct  -> {kind: "conditional",  body: $1}
                                | generate_region                 -> {kind: "region",       body: $1}
                                | elaboration_system_task         -> {kind: "elaboration",  body: $1}

@profiles: ["sv_2023"]
program_generate_item_sv_2023 := loop_generate_construct                -> {kind: "loop",                  body: $1}
                                | conditional_generate_construct       -> {kind: "conditional",           body: $1}
                                | generate_region                      -> {kind: "region",                body: $1}
                                | elaboration_severity_system_task     -> {kind: "elaboration_severity",  body: $1}

@profiles: ["sv_2017", "sv_2023"]
program_generate_item := program_generate_item_sv_2017 -> {kind: "sv_2017", body: $1}
                       | program_generate_item_sv_2023 -> {kind: "sv_2023", body: $1}

program_identifier := declaration_identifier

program_instantiation := program_identifier ( parameter_value_assignment )? hierarchical_instance ( comma hierarchical_instance )* semi
                      -> {name: $1, params: $2, instances: [$3, $4::2*]}

program_item := port_declaration semi  -> {kind: "port_declaration", body: $1}
              | non_port_program_item   -> {kind: "non_port_item",   body: $1}

@sample: "program p(a,b);"
program_nonansi_header := attribute_instance* kw_program_81d9aeea ( lifetime )? program_identifier package_import_declaration* ( parameter_port_list )? list_of_ports semi
                       -> {attributes: $1, lifetime: $3, name: $4, imports: $5, parameters: $6, ports: $7}

@profiles: ["sv_2017", "sv_2023"]
property_actual_arg := property_expr        -> {kind: "property_expr",   body: $1}
                     | sequence_actual_arg  -> {kind: "sequence_actual", body: $1}

@profiles: ["sv_2017", "sv_2023"]
property_case_item := @probe_sample: "1: 1;" expression_or_dist ( comma expression_or_dist )* colon property_expr semi
