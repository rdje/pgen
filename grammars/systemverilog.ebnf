library_declaration := kw_library_00299a40 library_identifier kw_file_path_spec_c26c9dc9 ( comma kw_file_path_spec_c26c9dc9 )* ( minus kw_incdir_e08adf20 kw_file_path_spec_c26c9dc9 ( comma kw_file_path_spec_c26c9dc9 )* )? semi
                    -> {name: $2, paths: [$3, $4::2*], incdir: $5}

library_description := library_declaration   -> {kind: "library_declaration", body: $1}
                     | include_statement     -> {kind: "include",             body: $1}
                     | config_declaration    -> {kind: "config",              body: $1}
                     | semi                  -> {kind: "semi"}

library_identifier := non_keyword_identifier

library_text := library_description*
