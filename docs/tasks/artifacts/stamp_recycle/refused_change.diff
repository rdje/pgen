+/// `PGEN-RGX-0078-0210` — the GENERATION-STAMPED failure memo:
+/// PARSE-TERMINATION.6's lean fail set made thread-recyclable WITHOUT an
+/// O(capacity) reset (the mechanism that refused the `-0209` eager-clear
+/// form: hashbrown `clear()` memsets the whole ctrl array, taxing every
+/// small parse with the high-water capacity of the largest prior parse).
+/// Every entry carries the generation stamp of the take() that recorded it;
+/// [`ParseScratchRecyclable::reset_recycled`] is ONE u64 increment, after
+/// which every prior-parse entry is semantically ABSENT — [`Self::contains`]
+/// refuses it and [`Self::insert`] revalidates it in place (no growth on
+/// revalidation). Invalidation is therefore O(1), never O(high-water
+/// capacity) — the `-0209` design law mechanized.
+#[derive(Debug, Default)]
+pub struct StampedFailSet {
+    /// key → the generation stamp under which the failure was recorded.
+    entries: rustc_hash::FxHashMap<(RuleId, usize), u64>,
+    /// The current parse's generation. Entries with any other stamp are
+    /// invisible (stale) and get overwritten in place on re-insert.
+    generation: u64,
+}
+
+impl StampedFailSet {
+    /// Memory backstop (pre-registered, `-0210` §2): when the carried
+    /// stale-key union exceeds this, the next recycle clears the table
+    /// (capacity kept). ≥12× the largest observed live population (≈21k on
+    /// the corpus-max cell), so the O(capacity) memset amortizes to
+    /// sub-0.1 ns per parse while bounding per-thread memory.
+    const MAX_CARRIED_ENTRIES: usize = 1 << 18;
+
+    /// Stamp-checked membership: a hit requires the CURRENT generation —
+    /// a prior parse's entry is absence, not a hit (cross-parse replay
+    /// would be unsound: same (rule, position) key, different input).
+    #[inline]
+    pub fn contains(&self, key: &(RuleId, usize)) -> bool {
+        self.entries.get(key) == Some(&self.generation)
+    }
+
+    /// Record a failure under the current generation (revalidates a stale
+    /// entry in place — the slot is reused, the table does not grow).
+    #[inline]
+    pub fn insert(&mut self, key: (RuleId, usize)) {
+        self.entries.insert(key, self.generation);
+    }
+
+    /// Grow only when the recycled high-water capacity is below the
+    /// caller's sizing target (the emitted K3a formula) — the warm path is
+    /// a no-op. `len <= capacity < target` makes the `reserve` argument the
+    /// exact shortfall; `saturating_sub` keeps the expression total.
+    pub fn ensure_capacity(&mut self, target: usize) {
+        if self.entries.capacity() < target {
+            self.entries.reserve(target.saturating_sub(self.entries.len()));
+        }
+    }
+
+    /// Current-generation (live) view — the env-gated memo-stats debug
+    /// surface only; O(carried table).
+    pub fn iter(&self) -> impl Iterator<Item = &(RuleId, usize)> + '_ {
+        let generation = self.generation;
+        self.entries
+            .iter()
+            .filter(move |(_, stamp)| **stamp == generation)
+            .map(|(key, _)| key)
+    }
+
+    /// Live-entry count — debug-stats surface only; O(carried table).
+    pub fn len(&self) -> usize {
+        self.iter().count()
+    }
+
+    /// Live-view emptiness — debug/test surface only.
+    pub fn is_empty(&self) -> bool {
+        self.iter().next().is_none()
+    }
+
+    /// Underlying table capacity (test/introspection surface).
+    pub fn capacity(&self) -> usize {
+        self.entries.capacity()
+    }
+
+    /// Carried (live + stale) entry count — the backstop's input
+    /// (test/introspection surface).
+    pub(crate) fn carried_len(&self) -> usize {
+        self.entries.len()
+    }
+}
+
+impl ParseScratchRecyclable for StampedFailSet {
+    fn scratch_slot() -> &'static std::thread::LocalKey<std::cell::Cell<Option<Self>>> {
+        std::thread_local! {
+            static MEMO_FAIL_SCRATCH:
+                std::cell::Cell<Option<StampedFailSet>> =
+                    const { std::cell::Cell::new(None) };
+        }
+        &MEMO_FAIL_SCRATCH
+    }
+    fn reset_recycled(&mut self) {
+        // O(1) invalidation: one stamp bump. The amortized backstop below
+        // is the ONLY path that ever pays an O(capacity) clear, and it
+        // fires at most once per ~2^18 accumulated distinct keys.
+        if self.entries.len() >= Self::MAX_CARRIED_ENTRIES {
+            self.entries.clear();
+        }
+        self.generation += 1;
+    }
+    fn empty_shell() -> Self {
+        Self::default()
+    }
+}
+
+/// `PGEN-RGX-0078-0210` — the generation-stamped STORE-TAINTED failure memo
+/// (MEMO-STORE-SOUNDNESS.2). Each entry carries `(generation, write_epoch)`:
+/// a replay needs the CURRENT generation AND (checked by the caller) an
+/// unchanged store epoch. The stamp is a SOUNDNESS device here, not just a
+/// recycling one: a recycled state resets `write_epoch` to 0, so without the
+/// stamp a prior parse's entry could collide with an equal epoch value and
+/// replay a failure recorded against a different input/store.
+#[derive(Debug, Default)]
+pub struct StampedTaintedFailMap {
+    /// key → (generation stamp, store write-epoch at insert).
+    entries: rustc_hash::FxHashMap<(RuleId, usize), (u64, u64)>,
+    generation: u64,
+}
+
+impl StampedTaintedFailMap {
+    /// Memory backstop — the tainted population is tiny by design (the C2
+    /// sizing caps pre-allocation at 256; measured ≤54 live entries), so
+    /// the cap sits far above any real accumulation.
+    const MAX_CARRIED_ENTRIES: usize = 1 << 12;
+
+    /// Stamp-checked lookup: the recorded epoch is returned only for a
+    /// CURRENT-generation entry; anything stale is absence.
+    #[inline]
+    pub fn get(&self, key: &(RuleId, usize)) -> Option<&u64> {
+        match self.entries.get(key) {
+            Some((stamp, epoch)) if *stamp == self.generation => Some(epoch),
+            _ => None,
+        }
+    }
+
+    /// Record an epoch-stamped tainted failure under the current
+    /// generation (revalidates a stale entry in place).
+    #[inline]
+    pub fn insert(&mut self, key: (RuleId, usize), epoch: u64) {
+        self.entries.insert(key, (self.generation, epoch));
+    }
+
+    /// Evict an entry (the caller's stale-epoch eviction path).
+    #[inline]
+    pub fn remove(&mut self, key: &(RuleId, usize)) {
+        self.entries.remove(key);
+    }
+
+    /// See [`StampedFailSet::ensure_capacity`].
+    pub fn ensure_capacity(&mut self, target: usize) {
+        if self.entries.capacity() < target {
+            self.entries.reserve(target.saturating_sub(self.entries.len()));
+        }
+    }
+
+    /// Current-generation (live) `(key, epoch)` view — debug-stats surface
+    /// only; O(carried table).
+    pub fn iter(&self) -> impl Iterator<Item = (&(RuleId, usize), &u64)> + '_ {
+        let generation = self.generation;
+        self.entries
+            .iter()
+            .filter(move |(_, (stamp, _))| *stamp == generation)
+            .map(|(key, (_, epoch))| (key, epoch))
+    }
+
+    /// Live-entry count — debug-stats surface only; O(carried table).
+    pub fn len(&self) -> usize {
+        self.iter().count()
+    }
+
+    /// Live-view emptiness — debug/test surface only.
+    pub fn is_empty(&self) -> bool {
+        self.iter().next().is_none()
+    }
+
+    /// Underlying table capacity (test/introspection surface).
+    pub fn capacity(&self) -> usize {
+        self.entries.capacity()
+    }
+
+    /// Carried (live + stale) entry count (test/introspection surface).
+    pub(crate) fn carried_len(&self) -> usize {
+        self.entries.len()
+    }
+}
+
+impl ParseScratchRecyclable for StampedTaintedFailMap {
+    fn scratch_slot() -> &'static std::thread::LocalKey<std::cell::Cell<Option<Self>>> {
+        std::thread_local! {
+            static MEMO_FAIL_TAINTED_SCRATCH:
+                std::cell::Cell<Option<StampedTaintedFailMap>> =
+                    const { std::cell::Cell::new(None) };
+        }
+        &MEMO_FAIL_TAINTED_SCRATCH
+    }
+    fn reset_recycled(&mut self) {
+        // See `StampedFailSet::reset_recycled` — O(1) stamp bump plus the
+        // amortized backstop.
+        if self.entries.len() >= Self::MAX_CARRIED_ENTRIES {
+            self.entries.clear();
+        }
+        self.generation += 1;
+    }
+    fn empty_shell() -> Self {
+        Self::default()
+    }
+}
+
+impl ParseScratchRecyclable for RecursionGuard {
+    fn scratch_slot() -> &'static std::thread::LocalKey<std::cell::Cell<Option<Self>>> {
+        std::thread_local! {
+            static RECURSION_GUARD_SCRATCH:
+                std::cell::Cell<Option<RecursionGuard>> =
+                    const { std::cell::Cell::new(None) };
+        }
+        &RECURSION_GUARD_SCRATCH
+    }
+    fn reset_recycled(&mut self) {
+        self.parse_stack.clear();
+        self.rule_id_stack.clear();
+        self.cycle_cache.clear();
+        // `max_depth` is a construction parameter — the emitted `new()`
+        // applies it via `set_max_depth` right after `take()`.
+        self.max_depth = 0;
+    }
+    fn empty_shell() -> Self {
+        Self::default()
+    }
+}
+
+impl ParseScratchRecyclable for semantic_runtime::SemanticRuntimeState {
+    fn scratch_slot() -> &'static std::thread::LocalKey<std::cell::Cell<Option<Self>>> {
+        std::thread_local! {
+            static SEMANTIC_STATE_SCRATCH:
+                std::cell::Cell<Option<semantic_runtime::SemanticRuntimeState>> =
+                    const { std::cell::Cell::new(None) };
+        }
+        &SEMANTIC_STATE_SCRATCH
+    }
+    fn reset_recycled(&mut self) {
+        self.recycle_reset();
+    }
+    fn empty_shell() -> Self {
+        Self::recycle_shell()
+    }
+}
