+    /// The STEP-2b in-place flatten loop over the target `Quantified`:
+    /// declares and fills `__pgen_arr_nodes`. Each iteration builds the item
+    /// child on the STACK and peels `Alternative` wrappers off its content —
+    /// the verbatim fold's peel entered one step late, because the elided
+    /// iteration wrapper's content was exactly `Alternative(alloc(child))` —
+    /// then re-emits through the fold's exact runtime arms with the wrapper's
+    /// inherit constants (`"quantified"`, span `0..0`). Byte-exact with the
+    /// verbatim scaffolding + fold: the elided allocs and the intermediate
+    /// Vec are unobservable in the fold's output.
+    fn dv_carrying_flatten_stmts(&self, target: &ASTNode, rule_name: &str) -> Result<TokenStream> {
+        let Some(child_rule) = self.dv_quantified_item_node_ref(target) else {
+            anyhow::bail!(
+                "in-place carrying flatten target of rule '{rule_name}' is not an admissible quantified node-form reference — emitter admission drift"
+            );
+        };
+        let build_target = format_ident!("cascade_build_{}", child_rule);
+        Ok(quote! {
+            let __pgen_quant_n = match parser.deriv_next_event() {
+                crate::ast_pipeline::DerivEvent::QuantCount(__pgen_n) => __pgen_n,
+                __pgen_other => unreachable!(
+                    "derivation-tape drift in rule '{}': expected QuantCount, found {:?}",
+                    #rule_name,
+                    __pgen_other,
+                ),
+            };
+            let mut __pgen_arr_nodes: Vec<&'input ParseNode<'input>> =
+                Vec::with_capacity(__pgen_quant_n);
+            for _ in 0..__pgen_quant_n {
+                let __pgen_child = parser.#build_target();
+                let mut __pgen_peeled = __pgen_child.content;
+                while let ParseContent::Alternative(__pgen_alt) = __pgen_peeled {
+                    __pgen_peeled = __pgen_alt.content.clone();
+                }
+                match __pgen_peeled {
+                    ParseContent::Sequence(__pgen_inner_nodes)
+                    | ParseContent::Quantified(__pgen_inner_nodes, _) => {
+                        for __pgen_inner_node in __pgen_inner_nodes {
+                            __pgen_arr_nodes.push(__pgen_inner_node);
+                        }
+                    }
+                    ParseContent::Shaped(PgenValue::Array(__pgen_values)) => {
+                        for __pgen_value in __pgen_values {
+                            __pgen_arr_nodes.push(parser.arena.alloc(ParseNode {
+                                rule_name: "quantified",
+                                content: ParseContent::Shaped(*__pgen_value),
