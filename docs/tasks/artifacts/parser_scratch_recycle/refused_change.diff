+/// `PGEN-RGX-0078-0209` — a parser component whose STORAGE is recycled across
+/// parses through a per-type thread-local slot (the [`ThinMemoScratchLease`]
+/// pattern generalized). Implementors are LIFETIME-FREE by requirement: a
+/// thread-local outlives any single parse, so `'input`-parameterized
+/// containers (the rich memo, the thin-entry vec, the derivation tape) are
+/// deliberately NOT eligible — the `'static` supertrait makes that design
+/// predicate compiler-enforced.
+pub trait ParseScratchRecyclable: Default + 'static {
+    /// The per-type thread slot this component recycles through.
+    fn scratch_slot() -> &'static std::thread::LocalKey<std::cell::Cell<Option<Self>>>;
+    /// Re-establish the CONSTRUCTOR's postcondition on a recycled instance,
+    /// keeping its allocations warm. Runs on every [`ParseScratchLease::take`]
+    /// — a pooled object's reset must match `new()`/`default()` semantics,
+    /// not an intra-instance reset's (e.g. `reset_for_new_parse` PRESERVES
+    /// facts by contract; a recycled state must NOT).
+    fn reset_recycled(&mut self);
+    /// An alloc-free placeholder swapped into a returning lease so the
+    /// return path constructs nothing. Never used as a live component —
+    /// it is dropped by the lease's own drop glue immediately after the
+    /// swap.
+    fn empty_shell() -> Self;
+}
+
+/// RAII lease on a thread-recycled parser component (see
+/// [`ParseScratchRecyclable`]). Generated parsers hold one as a FIELD —
+/// taking the component at construction and returning it when the parser
+/// drops on ANY exit path, without an `impl Drop` on the parser struct
+/// itself (the `-0205` lease-as-field discipline). `Deref`/`DerefMut` keep
+/// every component access site source-identical.
+///
+/// ⛔ The `Default` impl is LOAD-BEARING, not a convenience: the emitted
+/// semantic-transaction wrapper `std::mem::take`s the state FIELD per
+/// annotation-bearing rule entry and restores it by assignment
+/// (SV-EXH-PROOF.3.3.3). That leftover must (a) deref to a VALID component
+/// (`T::default()` — for the state, `default() == new()`, the documented
+/// panic-robustness doctrine) and (b) cost exactly what the pre-lease
+/// leftover cost. A `Default` lease is therefore INACTIVE: it drops plainly,
+/// with no thread-slot traffic — only construction-time `take()` leases
+/// recycle.
+#[derive(Debug)]
+pub struct ParseScratchLease<T: ParseScratchRecyclable> {
+    inner: T,
+    /// True only for `take()` leases — the parser-boundary holders that
+    /// return their component to the thread slot on drop.
+    active: bool,
+}
+
+impl<T: ParseScratchRecyclable> ParseScratchLease<T> {
+    /// Take the thread's recycled component (or a fresh default on the cold
+    /// path) and re-establish the constructor postcondition on it.
+    pub fn take() -> Self {
+        let mut inner = T::scratch_slot().with(|cell| cell.take()).unwrap_or_default();
+        inner.reset_recycled();
+        Self { inner, active: true }
+    }
+}
+
+impl<T: ParseScratchRecyclable> Default for ParseScratchLease<T> {
+    /// The `mem::take` leftover: a plain, NON-recycling holder of a valid
+    /// default component — byte-cost-identical to the pre-lease leftover.
+    fn default() -> Self {
+        Self {
+            inner: T::default(),
+            active: false,
+        }
+    }
+}
+
+impl<T: ParseScratchRecyclable> Drop for ParseScratchLease<T> {
+    fn drop(&mut self) {
+        if self.active {
+            // Swap in the alloc-free shell (freed as nothing by the drop
+            // glue) and store the real component. `Cell::set` drops any
+            // previously stored component — last return wins the slot, the
+            // `-0205` two-parsers-one-thread semantics.
+            let component = std::mem::replace(&mut self.inner, T::empty_shell());
+            T::scratch_slot().with(|cell| cell.set(Some(component)));
+        }
+    }
+}
+
+impl<T: ParseScratchRecyclable> std::ops::Deref for ParseScratchLease<T> {
+    type Target = T;
+    fn deref(&self) -> &T {
+        &self.inner
+    }
+}
+
+impl<T: ParseScratchRecyclable> std::ops::DerefMut for ParseScratchLease<T> {
+    fn deref_mut(&mut self) -> &mut T {
+        &mut self.inner
+    }
+}
+
+impl ParseScratchRecyclable for rustc_hash::FxHashSet<(RuleId, usize)> {
+    fn scratch_slot() -> &'static std::thread::LocalKey<std::cell::Cell<Option<Self>>> {
+        std::thread_local! {
+            static MEMO_FAIL_SCRATCH:
+                std::cell::Cell<Option<rustc_hash::FxHashSet<(RuleId, usize)>>> =
+                    const { std::cell::Cell::new(None) };
+        }
+        &MEMO_FAIL_SCRATCH
+    }
+    fn reset_recycled(&mut self) {
+        self.clear();
+    }
+    fn empty_shell() -> Self {
+        Self::default()
+    }
+}
+
+impl ParseScratchRecyclable for rustc_hash::FxHashMap<(RuleId, usize), u64> {
+    fn scratch_slot() -> &'static std::thread::LocalKey<std::cell::Cell<Option<Self>>> {
+        std::thread_local! {
