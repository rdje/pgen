+                std::cell::Cell<Option<rustc_hash::FxHashMap<(RuleId, usize), u64>>> =
+                    const { std::cell::Cell::new(None) };
+        }
+        &MEMO_FAIL_TAINTED_SCRATCH
+    }
+    fn reset_recycled(&mut self) {
+        self.clear();
+    }
+    fn empty_shell() -> Self {
+        Self::default()
+    }
+}
+
+impl ParseScratchRecyclable for RecursionGuard {
+    fn scratch_slot() -> &'static std::thread::LocalKey<std::cell::Cell<Option<Self>>> {
+        std::thread_local! {
+            static RECURSION_GUARD_SCRATCH:
+                std::cell::Cell<Option<RecursionGuard>> =
+                    const { std::cell::Cell::new(None) };
+        }
+        &RECURSION_GUARD_SCRATCH
+    }
+    fn reset_recycled(&mut self) {
+        self.parse_stack.clear();
+        self.rule_id_stack.clear();
+        self.cycle_cache.clear();
+        // `max_depth` is a construction parameter — the emitted `new()`
+        // applies it via `set_max_depth` right after `take()`.
+        self.max_depth = 0;
+    }
+    fn empty_shell() -> Self {
+        Self::default()
+    }
+}
+
+impl ParseScratchRecyclable for semantic_runtime::SemanticRuntimeState {
+    fn scratch_slot() -> &'static std::thread::LocalKey<std::cell::Cell<Option<Self>>> {
+        std::thread_local! {
+            static SEMANTIC_STATE_SCRATCH:
+                std::cell::Cell<Option<semantic_runtime::SemanticRuntimeState>> =
+                    const { std::cell::Cell::new(None) };
+        }
+        &SEMANTIC_STATE_SCRATCH
+    }
+    fn reset_recycled(&mut self) {
+        self.recycle_reset();
+    }
+    fn empty_shell() -> Self {
+        Self::recycle_shell()
+    }
+}
